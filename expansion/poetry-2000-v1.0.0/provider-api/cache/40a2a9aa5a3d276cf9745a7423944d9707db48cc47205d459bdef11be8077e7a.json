      }
    },
    {
      "id": 300602,
      "title": "春旦直疏",
      "content": [
        "春夜犹自长，高窗来月明。",
        "耿耿不能寐，振衣步前楹。",
        "怀抱𫏐无扰，自觉形神清。",
        "遐想太古事，俯察今世情。",
        "淳薄何不同，运数之所成。",
        "叹息万重隔，已闻晨鸡鸣。",
        "回看东南隅，□□□□□。",
        "谁知忘机者，寂泊存其精。",
        "（见《分门纂类唐歌诗》残本第一册《天地山川类》十三页。",
        "）（见五卷本《王无功文集》卷二，第十三句「回看」作「回首」。"
      ],
      "author": {
        "id": 289,
        "name": "王绩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 302219,
      "title": "元正赋附歌",
      "content": [
        "献岁风光早，芳春节会多。",
        "径潘三月内，恣意饱相（五卷本作「经」）过。",
        "（伯二八一九卷，又五卷本《王无功文集》卷一。"
      ],
      "author": {
        "id": 289,
        "name": "王绩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 302220,
      "title": "灵龟（幷序）",
      "content": [
        "彼灵龟兮，潜伏平坻。",
        "文列八卦，色合四时。",
        "出游芳莲，入负神蓍。",
        "吐故吸新，何虑何思？",
        "赫赫王会，峨峨天府，谋猷所资，吉凶所聚。",
        "尔有前鉴，尔既余（李抄本作「余」）将，尔有嘉识，尔既余（李抄本作「余」）辅。",
        "爰施长网，载沈密罗，于沼于沚，于江于沱。",
        "既剔既剥，是钻是灼，姑取供用，焉知其佗。",
        "呜呼灵龟，孰谓尔哲？",
        "本缘末丧，命为才绝。",
        "山木自寇，膏火自灭，敢陈明辞，以告来裔。",
        "（按：序文十六字，原与正文连写。",
        "今据文意析出。"
      ],
      "author": {
        "id": 289,
        "name": "王绩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 302221,
      "title": "郊园",
      "content": [
        "汾川胜地，姑射名辰。",
        "月照山客，风吹俗人。",
        "琴声送冷，酒气迎春。",
        "闭门常乐，何须四隣。"
      ],
      "author": {
        "id": 289,
        "name": "王绩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 302222,
      "title": "被征谢病",
      "content": [
        "汉朝征隐士，唐年访逸人。",
        "还言北山曲，更坐东河滨。",
        "枌榆三晋地，烟火四家隣。",
        "白豕祠乡社，青羊祭宅神。",
        "拓畦侵院角，蹙水上渠漘。",
        "卧病刘公干，躬耕郑子真。",
        "横裁桑节杖，竖翦竹皮巾。",
        "鹤警琴亭夜，莺啼酒瓮春。",
        "颜回惟乐道，原宪岂伤贫？",
        "藉草邀新友，班荆接故人。",
        "市门逢卖药，山圃值肩薪。",
        "相将共无事，何处犯嚣尘！",
        "（按：《韵语阳秋》卷十一录「巾」、「春」、「贫」三韵，题作《被召谢病》。",
        "《全唐诗》卷三七收入，注出《西清诗话》，系沿《增修诗话总龟后集》卷四五之误。"
      ],
      "author": {
        "id": 289,
        "name": "王绩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 302223,
      "title": "春日山庄言志",
      "content": [
        "平子试归田，风光溢眼前。",
        "野楼全跨迥，山阁半临烟。",
        "入屋敧生树，当堦逆涌泉。",
        "翦茅通磵底，移柳向河边。",
        "崩砂犹有处，卧石不知年。",
        "入谷开斜道，横溪渡小船。",
        "郑玄唯解义，王烈镇寻仙。",
        "去去人间远，谁知心自然。"
      ],
      "author": {
        "id": 289,
        "name": "王绩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 302224,
      "title": "独坐",
      "content": [
        "托身千载下，聊思（《韵语阳秋》作「游」）万物初。",
        "欲令无作有，翻觉实成虚。",
        "周文方定策，秦帝即焚书。",
        "寄语无为者，知君悟有余。",
        "（按：《韵语阳秋》卷十一、《文献通考》卷二三一、《经籍考》引《周氏涉笔》收前四句，《全唐诗》卷三七收入。"
      ],
      "author": {
        "id": 289,
        "name": "王绩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 302225,
      "title": "咏怀",
      "content": [
        "桑榆汾水北，烟火浊河东。",
        "未必寻归路，居然息转蓬。",
        "故乡行处（《全唐诗》作「云」）是，虚室坐间同。",
        "日落西山暮，方知天下空。",
        "（按：《韵诗阳秋》卷十一、《全唐诗》卷三七收后四句。"
      ],
      "author": {
        "id": 289,
        "name": "王绩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 302226,
      "title": "山夜",
      "content": [
        "仲尼初返鲁，藏史欲辞周。",
        "脱落四方事，栖遑万里游。",
        "影来徒自责，心尽更何求？",
        "礼乐存三代，烟霞主一丘。",
        "长歌明月在，独坐白云浮。",
        "物情劳倚伏，生涯任去留。",
        "百年一如此，世事方悠悠。"
      ],
      "author": {
        "id": 289,
        "name": "王绩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 302227,
      "title": "游山赠仲长先生子光",
      "content": [
        "试出南河曲，还起北山期。",
        "连峰无𫏐断，绝岭互相疑。",
        "结[藤]（滕）标往路，刻树记来时。",
        "沙场聊憩路，石壁旋题诗。",
        "叶秋红稍下，苔寒绿更滋。",
        "幽寻多乐处，勿怪往还迟。"
      ],
      "author": {
        "id": 289,
        "name": "王绩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 302228,
      "title": "春晚园林",
      "content": [
        "不道嫌朝隐，无情受陆沉。",
        "忽逢今旦乐，还遂少时心。",
        "卷书藏箧笥，移榻就园林。",
        "老妻能劝酒，少子解弹琴。",
        "落花随处下，春鸟自须吟。",
        "兀然成一醉，谁知怀抱深？",
        "（按：《客野丛书》卷十九录「老妻能劝酒，少子解弹琴」二句。"
      ],
      "author": {
        "id": 289,
        "name": "王绩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 302229,
      "title": "赠薛学士方士",
      "content": [
        "昔岁寻周孔，今春访老庄。",
        "途经丹水岸，路出白云乡。",
        "窈窕开皇道，深沉指太方。",
        "物情争逐鹿，人事各亡羊。",
        "月明看桂树，日下觅扶桑。",
        "寄语悠悠者，谁知此路长。"
      ],
      "author": {
        "id": 289,
        "name": "王绩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 302230,
      "title": "春庄走笔",
      "content": [
        "野客元图静，田家本恶諠。",
        "枕山通箘阁，临磵创茅轩。",
        "约略栽新柳，随宜作小园。",
        "草依三径合，花接四隣繁。",
        "野妇调中馈，山朋促上樽。",
        "晓羹犹未糁，春酒不须温。",
        "卖药开东铺，租田向北村。",
        "梦中逢栎社，醉里觅桃源。",
        "猪肝时入馔，犊鼻即裁裈。",
        "自觉勋名薄，方知道义尊。",
        "所嗟同志少，无处可忘言。"
      ],
      "author": {
        "id": 289,
        "name": "王绩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 302231,
      "title": "泛船河上",
      "content": [
        "初晴何以慰？",
        "薄暮理轻舟。",
        "白云销向尽，黄河曲复流。",
        "随风依北岸，逐浪向南洲。",
        "波澜浩淼淼，怀抱直悠悠。",
        "自觉生如寄，方知世若浮。",
        "蓬莱何处在？",
        "坐使百年秋。"
      ],
      "author": {
        "id": 289,
        "name": "王绩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 302232,
      "title": "过程处士饮率尔成咏",
      "content": [
        "莫道山中泉石好，莫畏人间行路难。",
        "蜀郡𬬻家何必闹，宜城酒店旧来宽。",
        "杯至定知悬怪晚，饮尽祇应速唱看。",
        "但使百年相续醉，何愁万里客衣单。"
      ],
      "author": {
        "id": 289,
        "name": "王绩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 302233,
      "title": "解六合丞还",
      "content": [
        "我家沧海白云边，还将别业对林泉，不同功名喧一世，直取烟霞送百年。",
        "彭泽有田唯种黍，步兵从宦岂论钱？",
        "但愿朝朝长得醉（李抄本此句作「但使百年相续醉」），何辞夜夜瓮间眠。"
      ],
      "author": {
        "id": 289,
        "name": "王绩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 302234,
      "title": "山中独坐",
      "content": [
        "试逐游山去，聊观避俗情。",
        "引流还当井，凭树即为楹。",
        "酒中添药气，琴里作松声。",
        "石𬬻煎玉髓，土釜出金精。",
        "水碧连年服，云丹计日成。",
        "还看市朝路，无处不营营。"
      ],
      "author": {
        "id": 289,
        "name": "王绩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 302235,
      "title": "题画幛背",
      "content": [
        "云霞图幛子，山水画屏风。",
        "不应须对许，坐惯青溪中。"
      ],
      "author": {
        "id": 289,
        "name": "王绩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 302236,
      "title": "春园兴后",
      "content": [
        "比日寻常醉，经年独未醒。",
        "回瞻后园柳，忽值数行青。",
        "定是春来意，低头更好听。",
        "歌莺辽乱动，莲叶绕池生。",
        "散腰追阮籍，招手唤刘伶。",
        "隔架窥前[空，未余几]（据李抄本补）小瓶。",
        "风光须用却，留此待谁倾。"
      ],
      "author": {
        "id": 289,
        "name": "王绩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 302237,
      "title": "山园",
      "content": [
        "幽人养性灵，长啸坐山扃。",
        "二月兰心紫，三春柳色青。",
        "卷帘看水石，开牖望园亭。",
        "琴曲唯留古，书名半是经。",
        "风烟长入咏，几杖悉为铭。",
        "切直平生尽，何为劳是形？",
        "（按：《文献通考·经籍考》引《周氏涉笔》录「琴曲唯留古，书多半是经」二句，《全唐诗》卷三七收入。"
      ],
      "author": {
        "id": 289,
        "name": "王绩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 302238,
      "title": "春日还庄",
      "content": [
        "居人姓仲长，端坐悦年光。",
        "地形疑谷口，川势似河阳。",
        "傍山移草石，横渠种稻粱。",
        "滋兰依旧畹，接菓著新行。",
        "自持茅作屋，无用杏为梁。",
        "蓬埋张仲径，藜破管宁床。",
        "浴蚕温织室，分蜂煖蜜房。",
        "竹密连堦暗，花飞满宅香。",
        "坐棠思邵伯，看柳忆嵇康。",
        "自得终焉趣，无论怀故乡。"
      ],
      "author": {
        "id": 289,
        "name": "王绩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 302239,
      "title": "寻苗道士山居",
      "content": [
        "抱琴欲隐去，杖策访幽潜。",
        "青溪无限曲，丹障几重帘。",
        "水声全绕砌，树影半横檐。",
        "甑尘炊暂拂，𬬻香尽更添。",
        "短茅新缚荐，细藋始编簷。",
        "写咒桃为板，题经竹作签。",
        "紫文千岁蝠，丹书五月蟾。",
        "三山今近远，飞路幸相兼。"
      ],
      "author": {
        "id": 289,
        "name": "王绩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 302240,
      "title": "端坐咏思",
      "content": [
        "张衡赋《四愁》，梁鸿歌《五噫》。",
        "慷慨□□□，憔悴将焉如？",
        "纷吾独无闷，高卧喜闲居。",
        "世途何足数，人事本来虚。",
        "三王无定策，五帝有残书。",
        "咄嗟建城市，倏忽观丘墟。",
        "明治若不足，昏暴常有余。",
        "寄言忘怀者，归来任卷舒。",
        "（按：《野客丛书》卷二十录「咄嗟建城市」一句。"
      ],
      "author": {
        "id": 289,
        "name": "王绩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 302241,
      "title": "山中采药",
      "content": [
        "采药北岩阴，乘兴独幽寻。",
        "涧尾泉恒细，山腰溪转深。",
        "石横疑路断，云暗觉峰沉。",
        "薄暮归来去，松丘横夜琴。"
      ],
      "author": {
        "id": 289,
        "name": "王绩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 302242,
      "title": "晚秋夜坐",
      "content": [
        "园亭物候奇，舒啸乐无为。",
        "芰荷高出岸，杨柳下敧池。",
        "蝉噪黏远举，鱼惊钩暂移。"
      ],
      "author": {
        "id": 289,
        "name": "王绩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 302243,
      "title": "在边三首 一",
      "content": [
        "客行秋未归，萧索意多违。",
        "雁门霜雪苦，龙城冠盖稀。",
        "穹庐还作室，短褐更为衣。",
        "自怜书信断，空瞻鸿雁飞。"
      ],
      "author": {
        "id": 289,
        "name": "王绩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 302244,
      "title": "在边三首 二",
      "content": [
        "羁旅滞胡中，思归道路穷。",
        "犹擎苏武节，尚抱李陵弓。",
        "漠北平无树，关南迥有风。",
        "长安知远近，徒想灞池东。"
      ],
      "author": {
        "id": 289,
        "name": "王绩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 302245,
      "title": "在边三首 三",
      "content": [
        "昔岁衔王命，今秋独未旋。",
        "节毛风落尽，衣袖雪霑鲜。",
        "瀚海平连地，狼山峻入天。",
        "何当携侍子，相逐拜甘泉。"
      ],
      "author": {
        "id": 289,
        "name": "王绩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 302246,
      "title": "冬夜载酒于乡馆寻崔使君善为",
      "content": [
        "思君夜渐阑，载酒一相看。",
        "野馆含烟冷，山衣犯雪寒。",
        "停车聊捧袂，倒屣共临盘。",
        "今夕山阴赏，谁知逢道安。"
      ],
      "author": {
        "id": 289,
        "name": "王绩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 302247,
      "title": "读《真隐传》见披裘公及汉滨老父因题四韵",
      "content": [
        "被褐延陵迳，耕田汉水阴。",
        "由来驩击壤，何处视遗金？",
        "季子停骖谢，张温下道寻。"
      ],
      "author": {
        "id": 289,
        "name": "王绩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 302248,
      "title": "性不好治产兴后言怀",
      "content": [
        "自有人间分，何须郭外田？",
        "和光游聚落，独兴入山泉。",
        "河曲编萧坐，灵台结絮眠。",
        "还应多藏客，辛苦没残年。"
      ],
      "author": {
        "id": 289,
        "name": "王绩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 302249,
      "title": "山家夏日九首 一",
      "content": [
        "寂寞坐山家，萧条翫物华。",
        "树奇（李抄本作「倚」）全拥石，蒲长半侵砂。",
        "池光连壁动，日影对窗斜。",
        "石榴兼布叶，金䔲唯作花。",
        "落藤斜引蔓，伏笋暗抽芽。",
        "高卧长无客，方知人事赊。"
      ],
      "author": {
        "id": 289,
        "name": "王绩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 302250,
      "title": "山家夏日九首 二",
      "content": [
        "隐士长松壑，先生孤竹丘。",
        "溪深常抱冻，磵冷镇含秋。",
        "九春宁解褐，五月自披裘。",
        "谁信汤年旱，山燋金石流？"
      ],
      "author": {
        "id": 289,
        "name": "王绩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 302251,
      "title": "山家夏日九首 三",
      "content": [
        "山中旧可安，无处不盘桓。",
        "岭澁攀藤易，岩崎策杖难。",
        "药供无限食，石起自然坛。",
        "树密簷偏冷，泉深阶镇寒。",
        "松根聊入酿，竹实试调丹。",
        "孔淳书数帙，朝朝还自看。"
      ],
      "author": {
        "id": 289,
        "name": "王绩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 302252,
      "title": "山家夏日九首 四",
      "content": [
        "岩居何啻好，野性本规闲。",
        "青松生户侧，奔泉涌砌间。",
        "老父循浑沌，稚子服斒斓。",
        "自得为巢许，无劳买却山。"
      ],
      "author": {
        "id": 289,
        "name": "王绩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 302253,
      "title": "山家夏日九首 五",
      "content": [
        "追凉剩不归，高卧隐松闱。",
        "野竹栏堦种，岩花入户飞。",
        "磵幽人路断，山旷鸟啼稀。",
        "不特嫌周粟，时时须采薇。"
      ],
      "author": {
        "id": 289,
        "name": "王绩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 302254,
      "title": "山家夏日九首 六",
      "content": [
        "山人（李抄本作「中」）有敝庐，竹树近扶疎。",
        "傍岩开灶井，横磵引庭除。",
        "障子游仙画，屏风章草书。",
        "谁言非面俗，更欲赋《闲居》。"
      ],
      "author": {
        "id": 289,
        "name": "王绩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 302255,
      "title": "山家夏日九首 七",
      "content": [
        "幽居枕广川，长望郁芊芊。",
        "北岩采樵路，东坡种药田。",
        "磵泉通院井，山气杂厨烟。",
        "向夕林庭旷，萧条鸣一弦。"
      ],
      "author": {
        "id": 289,
        "name": "王绩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 302256,
      "title": "山家夏日九首 八",
      "content": [
        "山居自可安，乐道不为难。",
        "甲乙题书卷，梧桐数药丸。",
        "树阴连户静，泉影度窗寒。",
        "抱琴聊倚石，高眠风自弹。"
      ],
      "author": {
        "id": 289,
        "name": "王绩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 302257,
      "title": "山家夏日九首 九",
      "content": [
        "避暑长岩东，萧条趣不穷。",
        "密藤成斗帐，疎树即簷栊。",
        "槿花碍前浦，荷香栏上风。",
        "寄言覆苔客，无事菓园中。"
      ],
      "author": {
        "id": 289,
        "name": "王绩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 302258,
      "title": "洛水南看汉王马射",
      "content": [
        "君王马态骄。",
        "蹀躞过河桥。",
        "雨息铜街静，尘飞金埒遥。",
        "铁丝缠箭脚，玉片抱弓腰。",
        "日□矜百中，唯看杨柳条。",
        "（以上三十九首均见北京图书馆藏清陈氏晚晴轩抄本五卷本《王无功文集》卷二。"
      ],
      "author": {
        "id": 289,
        "name": "王绩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 302259,
      "title": "驾过观猎",
      "content": [
        "天廵总禁营，诘旦拥戈城。",
        "旗常纷出没，彀骑郁纵横。",
        "围尘千里暗，猎火四山明。",
        "兽竭郊原迥，禽殚灌莽平。",
        "割鲜同饮至，振旅以休兵。",
        "动作威容备，周旋军令成。",
        "金铙清御道，玉鼓节神行。",
        "别有磻溪叟，无日战逢迎。"
      ],
      "author": {
        "id": 289,
        "name": "王绩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    }
