{
  "data": [
    {
      "id": 276720,
      "title": "汉宫",
      "content": [
        "通灵夜醮达清晨，承露盘晞甲帐春。",
        "王母不来方朔去，更须重见李夫人。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 276721,
      "title": "判春",
      "content": [
        "一桃复一李，井上占年芳。",
        "笑处如临镜，窥时不隐墙。",
        "敢言西子短，谁觉宓妃长。",
        "珠玉终相类，同名作夜光。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276722,
      "title": "促漏",
      "content": [
        "促漏遥钟动静闻，报章重叠杳难分。",
        "舞鸾镜匣收残黛，睡鸭香炉换夕熏。",
        "归去定知还向月，梦来何处更为云？",
        "南塘渐暖蒲堪结，两两鸳鸯护水纹。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276723,
      "title": "江东",
      "content": [
        "惊鱼拨刺燕翩翾，独自江东上钓船。",
        "今日春光太漂荡，谢家轻絮沈郎钱。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 276724,
      "title": "读任彦升碑",
      "content": [
        "任昉当年有美名，可怜才调最纵横。",
        "梁台初建应惆怅，不得萧公作骑兵。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 276725,
      "title": "荷花",
      "content": [
        "都无色可并，不奈此香何。",
        "瑶席乘凉设，金羁落晚过。",
        "回衾灯照绮，渡韈水沾罗。",
        "预想前秋别，离居梦櫂歌。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276726,
      "title": "五松驿",
      "content": [
        "独下长亭念过秦，五松不见见舆薪。",
        "只应既斩斯高后，寻被樵人用斧斤。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 276727,
      "title": "灞岸",
      "content": [
        "山东今岁点行频，几处冤魂哭虏尘。",
        "灞水桥边倚华表，平时二月有东巡。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 276728,
      "title": "送臻师二首 一",
      "content": [
        "昔去灵山非拂席，今来沧海欲求珠。",
        "楞伽顶上清凉池，善眼仙人忆我无。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 276729,
      "title": "送臻师二首 二",
      "content": [
        "苦海迷途去未因，东方过此几微尘。",
        "何当百亿莲花上，一一莲花见佛身。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 276730,
      "title": "七夕",
      "content": [
        "鸾扇斜分凤幄开，星桥横过鹊飞回。",
        "争将世上无期别，换得年年一度来。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 276731,
      "title": "谢先辈防记念拙诗甚多异日偶有此寄",
      "content": [
        "晓用云添句，寒将雪命篇。",
        "良辰多自感，作者岂皆然。",
        "熟寝初同鹤，含嘶欲并蝉。",
        "题诗长不展，得处定应偏。",
        "南浦无穷树，西楼不住烟。",
        "改成人寂寂，寄与路绵绵。",
        "星势寒垂地，河声晓上天。",
        "夫君自有恨，聊借此中传。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 276732,
      "title": "马嵬二首 一",
      "content": [
        "冀马燕犀动地来，自埋红粉自成灰。",
        "君王若道能倾国，玉辇何由过马嵬。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 276733,
      "title": "马嵬二首 二",
      "content": [
        "海外徒闻更九州，他生未卜此生休。",
        "空闻虎旅传宵柝，无复鸡人报晓筹。",
        "此日六军同驻马，当时七夕笑牵牛。",
        "如何四纪为天子，不及卢家有莫愁。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276734,
      "title": "可叹",
      "content": [
        "幸会东城宴未回，年华忧共水相催。",
        "梁家宅里秦宫入，赵后楼中赤凤来。",
        "冰簟且眠金镂枕，琼筵不醉玉交杯。",
        "宓妃愁坐芝田馆，用尽陈王八斗才。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276735,
      "title": "望喜驿别嘉陵江水二绝 一",
      "content": [
        "嘉陵江水此东流，望喜楼中忆阆州。",
        "若到阆中还赴海，阆州应更有高楼。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 276736,
      "title": "望喜驿别嘉陵江水二绝 二",
      "content": [
        "千里嘉陵江水色，含烟带月碧于蓝。",
        "今朝相送东流后，犹自驱车更向南。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 276737,
      "title": "别薛嵒宾",
      "content": [
        "曙爽行将拂，晨清坐欲凌。",
        "别离真不那，风物正相仍。",
        "漫水任谁照，衰花浅自矜。",
        "还将两袖泪，同向一窗灯。",
        "桂树乖真隐，芸香是小惩。",
        "清规无以况，且用玉壶冰。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 276738,
      "title": "富平少侯",
      "content": [
        "七国三边未到忧，十三身袭富平候。",
        "不收金弹抛林外，却惜银床在井头。",
        "彩树转灯珠错落，绣檀回枕玉雕锼。",
        "当关不报侵晨客，新得佳人字莫愁。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276739,
      "title": "肠",
      "content": [
        "有怀非惜恨，不奈寸肠何。",
        "即席回弥久，前时断固多。",
        "热应翻急烧，冷欲彻微波。",
        "隔树澌澌雨，通池点点荷。",
        "倦程山向背，望国阙嵯峨。",
        "故念飞书及，新懽借梦过。",
        "染筠休伴泪，绕雪莫追歌。",
        "拟问阳台事，年深楚语讹。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 276740,
      "title": "赠宇文中丞",
      "content": [
        "欲构中天正急材，自缘烟水恋平台。",
        "人间只有嵇延祖，最望山公启事来。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 276741,
      "title": "晓起",
      "content": [
        "拟杯当晓起，呵镜可微寒。",
        "隔箔山樱熟，褰帷桂烛残。",
        "书长为报晚，梦好更寻难。",
        "影响输双蝶，偏过旧畹兰。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276742,
      "title": "闺情",
      "content": [
        "红露花房白蜜脾，黄蜂紫蝶两参差。",
        "春窗一觉风流梦，却是同袍不得知。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 276743,
      "title": "月夕",
      "content": [
        "草下阴虫叶上霜，朱栏迢遰压湖光。",
        "兔寒蟾冷桂花白，此夜姮娥应断肠。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 276744,
      "title": "杏花",
      "content": [
        "上国昔相值，亭亭如欲言。",
        "异乡今暂赏，眽眽岂无恩。",
        "援少风多力，墙高月有痕。",
        "为含无限意，遂对不胜繁。",
        "仙子玉京路，主人金谷园。",
        "几时辞碧落，谁伴过黄昏。",
        "镜拂铅华腻，炉藏桂烬温。",
        "终应催竹叶，先拟咏桃根。",
        "莫学啼成血，从教梦寄魂。",
        "吴王采香径，失路入烟村。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 276745,
      "title": "灯",
      "content": [
        "皎洁终无倦，煎熬亦自求。",
        "花时随酒远，雨后背窗休。",
        "冷暗黄茅驿，暄明紫桂楼。",
        "锦囊名画揜，玉局败碁收。",
        "何处无佳梦，谁人不隐忧。",
        "影随帘押转，光信簟文流。",
        "客自胜潘岳，侬今定莫愁。",
        "固应留半燄，廻照下帏羞。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 276746,
      "title": "清河",
      "content": [
        "舟小回仍数，楼危凭亦频。",
        "燕来从及社，蝶舞太侵晨。",
        "绛雪除烦后，霜梅取味新。",
        "年华无一事，只是自伤春。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276747,
      "title": "韈",
      "content": [
        "尝闻宓妃韈，渡水欲生尘。",
        "好借常娥著，清秋踏月轮。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 276748,
      "title": "追代卢家人嘲堂内",
      "content": [
        "道却横波字，人前莫谩羞。",
        "只应同楚水，长短入淮流。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 276749,
      "title": "代应",
      "content": [
        "本来银汉是红墙，隔得卢家白玉堂。",
        "谁与王昌报消息，尽知三十六鸳鸯。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 276750,
      "title": "离亭赋得折杨柳二首 一",
      "content": [
        "暂凭樽酒送无憀，莫损愁眉与细腰。",
        "人世死前惟有别，春风争拟惜长条。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 276751,
      "title": "离亭赋得折杨柳二首 二",
      "content": [
        "含烟惹雾每依依，万绪千条拂落晖。",
        "为报行人休尽折，半留相送半迎归。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 276752,
      "title": "寄永道士",
      "content": [
        "共上云山独下迟，阳台白道细如丝。",
        "君今并倚三珠树，不记人间落叶时。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 276753,
      "title": "华州周大夫宴席",
      "content": [
        "郡斋何用酒如泉，饮德先时已醉眠。",
        "若共门人推礼分，戴崇争得及彭宣。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 276754,
      "title": "荆山",
      "content": [
        "压河连华势孱颜，鸟没云归一望间。",
        "杨仆移关三百里，可能全是为荆山。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 276755,
      "title": "次陕州先寄源从事",
      "content": [
        "离思羁愁日欲晡，东周西雍此分涂。",
        "回銮佛寺高多少，望尽黄河一曲无。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 276756,
      "title": "过郑广文旧居",
      "content": [
        "宋玉平生恨有余，远循三楚吊三闾。",
        "可怜留著临江宅，异代应教庾信居。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 276757,
      "title": "东下三旬苦于风土马上戏作",
      "content": [
        "路遶函关东复东，身骑征马逐惊蓬。",
        "天池辽阔谁相待，日日虚乘九万风。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 276758,
      "title": "莫愁",
      "content": [
        "雪中梅下与谁期，梅雪相兼一万枝。",
        "若是石城无艇子，莫愁还自有愁时。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 276759,
      "title": "梦令狐学士",
      "content": [
        "山驿荒凉白竹扉，残灯向晓梦清晖。",
        "右银台路雪三尺，凤诏裁成当直归。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 276760,
      "title": "涉洛川",
      "content": [
        "通谷阳林不见人，我来遗恨古时春。",
        "宓妃漫结无穷恨，不为君王杀灌均。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 276761,
      "title": "有感",
      "content": [
        "中路因循我所长，古来才命两相妨。",
        "劝君莫强安蛇足，一醆芳醪不得尝。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 276762,
      "title": "宫妓",
      "content": [
        "珠箔轻明拂玉墀，披香新殿鬬腰支。",
        "不须看尽鱼龙戏，终遣君王怒偃师。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 276763,
      "title": "宫辞",
      "content": [
        "君恩如水向东流，得宠忧移失宠愁。",
        "莫向尊前奏花落，凉风只在殿西头。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 276764,
      "title": "代赠二首 一",
      "content": [
        "楼上黄昏欲望休，玉梯横绝月中钩。",
        "芭蕉不展丁香结，同向春风各自愁。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 276765,
      "title": "代赠二首 二",
      "content": [
        "东南日出照高楼，楼上离人唱石州。",
        "总把春山扫眉黛，不知供得几多愁。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 276766,
      "title": "楚吟",
      "content": [
        "山上离宫宫上楼，楼前宫畔暮江流。",
        "楚天长短黄昏雨，宋玉无愁亦自愁。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 276767,
      "title": "瑶池",
      "content": [
        "瑶池阿母绮窗开，黄竹歌声动地哀。",
        "八骏日行三万里，穆王何事不重来。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 276768,
      "title": "柳",
      "content": [
        "为有桥边拂面香，何曾自敢占流光。",
        "后庭玉树承恩泽，不信年华有断肠。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 276769,
      "title": "寄在朝郑曹独孤李四同年",
      "content": [
        "昔岁陪游旧迹多，风光今日两蹉跎。",
        "不因醉本兰亭在，兼忘当年旧永和。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 276770,
      "title": "南朝",
      "content": [
        "地险悠悠天险长，金陵王气应瑶光。",
        "休夸此地分天下，只得徐妃半面妆。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 276771,
      "title": "题汉祖庙",
      "content": [
        "乘运应须宅八荒，男儿安在恋池隍。",
        "君王自起新丰后，项羽何曾在故乡。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 276772,
      "title": "韩冬郎即席为诗相送一座尽惊他日余方追吟连宵侍坐裴回久之句有老成之风因成二绝寄酬兼呈畏之员外 一",
      "content": [
        "十岁裁诗走马成，冷灰残烛动离情。",
        "桐花万里丹山路，雏凤清于老凤声。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 276773,
      "title": "韩冬郎即席为诗相送一座尽惊他日余方追吟连宵侍坐裴回久之句有老成之风因成二绝寄酬兼呈畏之员外 二",
      "content": [
        "劒栈风樯各苦辛，别时冰雪到时春。",
        "为凭何逊休联句，瘦尽东阳姓沈人。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 276774,
      "title": "评事翁寄赐饧粥走笔为答",
      "content": [
        "粥香饧白杏花天，省对流鸎坐绮筵。",
        "今日寄来春已老，凤楼迢递忆秋千。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 276775,
      "title": "东阿王",
      "content": [
        "国事分明属灌均，西陵魂断夜来人。",
        "君王不得为天子，半为当时赋洛神。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 276776,
      "title": "圣女祠",
      "content": [
        "松篁台殿蕙香帏，龙护瑶窗凤掩扉。",
        "无质易迷三里雾，不寒长著五铢衣。",
        "人间定有崔罗什，天上应无刘武威。",
        "寄问钗头双白燕，每朝珠馆几时归。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276777,
      "title": "独居有怀",
      "content": [
        "麝重愁风逼，罗疎畏月侵。",
        "怨魂迷恐断，娇喘细疑沈。",
        "数急芙蓉带，频抽翡翠簪。",
        "柔情终不远，遥妬已先深。",
        "浦冷鸳鸯去，园空蛱蝶寻。",
        "蜡花长递泪，筝柱镇移心。",
        "觅使嵩云暮，回头灞岸阴。",
        "只闻凉叶院，露井近寒砧。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 276778,
      "title": "过景陵",
      "content": [
        "武皇精魄久仙升，帐殿凄凉烟雾凝。",
        "俱是苍生留不得，鼎湖何异魏西陵。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 276779,
      "title": "临发崇让宅紫薇",
      "content": [
        "一树浓姿独看来，秋庭暮雨类轻埃。",
        "不先摇落应为有，已欲别离休更开。",
        "桃绶含情依露井，柳绵相忆隔章台。",
        "天涯地角同荣谢，岂要移根上苑栽。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276780,
      "title": "及第东归次灞上却寄同年",
      "content": [
        "芳桂当年各一枝，行期未分压春期。",
        "江鱼朔雁长相忆，秦树嵩云自不知。",
        "下苑经过劳想像，东门送饯又差池。",
        "灞陵柳色无离恨，莫枉长条赠所思。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276781,
      "title": "野菊",
      "content": [
        "苦竹园南椒坞边，微香冉冉泪涓涓。",
        "已悲节物同寒雁，忍委芳心与暮蝉。",
        "细路独来当此夕，清尊相伴省他年。",
        "紫云新苑移花处，不取霜栽近御筵。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276782,
      "title": "板桥晓别",
      "content": [
        "回望高城落晓河，长亭窗户压微波。",
        "水仙欲上鲤鱼去，一夜芙蓉红泪多。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 276783,
      "title": "过伊仆射旧宅",
      "content": [
        "朱邸方酬力战功，华筵俄叹逝波穷。",
        "回廊簷断燕飞去，小阁尘凝人语空。",
        "幽泪欲干残菊露，余香犹入败荷风。",
        "何能更涉泷江去，独立寒流吊楚宫。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276784,
      "title": "关门柳",
      "content": [
        "永定河边一行柳，依依长发故年春。",
        "东来西去人情薄，不为清阴减路尘。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 276785,
      "title": "酬别令狐补阙",
      "content": [
        "惜别夏仍半，回途秋已期。",
        "那修直谏草，更赋赠行诗。",
        "锦段知无报，青萍肯见疑。",
        "人生有通塞，公等系安危。",
        "警露鹤辞侣，吸风蝉抱枝。",
        "弹冠如不问，又到扫门时。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 276786,
      "title": "银河吹笙",
      "content": [
        "怅望银河吹玉笙，楼寒院冷接平明。",
        "重衾幽梦他年断，别树羁雌昨夜惊。",
        "月榭故香因雨发，风帘残烛隔霜清。",
        "不须浪作缑山意，湘瑟秦箫自有情。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276787,
      "title": "与同年李定言曲水闲话戏作",
      "content": [
        "海燕参差沟水流，同君身世属离忧。",
        "相携花下非秦赘，对泣春天类楚囚。",
        "碧草暗侵穿苑路，珠帘不卷枕江楼。",
        "莫惊五胜埋香骨，地下伤春亦白头。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276788,
      "title": "彭城公薨后赠杜二十七胜李十七潘二君竝与愚同出故尚书安平公门下",
      "content": [
        "梁山兖水约从公，两地参差一旦空。",
        "谢墅庾村相吊后，自今歧路各西东。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 276789,
      "title": "闻歌",
      "content": [
        "敛笑凝眸意欲歌，高云不动碧嵯峨。",
        "铜台罢望归何处，玉辇忘还事几多。",
        "青冢路边南雁尽，细腰宫里北人过。",
        "此声肠断非今日，香灺灯光奈尔何。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276790,
      "title": "赠华阳宋真人兼寄清都刘先生",
      "content": [
        "沦谪千年别帝宸，至今犹谢蘂珠人。",
        "但惊茅许同仙籍，不道刘卢是世亲。",
        "玉捡赐书迷凤篆，金华归驾冷龙鳞。",
        "不因杖屦逢周史，徐甲何曾有此身。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276791,
      "title": "楚宫二首 一",
      "content": [
        "十二峰前落照微，高唐宫暗坐迷归。",
        "朝云暮雨长相接，犹自君王恨见稀。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 276792,
      "title": "楚宫二首 二",
      "content": [
        "月姊曾逢下彩蟾，倾城消息隔重帘。",
        "已闻佩响知腰细，更辨弦声觉指纤。",
        "暮雨自归山悄悄，秋河不动夜厌厌。",
        "王昌且在墙东住，未必金堂得免嫌。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276793,
      "title": "和友人戏赠二首 一",
      "content": [
        "东望花楼会不同，西来双燕信休通。",
        "仙人掌冷三霄露，玉女窗虚五夜风。",
        "翠袖自随回雪转，烛房寻类外庭空。",
        "殷勤莫使清香透，牢合金鱼鏁桂丛。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276794,
      "title": "和友人戏赠二首 二",
      "content": [
        "迢遰青门有几关，柳梢楼角见南山。",
        "明珠可贯须为佩，白璧堪裁且作环。",
        "子夜休歌团扇揜，新正未破剪刀闲。",
        "猿啼鹤怨终年事，未抵熏炉一夕间。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276795,
      "title": "题二首后重有戏赠任秀才",
      "content": [
        "一丈红蔷拥翠筠，罗窗不识绕街尘。",
        "峡中寻觅长逢雨，月里依稀更有人。",
        "虚为错刀留远客，枉缘书札损文鳞。",
        "遥知小阁还斜照，羡杀乌龙卧锦茵。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276796,
      "title": "有感二首 一",
      "content": [
        "九服归元化，三灵叶睿图。",
        "如何本初辈，自取屈牦诛。",
        "有甚当车泣，因劳下殿趋。",
        "何成奏云物，直是灭萑苻。",
        "证逮符书密，辞连性命俱。",
        "竟缘尊汉相，不早辨胡雏。",
        "鬼箓分朝部，军烽照上都。",
        "敢云堪恸哭，未免怨洪炉。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 276797,
      "title": "有感二首 二",
      "content": [
        "丹陛犹敷奏，彤庭歘战争。",
        "临危对卢植，始悔用庞萌。",
        "御仗收前殿，兵徒剧背城。",
        "苍黄五色棒，掩遏一阳生。",
        "古有清君侧，今非乏老成。",
        "素心虽未易，此举太无名。",
        "谁瞑衔冤目，宁吞欲绝声。",
        "近闻开寿䜩，不废用咸英。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 276798,
      "title": "重有感",
      "content": [
        "玉帐牙旗得上游，安危须共主君忧。",
        "窦融表已来关右，陶侃军宜次石头。",
        "岂有蛟龙愁失水，更无鹰隼与高秋。",
        "昼号夜哭兼幽显，早晚星关雪涕收。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276799,
      "title": "寿安公主出降",
      "content": [
        "沩水闻贞媛，常山索锐师。",
        "昔忧迷帝力，今分送王姬。",
        "事等和强虏，恩殊睦本枝。",
        "四郊多垒在，此礼恐无时。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276800,
      "title": "夕阳楼",
      "content": [
        "花明柳暗绕天愁，上尽重城更上楼。",
        "欲问孤鸿向何处，不知身世自悠悠。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 276801,
      "title": "春雨",
      "content": [
        "怅卧新春白袷衣，白门寥落意多违。",
        "红楼隔雨相望冷，珠箔飘灯独自归。",
        "远路应悲春晼晚，残宵犹得梦依稀。",
        "玉珰缄札何由达，万里云罗一雁飞。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276802,
      "title": "中元作",
      "content": [
        "绛节飘飖宫国来，中元朝拜上清回。",
        "羊权须得金条脱，温峤终虚玉镜台。",
        "曾省惊眠闻雨过，不知迷路为花开。",
        "有娀未抵瀛洲远，青雀如何鸩鸟媒。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276803,
      "title": "鸳鸯",
      "content": [
        "雌去雄飞万里天，云罗满眼泪潸然。",
        "不须长结风波愿，锁向金笼始两全。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 276804,
      "title": "楚宫",
      "content": [
        "湘波如泪色漻缪，楚厉迷魂逐恨遥。",
        "枫树夜猿愁自断，女萝山鬼语相邀。",
        "空归腐败犹难复，更困腥臊岂易招。",
        "但使故乡三户在，彩丝谁惜惧长蛟。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276805,
      "title": "妓席暗记送同年独孤云之武昌",
      "content": [
        "叠嶂千重呌恨猿，长江万里洗离魂。",
        "武昌若有山头石，为拂苍苔检泪痕。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 276806,
      "title": "宿晋昌亭闻惊禽",
      "content": [
        "羇绪鳏鳏夜景侵，高窗不掩见惊禽。",
        "飞来曲渚烟方合，过尽南塘树更深。",
        "胡马嘶和榆塞笛，楚猿吟杂橘村砧。",
        "失群挂木知何限，远隔天涯共此心。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276807,
      "title": "深宫",
      "content": [
        "金殿销香闭绮栊，玉壶传点咽铜龙。",
        "狂飙不惜萝阴薄，清露偏知桂叶浓。",
        "斑竹岭边无限泪，景阳宫里及时钟。",
        "岂知为雨为云处，只有高唐十二峰。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276808,
      "title": "明禅师院酬从兄见寄",
      "content": [
        "贞吝嫌兹世，会心驰本原。",
        "人非四禅缚，地绝一尘喧。",
        "霜露欹高木，星河压故园。",
        "撕游傥为胜，九折幸回轩。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276809,
      "title": "寄裴衡",
      "content": [
        "别地萧条极，如何更独来。",
        "秋应为黄叶，雨不厌青苔。",
        "沈约只能瘦，潘仁岂是才。",
        "杂情堪底寄，惟有冷于灰。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276810,
      "title": "即日",
      "content": [
        "小苑试春衣，高楼倚暮晖。",
        "夭桃惟是笑，舞蝶不空飞。",
        "赤岭久无耗，鸿门犹合围。",
        "几家缘锦字，含泪坐鸳机。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276811,
      "title": "淮阳路",
      "content": [
        "荒村倚废营，投宿旅魂惊。",
        "断雁高仍急，寒溪晓更清。",
        "昔年尝聚盗，此日颇分兵。",
        "猜贰谁先致，三朝事始平。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276812,
      "title": "崇让宅东亭醉后沔然有作",
      "content": [
        "曲岸风雷罢，东亭霁日凉。",
        "新秋仍酒困，幽兴暂江乡。",
        "摇落真何遽，交亲或未忘。",
        "一帆彭蠡月，数雁塞门霜。",
        "俗态虽多累，仙标发近狂。",
        "声名佳句在，身世玉琴张。",
        "万古山空碧，无人鬓免黄。",
        "骅骝忧老大，𫛸鴂妬芬芳。",
        "密竹沉虚籁，孤莲泊晚香。",
        "如何此幽胜，淹卧剧清漳。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 276813,
      "title": "晚晴",
      "content": [
        "深居俯夹城，春去夏犹清。",
        "天意怜幽草，人间重晚晴。",
        "并添高阁迥，微注小窗明。",
        "越鸟巢干后，归飞体更轻。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276814,
      "title": "迎寄韩鲁州",
      "content": [
        "积雨晚骚骚，相思正郁陶。",
        "不知人万里，时有燕双高。",
        "寇盗缠三辅，莓苔滑百牢。",
        "圣朝推卫霍，归日动仙曹。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276815,
      "title": "武夷山",
      "content": [
        "只得流霞酒一杯，空中箫鼓几时回。",
        "武夷洞里生毛竹，老尽曾孙更不来。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 276816,
      "title": "一片",
      "content": [
        "一片琼英价动天，连城十二昔虚传。",
        "良工巧费真为累，楮叶成来不直钱。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 276817,
      "title": "寄成都高苗二从事",
      "content": [
        "红莲幕下紫棃新，命断湘南病渴人。",
        "今日问君能寄否，二江风水接天津。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 276818,
      "title": "郑州献从叔舍人褎",
      "content": [
        "蓬岛烟霞阆苑钟，三官笺奏附金龙。",
        "茅君奕世仙曹贵，许掾全家道气浓。",
        "绛简尚参黄纸案，丹炉犹用紫泥封。",
        "不知他日华阳洞，许上经楼第几重。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276819,
      "title": "西南行却寄相送者",
      "content": [
        "百里阴云覆雪泥，行人只在雪云西。",
        "明朝惊破还乡梦，定是陈仓碧野鸡。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    }
  ],
