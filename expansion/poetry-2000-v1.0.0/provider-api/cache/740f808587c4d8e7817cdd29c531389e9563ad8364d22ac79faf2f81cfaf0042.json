    {
      "id": 356089,
      "title": "赠毛仙翁",
      "content": [
        "忆昔我祖神仙主，玄元皇帝周柱史。",
        "曾师轩黄友尧汤，",
        "穆王粗识神仙事，八极轮蹄方逞志。",
        "鹤发韬真世不知，",
        "仙兄受术几千年，已是当时驾鸿客。",
        "海光悠容天路长，",
        "桂窗一别三千春，秦妃镜里娥眉新。",
        "忽控香虬天上去，",
        "九州争夺无时休，八骏垂头避豺虎。",
        "我亦玄元千世孙，",
        "百年命促奔马疾，愁肠盘结心摧崒。",
        "今朝稽首拜仙兄，"
      ],
      "author": {
        "id": 4777,
        "name": "李绅"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 356090,
      "title": "和晋公三首",
      "content": [
        "凤仪常欲附，蚊力自知微。",
        "愿假樽罍末，膺门自此依。",
        "貂蝉公独步，鸳鹭我同群。",
        "插羽先飞酒，交锋便著文。",
        "穷阴初莽苍，离思渐氛氲。",
        "残雪午桥岸，斜阳伊水滨。"
      ],
      "author": {
        "id": 4777,
        "name": "李绅"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 356091,
      "title": "古风二首",
      "content": [
        "春种一粒粟，秋成万颗子。",
        "四海无闲田，农夫犹饿死。",
        "锄禾日当午，汗滴禾下土。",
        "谁知盘中餐，粒粒皆辛苦。"
      ],
      "author": {
        "id": 4777,
        "name": "李绅"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 356092,
      "title": "柳二首",
      "content": [
        "陶令门前罥接篱，亚夫营里拂朱旗。",
        "人事推移无旧物，年年春至绿垂丝。",
        "千条垂柳拂金丝，日暖牵风叶学眉。",
        "愁见花飞狂不定，还同轻薄五陵儿。"
      ],
      "author": {
        "id": 4777,
        "name": "李绅"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 356096,
      "title": "至潭州闻猿",
      "content": [
        "昔陪天上三清客，今作端州万里人。",
        "湘浦更闻猿夜啸，断肠无泪可沾巾。"
      ],
      "author": {
        "id": 4777,
        "name": "李绅"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 356100,
      "title": "端州江亭得家书二首",
      "content": [
        "雨中鹊语喧江树，风处蛛丝飏水浔。",
        "开拆远书何事喜，数行家信抵千金。",
        "长安别日春风早，岭外今来白露秋。",
        "莫道淮南悲木叶，不闻摇落更堪愁。"
      ],
      "author": {
        "id": 4777,
        "name": "李绅"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 356101,
      "title": "闻猿",
      "content": [
        "见说三声巴峡深，此时行者尽沾襟。",
        "端州江口连云处，始信哀猿伤客心。"
      ],
      "author": {
        "id": 4777,
        "name": "李绅"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 356102,
      "title": "赠韦金吾",
      "content": [
        "自报金吾主禁兵，腰间宝剑重横行。",
        "接舆也是狂歌客，更就将军乞一声。"
      ],
      "author": {
        "id": 4777,
        "name": "李绅"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 356103,
      "title": "长门怨",
      "content": [
        "宫殿沉沉晓欲分，昭阳更漏不堪闻。",
        "珊瑚枕上千行泪，不是思君是恨君。"
      ],
      "author": {
        "id": 4777,
        "name": "李绅"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 356104,
      "title": "龟山寺鱼池",
      "content": [
        "汲水添池活白莲，十千鬐鬣尽生天。",
        "凡庸不识慈悲意，自葬江鱼入九泉。",
        "剃发多缘是代耕，好闻人死恶人生。",
        "祇园说法无高下，尔辈何劳尚世情。"
      ],
      "author": {
        "id": 4777,
        "name": "李绅"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 356105,
      "title": "赋月",
      "content": [
        "月。",
        "光辉，皎洁。",
        "耀乾坤，静空阔。",
        "圆满中秋，玩争诗哲。",
        "玉兔镝难穿，桂枝人共折。",
        "万象照乃无私，琼台岂遮君谒。",
        "抱琴对弹别鹤声，不得知音声不切。"
      ],
      "author": {
        "id": 4777,
        "name": "李绅"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 356106,
      "title": "句",
      "content": [
        "君咏风月夕，余当童稚年。",
        "闲窗读书罢，偷咏左司篇。",
        "（韦应物为滁州刺史，有《登北楼》诗。",
        "绅后为刺史继和，"
      ],
      "author": {
        "id": 4777,
        "name": "李绅"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 375516,
      "title": "答章孝标",
      "content": [
        "假金只用真金镀，若是真金不镀金。",
        "十载长安得一第，何须空腹用高心。"
      ],
      "author": {
        "id": 4777,
        "name": "李绅"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
