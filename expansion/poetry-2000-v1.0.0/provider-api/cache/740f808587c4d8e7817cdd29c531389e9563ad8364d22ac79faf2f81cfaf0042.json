{
  "data": [
    {
      "id": 356026,
      "title": "渡西陵十六韵",
      "content": [
        "雨送奔涛远，风收骇浪平。",
        "截流张旆影，分岸走鼙声。",
        "兽逐衔波涌，龟艨喷棹轻。",
        "海门凝雾暗，江渚湿云横。",
        "雁翼看舟子，鱼鳞辨水营。",
        "骑交遮戍合，戈簇拥沙明。",
        "谬履千夫长，将询百吏情。",
        "下车占黍稷，冬雨害粢盛。",
        "望祷依前圣，垂休冀厚生。",
        "半江犹惨澹，全野已澄清。",
        "爱景三辰朗，祥农万庾盈。",
        "浦程通曲屿，海色媚重城。",
        "弓日鞬櫜动，旗风虎豹争。",
        "及郊挥白羽，入里卷红旌。",
        "恺悌思陈力，端庄冀表诚。",
        "临人与安俗，非止奉师贞。"
      ],
      "author": {
        "id": 4777,
        "name": "李绅"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 356027,
      "title": "新楼诗二十首：新楼",
      "content": [
        "戎容罢引旌旗卷，朱户褰开雉堞高。",
        "山耸翠微连郡阁，",
        "惆怅桂枝零落促，莫思方朔种仙桃。"
      ],
      "author": {
        "id": 4777,
        "name": "李绅"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 356028,
      "title": "新楼诗二十首：海榴亭",
      "content": [
        "海榴亭早开繁蕊，光照晴霞破碧烟。",
        "高近紫霄疑菡萏，",
        "摇落旧丛云水隔，不堪行坐数流年。"
      ],
      "author": {
        "id": 4777,
        "name": "李绅"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 356029,
      "title": "新楼诗二十首：望海亭",
      "content": [
        "乌盈兔缺天涯迥，鹤背松梢拂槛低。",
        "湖镜坐隅看匣满，",
        "萧索感心俱是梦，九天应共草萋萋。"
      ],
      "author": {
        "id": 4777,
        "name": "李绅"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 356030,
      "title": "新楼诗二十首：杜鹃楼",
      "content": [
        "杜鹃如火千房拆，丹槛低看晚景中。",
        "繁艳向人啼宿露，",
        "惟有此花随越鸟，一声啼处满山红。"
      ],
      "author": {
        "id": 4777,
        "name": "李绅"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 356031,
      "title": "新楼诗二十首：满桂楼",
      "content": [
        "为怜湖水通宵望，不学樊杨却月楼。",
        "惟待素规澄满镜，",
        "萧瑟晓风闻木落，此时何异洞庭秋。"
      ],
      "author": {
        "id": 4777,
        "name": "李绅"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 356032,
      "title": "新楼诗二十首：东武亭",
      "content": [
        "绿波春水湖光满，丹槛连楹碧嶂遥。",
        "兰鹢对飞渔棹急，",
        "鼍鼓若雷争胜负，柳堤花岸万人招。"
      ],
      "author": {
        "id": 4777,
        "name": "李绅"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 356033,
      "title": "新楼诗二十首：龙宫寺",
      "content": [
        "银地溪边遇衲师，笑将花宇指潜知。",
        "定观玄度生前事，",
        "好令沧海龙宫子，长护金人旧浴池。"
      ],
      "author": {
        "id": 4777,
        "name": "李绅"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 356034,
      "title": "新楼诗二十首：禹庙",
      "content": [
        "削平水土穷沧海，畚锸东南尽会稽。",
        "山拥翠屏朝玉帛，",
        "清庙万年长血食，始知明德与天齐。"
      ],
      "author": {
        "id": 4777,
        "name": "李绅"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 356035,
      "title": "新楼诗二十首：晏安寺",
      "content": [
        "寺深松桂无尘事，地接荒郊带夕阳。",
        "啼鸟歇时山寂寂，",
        "丘垄渐平边茂草，九原何处不心伤。"
      ],
      "author": {
        "id": 4777,
        "name": "李绅"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 356036,
      "title": "新楼诗二十首：龟山",
      "content": [
        "一峰凝黛当明镜，十仞乔松倚翠屏。",
        "秋月满时侵兔魄，",
        "不学大蛟凭水怪，等闲雪雨害生灵。"
      ],
      "author": {
        "id": 4777,
        "name": "李绅"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 356037,
      "title": "新楼诗二十首：重台莲",
      "content": [
        "绿荷舒卷凉风晓，红萼开萦紫菂重。",
        "游女汉皋争笑脸，",
        "终恐玉京仙子识，却将归种碧池峰。"
      ],
      "author": {
        "id": 4777,
        "name": "李绅"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 356038,
      "title": "新楼诗二十首：橘园",
      "content": [
        "江城雾敛轻霜早，园橘千株欲变金。",
        "朱实摘时天路近，",
        "怜尔结根能自保，不随寒暑换贞心。"
      ],
      "author": {
        "id": 4777,
        "name": "李绅"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 356039,
      "title": "新楼诗二十首：寒林寺",
      "content": [
        "最深城郭在人烟，疑借壶中到梵天。",
        "岩树桂花开月殿，",
        "应是法宫传觉路，使无烦恼见青莲。"
      ],
      "author": {
        "id": 4777,
        "name": "李绅"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 356040,
      "title": "新楼诗二十首：北楼樱桃花",
      "content": [
        "开花占得春光早，雪缀云装万萼轻。",
        "凝艳拆时初照日，",
        "多事东风入闺闼，尽飘芳思委江城。"
      ],
      "author": {
        "id": 4777,
        "name": "李绅"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 356041,
      "title": "新楼诗二十首：城上蔷薇",
      "content": [
        "蔷薇繁艳满城阴，烂熳开红次第深。",
        "新蕊度香翻宿蝶，",
        "风月寂寥思往事，暮春空赋白头吟。"
      ],
      "author": {
        "id": 4777,
        "name": "李绅"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 356042,
      "title": "新楼诗二十首：南庭竹",
      "content": [
        "东南旧美凌霜操，五月凝阴入坐寒。",
        "烟惹翠梢含玉露，",
        "知尔结根香实在，凤凰终拟下云端。"
      ],
      "author": {
        "id": 4777,
        "name": "李绅"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 356043,
      "title": "新楼诗二十首：琪树",
      "content": [
        "石桥峰上栖玄鹤，碧阙岩边荫羽人。",
        "冰叶万条垂碧实，",
        "徒使茯苓成琥珀，不为松老化龙鳞。"
      ],
      "author": {
        "id": 4777,
        "name": "李绅"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 356044,
      "title": "新楼诗二十首：海棠",
      "content": [
        "海边佳树生奇彩，知是仙山取得栽。",
        "琼蕊籍中闻阆苑，",
        "寄语春园百花道，莫争颜色泛金杯。"
      ],
      "author": {
        "id": 4777,
        "name": "李绅"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 356045,
      "title": "新楼诗二十首：水寺",
      "content": [
        "烟波野寺经过处，水国苍茫梦想中。",
        "云散浦间江月迥，",
        "闻道化城方便喻，只应从此到龙宫。"
      ],
      "author": {
        "id": 4777,
        "name": "李绅"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 356046,
      "title": "新楼诗二十首：灵汜桥",
      "content": [
        "灵汜桥边多感伤，分明湖派绕回塘。",
        "岸花前后闻幽鸟，",
        "何须化鹤归华表，却数凋零念越乡。"
      ],
      "author": {
        "id": 4777,
        "name": "李绅"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 356047,
      "title": "若耶溪",
      "content": [
        "岚光花影绕山阴，山转花稀到碧浔。",
        "倾国美人妖艳远，",
        "应是蛟龙长不去，若耶秋水尚沉沉。"
      ],
      "author": {
        "id": 4777,
        "name": "李绅"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 356048,
      "title": "登禹庙回降雪五言二十韵",
      "content": [
        "金奏云坛毕，同云拂雪来。",
        "玉田千亩合，琼室万家开。",
        "湖暗冰封镜，山明树变梅。",
        "裂缯分井陌，连璧混楼台。",
        "麻引诗人兴，盐牵谢女才。",
        "细疑歌响尽，旅作舞腰回。",
        "著水鹅毛失，铺松鹤羽摧。",
        "半崖云掩映，当砌月裴回。",
        "遇物纤能状，随方巧若裁。",
        "玉花全缀萼，珠蚌尽呈胎。",
        "志士书频照，鲛人杼正催。",
        "妒妆凌粉匣，欺酒上琼杯。",
        "海使迷奔辙，江涛认暗雷。",
        "疾飘风作驭，轻集霰为媒。",
        "剑客休矜利，农师正念摧。",
        "瑞彰知有感，灵贶表无灾。",
        "尧历占新庆，虞阶想旧陪。",
        "粉凝莺阁下，银结凤池隈。",
        "鸡树花惊笑，龙池絮欲猜。",
        "劳歌会稽守，遥祝永康哉。"
      ],
      "author": {
        "id": 4777,
        "name": "李绅"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 356049,
      "title": "题法华寺五言二十韵",
      "content": [
        "花界无生地，慈宫有相天。",
        "化娥腾宝像，留影閟金仙。",
        "殿涌全身塔，池开半月泉。",
        "十峰排碧落，双涧合清涟。",
        "药草经行遍，香灯次第燃。",
        "戒珠高腊护，心印祖僧传。",
        "瓶识先罗汉，衣存旧福田。",
        "幻身观火宅，昏眼照青莲。",
        "住觉超真境，依游渡法船。",
        "化城珠百亿，灵迹冠三千。",
        "萧壁将沈影，梁薪尚缀烟。",
        "色尘知有数，劫烬岂无年。",
        "龙喷疑通海，鲸吞想漏川。",
        "磬疏闻启梵，钟息见安禅。",
        "指喻三车觉，开迷五阴缠。",
        "教通方便入，心达是非诠。",
        "贝叶千花藏，檀林万宝篇。",
        "坐严狮子迅，幢饰网珠悬。",
        "极乐知无碍，分明应有缘。",
        "还将意功德，留偈法王前。"
      ],
      "author": {
        "id": 4777,
        "name": "李绅"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 356050,
      "title": "宿越州天王寺",
      "content": [
        "海隅布政惭期月，江上沾巾愧万人。",
        "休按簿书惩黠吏，",
        "清夜佛宫观色相，却归前老更前身。"
      ],
      "author": {
        "id": 4777,
        "name": "李绅"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 356051,
      "title": "却渡西陵别越中父老",
      "content": [
        "海潮晚上江风急，津吏篙师语默齐。",
        "倾手奉觞看故老，",
        "渐举云帆烟水阔，杳然凫雁各东西。"
      ],
      "author": {
        "id": 4777,
        "name": "李绅"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 356052,
      "title": "却到浙西",
      "content": [
        "临平水竭蒹葭死，里社萧条旅馆秋。",
        "尝叹晋郊无乞籴，",
        "苛政尚存犹惕息，老人偷拜拥前舟。"
      ],
      "author": {
        "id": 4777,
        "name": "李绅"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 356053,
      "title": "苏州不住遥望武丘报恩两寺",
      "content": [
        "秋山古寺东西远，竹院松门怅望同。",
        "幽鸟静时侵径月，",
        "官备散寮身却累，往来惭谢二莲宫。"
      ],
      "author": {
        "id": 4777,
        "name": "李绅"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 356054,
      "title": "回望馆娃故宫",
      "content": [
        "江云断续草绵连，云隔秋波树覆烟。",
        "飘雪荻花铺涨渚，",
        "因问馆娃何所恨，破吴红脸尚开莲。"
      ],
      "author": {
        "id": 4777,
        "name": "李绅"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 356055,
      "title": "姑苏台杂句",
      "content": [
        "越王巧破夫差国，来献黄金重雕刻。",
        "西施醉舞花艳倾，",
        "歌清管咽欢未极，越师戈甲浮江来。",
        "伍胥抉目看吴灭，",
        "灵岩香径掩禅扉，秋草荒凉遍落晖。",
        "江浦回看鸥鸟没，",
        "野寺经过惧悔尤，公程迫蹙悲秋馆。",
        "吴乡越国旧淹留，"
      ],
      "author": {
        "id": 4777,
        "name": "李绅"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 356056,
      "title": "开元寺",
      "content": [
        "十层花宇真毫相，数仞峰峦閟月扉。",
        "攒立宝山中色界，",
        "难保尔形终不转，莫令偷拂六铢衣。"
      ],
      "author": {
        "id": 4777,
        "name": "李绅"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 356057,
      "title": "皋桥",
      "content": [
        "伯鸾憔悴甘飘寓，非向嚣尘隐姓名。",
        "鸿鹄羽毛终有志，",
        "犹有余风未磨灭，至今乡里重和鸣。"
      ],
      "author": {
        "id": 4777,
        "name": "李绅"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 356058,
      "title": "真娘墓",
      "content": [
        "一株繁艳春城尽，双树慈门忍草生。",
        "愁态自随风烛灭，",
        "还似钱塘苏小小，只应回首是卿卿。"
      ],
      "author": {
        "id": 4777,
        "name": "李绅"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 356059,
      "title": "却望无锡芙蓉湖",
      "content": [
        "水宽山远烟岚迥，柳岸萦回在碧流。",
        "清昼不风凫雁少，却疑初梦镜湖秋。",
        "丹橘村边独火微，碧流明处雁初飞。",
        "萧条落叶垂杨岸，隔水寥寥闻捣衣。",
        "逐波云影参差远，背日岚光隐见深。",
        "犹似望中连海树，月生湖上是山阴。",
        "旧山认得烟岚近，湖水平铺碧岫间。",
        "喜见云泉还怅望，自惭山叟不归山。",
        "翠崖幽谷分明处，倦鸟归云在眼前。",
        "惆怅白头为四老，远随尘土去伊川。"
      ],
      "author": {
        "id": 4777,
        "name": "李绅"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 356060,
      "title": "重到惠山",
      "content": [
        "碧峰依旧松筠老，重得经过已白头。",
        "俱是海天黄叶信，",
        "还向窗间名姓下，数行添记别离愁。"
      ],
      "author": {
        "id": 4777,
        "name": "李绅"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 356061,
      "title": "鉴玄影堂",
      "content": [
        "香灯寂寞网尘中，烦恼身须色界空。",
        "龙钵已倾无法雨，",
        "深夜月明松子落，俨然听法侍生公。"
      ],
      "author": {
        "id": 4777,
        "name": "李绅"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 356062,
      "title": "别石泉",
      "content": [
        "素沙见底空无色，青石潜流暗有声。",
        "微渡竹风涵淅沥，",
        "应是梵宫连洞府，浴池今化醒泉清。"
      ],
      "author": {
        "id": 4777,
        "name": "李绅"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 356063,
      "title": "别双温树",
      "content": [
        "翠条盈尺怜孤秀，植向西窗待月轩。",
        "轻剪绿丝秋叶暗，",
        "看尔拂云今得地，莫随陵谷改深根。"
      ],
      "author": {
        "id": 4777,
        "name": "李绅"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 356064,
      "title": "重别西湖",
      "content": [
        "浦边梅叶看凋落，波上双禽去寂寥。",
        "吹管曲传花易失，",
        "繁艳彩毛无处所，尽成愁叹别溪桥。"
      ],
      "author": {
        "id": 4777,
        "name": "李绅"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 356065,
      "title": "毗陵东山",
      "content": [
        "昔人别馆淹留处，卜筑东山学谢家。",
        "丛桂半空摧枳棘，",
        "依旧秋风还寂寞，数行衰柳宿啼鸦。"
      ],
      "author": {
        "id": 4777,
        "name": "李绅"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 356066,
      "title": "建元寺",
      "content": [
        "江城物候伤心地，远寺经过禁火辰。",
        "芳草垄边回首客，",
        "叹息光阴催白发，莫悲风月独沾巾。"
      ],
      "author": {
        "id": 4777,
        "name": "李绅"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 356067,
      "title": "却到金陵登北固亭",
      "content": [
        "龙形江影隔云深，虎势山光入浪沈。",
        "潮蹙海风驱万里，",
        "还叱楫师看五两，莫令辜负济川心。"
      ],
      "author": {
        "id": 4777,
        "name": "李绅"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 356068,
      "title": "望鹤林寺",
      "content": [
        "鹤栖峰下青莲宇，花发江城世界春。",
        "红照日高殷夺火，",
        "自叹秋风劳物役，白头拘束一闲人。"
      ],
      "author": {
        "id": 4777,
        "name": "李绅"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 356069,
      "title": "宿瓜州",
      "content": [
        "烟昏水郭津亭晚，回望金陵若动摇。",
        "冲浦回风翻宿浪，",
        "官冷旧谙唯旅馆，岁阴轻薄是凉飙。"
      ],
      "author": {
        "id": 4777,
        "name": "李绅"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 356070,
      "title": "入扬州郭",
      "content": [
        "菊芳沙渚残花少，柳过秋风坠叶疏。",
        "堤绕门津喧井市，",
        "非为掩身羞白发，自缘多病喜肩舆。"
      ],
      "author": {
        "id": 4777,
        "name": "李绅"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 356071,
      "title": "宿扬州水馆",
      "content": [
        "舟依浅岸参差合，桥映晴虹上下连。",
        "轻楫过时摇水月，",
        "闲凭栏干指星汉，尚疑轩盖在楼船。"
      ],
      "author": {
        "id": 4777,
        "name": "李绅"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 356072,
      "title": "州中小饮便别牛相",
      "content": [
        "笙歌罢曲辞宾侣，庭竹移阴就小斋。",
        "愁不解颜徒满酌，",
        "从此别离长酩酊，洛阳狂狷任椎埋。"
      ],
      "author": {
        "id": 4777,
        "name": "李绅"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 356073,
      "title": "却过淮阴吊韩信庙",
      "content": [
        "功高自弃汉元臣，遗庙阴森楚水滨。",
        "英主任贤增虎翼，",
        "徒用千金酬一饭，不知明哲重防身。"
      ],
      "author": {
        "id": 4777,
        "name": "李绅"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 356074,
      "title": "却入泗口",
      "content": [
        "洪河一派清淮接，堤草芦花万里秋。",
        "烟树寂寥分楚泽，",
        "惆怅路岐真此处，夕阳西没水东流。"
      ],
      "author": {
        "id": 4777,
        "name": "李绅"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 356075,
      "title": "重入洛阳东门",
      "content": [
        "商颜重命伊川叟，时事知非入洛人。",
        "连野碧流通御苑，",
        "驱马独归寻里巷，日斜行处旧红尘。"
      ],
      "author": {
        "id": 4777,
        "name": "李绅"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 356076,
      "title": "拜三川守",
      "content": [
        "恭承宠诏临伊洛，静守朝章化比闾。",
        "风变市儿惊偃草，",
        "唯有从容期一德，使齐文教奉皇居。"
      ],
      "author": {
        "id": 4777,
        "name": "李绅"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 356077,
      "title": "庆云见",
      "content": [
        "礼成中岳陈金册，祥报卿云冠玉峰。",
        "轻未透林疑待凤，",
        "还入九霄成沆瀣，夕岚生处鹤归松。"
      ],
      "author": {
        "id": 4777,
        "name": "李绅"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 356078,
      "title": "灵蛇见少林寺",
      "content": [
        "琐文结绶灵蛇降，蠖屈螭盘顾视闲。",
        "鳞蹙翠光抽璀璨，",
        "知尔全身护昆阆，不矜挥尾在常山。"
      ],
      "author": {
        "id": 4777,
        "name": "李绅"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 356079,
      "title": "拜宣武军节度使",
      "content": [
        "油幢并入虎旗开，锦橐从天凤诏来。",
        "星应魏师新鼓角，",
        "伊洛镜清回首处，是非纷杂任尘埃。"
      ],
      "author": {
        "id": 4777,
        "name": "李绅"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 356080,
      "title": "到宣武三十韵",
      "content": [
        "七月趋梁苑，三年谢尹京。",
        "旧风除物蠹，新律奉师贞。",
        "龙节双油重，蛇矛百练明。",
        "跃鱼连后旆，腾虎耀前旌。",
        "路转金神并，川开铁马横。",
        "拥旄差白羽，分辔引红缨。",
        "在浚风烟接，维嵩巩洛清。",
        "贯鱼奔骑疾，连雁卷行轻。",
        "烟垒风调角，秋原雨洗兵。",
        "宿云看布甲，疏柳见分营。",
        "鼓彻通宵警，和门候晓晴。",
        "虎符三校列，鱼胄万夫迎。",
        "弄马猿猱健，奔车角抵呈。",
        "驾肩傍隘道，张幕内连楹。",
        "森戟承三令，攒戈退一声。",
        "及郊知雨过，观俗辨风行。",
        "望宋怜思女，游梁念客卿。",
        "义夫留感激，公子播英名。",
        "泽广豚鱼洽，恩宣岂弟生。",
        "善师忘任智，中略在推诚。",
        "式宴歌钟合，陈筵绮绣并。",
        "戏鼙千卒跃，均酒百壶倾。",
        "乐与师徒共，欢从井邑盈。",
        "教通因渐染，人悦尚和平。",
        "授钺惭分阃，登坛荷列城。",
        "虚裘朝独坐，雄剑夜孤鸣。",
        "白发侵霜变，丹心捧日惊。",
        "卫青终保志，潘岳未忘情。",
        "期月终迷化，三年讵有成。",
        "惟看波海动，天外斩长鲸。"
      ],
      "author": {
        "id": 4777,
        "name": "李绅"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 356081,
      "title": "江南暮春寄家",
      "content": [
        "雒阳城见梅迎雪，鱼口桥逢雪送梅。",
        "剑水寺前芳草合，",
        "想得心知近寒食，潜听喜鹊望归来。"
      ],
      "author": {
        "id": 4777,
        "name": "李绅"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 356082,
      "title": "奉酬乐天立秋夕有怀见寄",
      "content": [
        "深夜星汉静，秋风初报凉。",
        "阶篁淅沥响，露叶参差光。",
        "冰兔半升魄，铜壶微滴长。",
        "薄帷乍飘卷，襟带轻摇飏。",
        "此际昏梦清，斜月满轩房。",
        "屣履步前楹，剑戟森在行。",
        "重城宵正分，号鼓互相望。",
        "独坐有所思，夫君鸾凤章。",
        "天津落星河，一苇安可航。",
        "龙泉白玉首，鱼服黄金装。",
        "报国未知效，惟鹈徒在梁。",
        "裴回顾戎旃，颢气生东方。",
        "衰叶满栏草，斑毛盈镜霜。",
        "羸牛未脱辕，老马强腾骧。",
        "吟君白雪唱，惭愧巴人肠。"
      ],
      "author": {
        "id": 4777,
        "name": "李绅"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 356085,
      "title": "华山庆云见",
      "content": [
        "圣主祠名岳，高峰发庆云。",
        "金柯初缭绕，玉叶渐氛氲。",
        "气色含珠日，晴夫吐翠雰。",
        "依稀来鹤态，仿佛列山群。",
        "万树流光影，千潭写锦文。",
        "苍生欣有望，祥瑞在吾君。"
      ],
      "author": {
        "id": 4777,
        "name": "李绅"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 356086,
      "title": "欲到西陵寄王行周",
      "content": [
        "西陵沙岸回流急，船底粘沙去岸遥。",
        "驿吏递呼催下缆，",
        "欲责舟人无次第，自知贪酒过春潮。"
      ],
      "author": {
        "id": 4777,
        "name": "李绅"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 356087,
      "title": "华顶",
      "content": [
        "欲向仙峰炼九丹，独瞻华顶礼仙坛。",
        "石标琪树凌空碧，",
        "浮生未有从师地，空诵仙经想羽翰。"
      ],
      "author": {
        "id": 4777,
        "name": "李绅"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 356088,
      "title": "莺莺歌",
      "content": [
        "伯劳飞迟燕飞疾，垂杨绽金花笑日。",
        "绿窗娇女字莺莺，",
        "门掩重关萧寺中，芳草花时不曾出。"
      ],
      "author": {
        "id": 4777,
        "name": "李绅"
