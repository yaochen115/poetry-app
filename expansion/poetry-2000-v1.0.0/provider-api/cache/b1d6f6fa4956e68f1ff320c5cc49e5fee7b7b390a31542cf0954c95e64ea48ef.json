{
  "data": [
    {
      "id": 173888,
      "title": "送陈郎中还京兼过九江新宅",
      "content": [
        "鹢舟金碧照溪沙，帆上风吹五两斜。",
        "罢郡紫泥催向阙，过江红旆引还家。",
        "因将旧社人携酒，应喜新林树见花。",
        "莫作山斋久留意，中台虚位有清华。"
      ],
      "author": {
        "id": 8104,
        "name": "曾巩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 173889,
      "title": "遣兴",
      "content": [
        "青灯斗鼠窥寒砚，落月啼乌送迥笳。",
        "江汉置身贫作客，溪山合眼梦还家。",
        "百忧忽忽丹心破，万事悠悠两鬓华。",
        "谁与健帆先度鸟，更无留滞向天涯。"
      ],
      "author": {
        "id": 8104,
        "name": "曾巩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 173890,
      "title": "楚泽",
      "content": [
        "楚泽荒凉白露根，盈虚无处问乾坤。",
        "虫虫旱气连年有，寂寂遗人几户存。",
        "盗贼恐多从此始，经纶空健与谁论。",
        "诸公日议云台上，忍使忧民独至尊。"
      ],
      "author": {
        "id": 8104,
        "name": "曾巩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 173891,
      "title": "西亭",
      "content": [
        "团扇频挥到此亭，他乡愁坐思冥冥。",
        "空羞避俗无高节，转觉逢人恶独醒。",
        "岁月淹留随日老，乾坤狼狈几时宁。",
        "欲知事事今何似，万里波涛一点萍。"
      ],
      "author": {
        "id": 8104,
        "name": "曾巩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 173892,
      "title": "盆池",
      "content": [
        "环环清泚旱犹深，炳炳芙蓉近可寻。",
        "苍壁巧藏天影入，翠奁微带藓痕侵。",
        "能供水石三秋兴，不负江湖万里心。",
        "照影独怜身老去，日添华髪已盈簪。"
      ],
      "author": {
        "id": 8104,
        "name": "曾巩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 173893,
      "title": "羁游",
      "content": [
        "粗饭寒齑且自如，欲将吾道付樵渔。",
        "羁游事事情怀恶，贫病年年故旧疏。",
        "自古幸容元亮醉，凡今谁喜子云书。",
        "何由得洗尘埃尽，恣买沧洲结草庐。"
      ],
      "author": {
        "id": 8104,
        "name": "曾巩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 173894,
      "title": "南轩竹",
      "content": [
        "密竹娟娟数十茎，旱天萧洒有高情。",
        "风吹已送烦心醒，雨洗还供远眼清。",
        "新笋巧穿苔石去，碎阴微破粉墙生。",
        "应须万物冰霜后，来看琅玕色转明。"
      ],
      "author": {
        "id": 8104,
        "name": "曾巩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 173895,
      "title": "浮云楼和赵嘏",
      "content": [
        "万里聊供远眼开，檐前不尽水声哀。",
        "朝云尚拂阳台去，羽猎曾围梦泽来。",
        "解带欲留长日坐，倾壶难饮故人杯。",
        "邅穷万里飘萍内，到此登临更几回。"
      ],
      "author": {
        "id": 8104,
        "name": "曾巩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 173896,
      "title": "照影亭",
      "content": [
        "河流萦槛色辉辉，无数幽禽入镜飞。",
        "已映渚花红四出，更涵沙柳翠相围。",
        "不欺毫髪公虽有，太尽妍媸道恐非。",
        "自笑病容随步见，未衰华髪满缁衣。"
      ],
      "author": {
        "id": 8104,
        "name": "曾巩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 173897,
      "title": "晚望",
      "content": [
        "蛮荆人事几推移，旧国兴亡欲问谁。",
        "郑袖风流今已尽，屈原辞赋世空悲。",
        "深山大泽成千古，暮雨朝云又一时。",
        "落日西楼凭槛久，闲愁唯有此心知。"
      ],
      "author": {
        "id": 8104,
        "name": "曾巩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 173898,
      "title": "书阁",
      "content": [
        "自怜野性生来拙，谁许交情晚最亲。",
        "世路因仍忧槛阱，他乡衰暮傍风尘。",
        "惟将菽藿还求志，未有丝毫可为人。",
        "一亩萧然须暂得，欲偷闲日长精神。"
      ],
      "author": {
        "id": 8104,
        "name": "曾巩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 173899,
      "title": "赠弹琴者",
      "content": [
        "至音淡薄谁曾赏，古意飘零自可怜。",
        "不似秦筝能合意，满堂倾耳十三弦。"
      ],
      "author": {
        "id": 8104,
        "name": "曾巩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 173900,
      "title": "寄孙正之",
      "content": [
        "貌癯心苦气飘飘，长饿空林不可招。",
        "能举丘山惟笔力，可摩云日是风标。",
        "诗篇缀缉应千首，学术窥寻岂一朝。",
        "耳冷高谈经岁远，江南春动雪还消。"
      ],
      "author": {
        "id": 8104,
        "name": "曾巩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 173901,
      "title": "秋日感事示介甫",
      "content": [
        "秋日气己盛，阴虫朝暮声。",
        "烟云断溪树，风雨入山城。",
        "沙碛有遗虏，旌旗多远行。",
        "生民苦未息，吾党耻论兵。"
      ],
      "author": {
        "id": 8104,
        "name": "曾巩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 173902,
      "title": "简翁都官",
      "content": [
        "倦游公府曳长裾，笑上扁舟指旧庐。",
        "自有文章真杞梓，不须雕琢是璠玙。",
        "浮蛆满瓮尝春酒，垂露临窗理素书。",
        "况得君宾同壮节，一乡清问更谁知。"
      ],
      "author": {
        "id": 8104,
        "name": "曾巩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 173903,
      "title": "陈祁秀才园亭",
      "content": [
        "眼无尘土境殊清，一绕芳蹊病体轻。",
        "烟树疑从古画见，水轩真在碧天行。",
        "君能极巧安山势，我欲忘归听竹声。",
        "只恐主人难住此，弟兄嘉行满乡评。"
      ],
      "author": {
        "id": 8104,
        "name": "曾巩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 173904,
      "title": "上杜相公",
      "content": [
        "水为舟楫旱为霖，社稷生民注意深。",
        "岂谓便辞黄阁议，翻然求就紫芝吟。",
        "始终好古儒林士，进退忧时国老心。",
        "只有声名随日远，不令功被管弦音。"
      ],
      "author": {
        "id": 8104,
        "name": "曾巩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 173905,
      "title": "胡太傅挽词二首  其一",
      "content": [
        "谠言留简册，恭德载闺门。",
        "福履三朝盛，官仪一品尊。",
        "九原无复起，万事付谁论。",
        "不必诸儒记，清名久自存。"
      ],
      "author": {
        "id": 8104,
        "name": "曾巩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 173906,
      "title": "胡太傅挽词二首  其二",
      "content": [
        "远略参基命，雄文入典章。",
        "輤车俄就路，瑞节始还乡。",
        "象物陈虚寝，哀歌寄奠觞。",
        "惟应九原上，松桧日苍苍。"
      ],
      "author": {
        "id": 8104,
        "name": "曾巩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 173907,
      "title": "酬材叔江西道中作",
      "content": [
        "枉渚荒源百里间，草根经烧旧痕干。",
        "入陂野水冬来浅，对树诸峰雪后寒。",
        "坞笛最宜风外听，岭梅初得醉中看。",
        "行寻故友心无事，不觉西游道路难。"
      ],
      "author": {
        "id": 8104,
        "name": "曾巩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 173908,
      "title": "送双渐之汉阳",
      "content": [
        "楚国封疆最上流，夹江分命两诸侯。",
        "何年南狩牙樯出，六月西来雪浪浮。",
        "夏口楼台供夕望，晴川风物待春游。",
        "可能频度渔阳曲，不负当年鹦鹉洲。"
      ],
      "author": {
        "id": 8104,
        "name": "曾巩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 173909,
      "title": "孔明",
      "content": [
        "称吴称魏已纷纷，渭水西边独汉臣。",
        "平日将军不三顾，寻常田里带经人。"
      ],
      "author": {
        "id": 8104,
        "name": "曾巩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 173910,
      "title": "闲行",
      "content": [
        "草软沙匀野路晴，竹枝乌帽称闲行。",
        "鸟啼绿树穿花影，风出青山送水声。",
        "转觉所忧非己事，尽从多难见人情。",
        "闲中我乐人应笑，忙处人争我不争。"
      ],
      "author": {
        "id": 8104,
        "name": "曾巩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 173911,
      "title": "赠安禅懃",
      "content": [
        "讵知萧洒吾庐旧，却有高明此寺邻。",
        "水竹迸生刚节老，秋山过抱翠岚新。",
        "惟怜季子归来困，自笑原思久更贫。",
        "深识幽人风义厚，扫轩开榻最相亲。"
      ],
      "author": {
        "id": 8104,
        "name": "曾巩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 173912,
      "title": "赠护仁监院",
      "content": [
        "人贫举世今为甚，僧事新年始更多。",
        "食粝衣穿虽扰扰，构虚基险自峨峨。",
        "诛茅改筑君初有，系马长吟我暂过。",
        "但觉满山金碧涧，不知谁到为烟萝。"
      ],
      "author": {
        "id": 8104,
        "name": "曾巩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 173913,
      "title": "送觉祖院明上人",
      "content": [
        "冠石新墙日月回，丰堂瓌殿起崔嵬。",
        "钟随秋势金声壮，佛隠寒云玉座开。",
        "流水远奔双涧去，平林高拥四山来。",
        "麒麟细草南东路，一望松门意自哀。"
      ],
      "author": {
        "id": 8104,
        "name": "曾巩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 173914,
      "title": "谒李白墓",
      "content": [
        "世间遗草三千首，林下荒坟二百年。",
        "信矣辉光争日月，依然精爽动山川。",
        "曾无近属持门户，空有乡人拂几筵。",
        "顾我自惭才力薄，欲将何物吊前贤。"
      ],
      "author": {
        "id": 8104,
        "name": "曾巩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 173915,
      "title": "送抚州钱郎中",
      "content": [
        "名郎元是足风流，得郡东南地更优。",
        "翠幕管弦三市晚，画堂烟雨五峰秋。",
        "黄柑巧缀星垂槛，香稻匀翻雪满瓯。",
        "应与谢公资健笔，邦人才薄讵能酬。"
      ],
      "author": {
        "id": 8104,
        "name": "曾巩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 173916,
      "title": "送韩玉汝使两浙",
      "content": [
        "使传东驰下九天，此邦曾屈试鸣弦。",
        "仁声又向新年入，惠泽犹为故老传。",
        "翠𪩘烟云生席上，沧溟风雨到樽前。",
        "经营智略多余暇，赏燕谁酬白雪篇。"
      ],
      "author": {
        "id": 8104,
        "name": "曾巩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 173917,
      "title": "丁元珍挽词二首  其一",
      "content": [
        "翰墨金声远，神情玉气温。",
        "节廉贫愈见，风义老弥惇。",
        "旧学资详正，新仪属讨论。",
        "谁怜一麾出，终不反修门。"
      ],
      "author": {
        "id": 8104,
        "name": "曾巩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 173918,
      "title": "丁元珍挽词二首  其二",
      "content": [
        "从军王粲笔，记礼后苍篇。",
        "谩有残书在，能令好事传。",
        "𫛳来悲四月，鹤去遂千年。",
        "试想长桥路，昏昏陇隧烟。"
      ],
      "author": {
        "id": 8104,
        "name": "曾巩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 173919,
      "title": "简景山侍御",
      "content": [
        "长年心事最相亲，一笑相疏忽数旬。",
        "柏府地严方许国，芸台官冷但容身。",
        "饥肠漫窃公厨膳，病发难堪客舍尘。",
        "还有鹿门栖宿兴，想君他日肯为邻。"
      ],
      "author": {
        "id": 8104,
        "name": "曾巩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 173920,
      "title": "送李莘太博",
      "content": [
        "郪道鸣弦去，容台抱𫈵初。",
        "尘沙开祖帐，冰雪映征车。",
        "久待连城价，谁腾一鹗书。",
        "君王览豪俊，应复召严徐。"
      ],
      "author": {
        "id": 8104,
        "name": "曾巩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 173921,
      "title": "游天章寺",
      "content": [
        "篮舆朝出踏轻尘，拂面毵毵柳色新。",
        "曲水岂能留往事，南湖空解照行人。",
        "最宜灵运登山屐，不负渊明漉酒巾。",
        "老去飘零心未折，暂须同醉海边春。"
      ],
      "author": {
        "id": 8104,
        "name": "曾巩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 173922,
      "title": "送关彦远",
      "content": [
        "莫辞为我百分饮，从此送君千里行。",
        "物情簪屦尚须念，人道交亲那可轻。",
        "渚梅江柳弄佳色，林鸟野蜂吟好声。",
        "对之但醉余可置，明日此杯谁共倾。"
      ],
      "author": {
        "id": 8104,
        "name": "曾巩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 173923,
      "title": "送关彦远赴江西",
      "content": [
        "食饮冰廉士操，敝衣穿履古人风。",
        "溪堂兴足登临后，滕阁今归啸傲中。",
        "一榻高悬宾阁峻，二龙俱化县池空。",
        "因过胜境须行乐，驿召方当急诏东。"
      ],
      "author": {
        "id": 8104,
        "name": "曾巩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 173924,
      "title": "西园席上",
      "content": [
        "省阁名郎国羽仪，瀛洲仙客众蓍龟。",
        "山蹊向日花开早，海聚经寒酒熟迟。",
        "下榻笑谈红旆偃，引觞醉醒玉钗随。",
        "唯惭别乘疏顽甚，满面尘埃更有诗。"
      ],
      "author": {
        "id": 8104,
        "name": "曾巩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 173925,
      "title": "送孙颖贤",
      "content": [
        "穰穰秦州铁马群，青衫吾子仕犹屯。",
        "高谈消长才惊世，藐视公侯行出人。",
        "古气欲遵奔日月，畏涂曾触滞荆榛。",
        "明夷夬决应斟酌，自向穷通有屈伸。"
      ],
      "author": {
        "id": 8104,
        "name": "曾巩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 173926,
      "title": "送郑州邵资政",
      "content": [
        "江夏无双誉，菑川第一才。",
        "笑谈成黼藻，咳唾落琼瑰。",
        "紫气锋铓露，青冥羽翼开。",
        "隽游追幕府，高步集蓬莱。",
        "探讨篇章洽，研磨术业该。",
        "九霄新汉邸，万目注梁台。",
        "选择真儒用，招延急诏催。",
        "衣冠惊角绮，宾友重邹枚。",
        "每右横经席，宁虚置醴杯。",
        "八荒披日月，万里散云雷。",
        "始去东山榜，俄参北斗魁。",
        "庙堂奇计得，羌虏鸷心摧。",
        "帝念人求旧，朝须汝作梅。",
        "避荣言屡切，请外志难回。",
        "际海归封略，连吴入剸裁。",
        "夕冰承命出，昼锦过乡来。",
        "许国风猷壮，容民宇量恢。",
        "节旄恩换镇，京室地称陪。",
        "赐觐亲中扆，通班接上台。",
        "壶浆空度洧，公位在三槐。"
      ],
      "author": {
        "id": 8104,
        "name": "曾巩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 173927,
      "title": "看花",
      "content": [
        "春来日日探花开，紫陌看花始此回。",
        "欲赋妍华无健笔，拟酬芳景怕深杯。",
        "但知抖擞红尘去，莫问鬅鬙白发催。",
        "更老风情转应少，且邀佳客试徘徊。"
      ],
      "author": {
        "id": 8104,
        "name": "曾巩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 173928,
      "title": "会稽绝句三首  其一",
      "content": [
        "花开日日去看花，迟日犹嫌影易斜。",
        "莫问会稽山外事，但将歌管醉流霞。"
      ],
      "author": {
        "id": 8104,
        "name": "曾巩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 173929,
      "title": "会稽绝句三首  其二",
      "content": [
        "花开日日插花归，酒盏歌喉处处随。",
        "不是心闲无此乐，莫教门外俗人知。"
      ],
      "author": {
        "id": 8104,
        "name": "曾巩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 173930,
      "title": "会稽绝句三首  其三",
      "content": [
        "年年谷雨愁春晚，况是江湖两鬓华。",
        "欲载一樽乘兴去，不知何处有残花。"
      ],
      "author": {
        "id": 8104,
        "name": "曾巩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 173931,
      "title": "送任逵度支监嵩山崇福宫",
      "content": [
        "汉阳门下士，车骑幕中宾。",
        "志节初皆壮，风流久更新。",
        "枢庭承远派，郎位袭清尘。",
        "雅淡琴声古，温纯玉性真。",
        "诗书来射策，慈惠起临人。",
        "淮海褰帷久，褒斜叱驭频。",
        "政平无横吏，刑省绝冤民。",
        "汴路扬旌出，吴门拥节巡。",
        "持权心似水，待物气如春。",
        "懋德垂承诏，遗荣遽乞身。",
        "行高宁系俗，道胜不忧贫。",
        "北绝分琳馆，西归近紫宸。",
        "鸿飞开羽翼，骥逸露精神。",
        "却理烟霞宅，重寻水石邻。",
        "青嵩销鹤怨，碧洛见鸥驯。",
        "故友欣联璧，诸儒慕垫巾。",
        "学兼鸿宝异，兴与赤松亲。",
        "激劝留方册，惊传动缙绅。",
        "浮云虽抗意，仄席正逢辰。",
        "祇恐尊廉退，丁宁致软轮。"
      ],
      "author": {
        "id": 8104,
        "name": "曾巩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 173932,
      "title": "送赵资政",
      "content": [
        "好问逢真主，能言迈古风。",
        "犯颜天意沃，造膝众情通。",
        "弹治心忘势，澄清谊匪躬。",
        "朝廷推指佞，都邑避乘骢。",
        "白简威方厉，青规遇更隆。",
        "析符霄汉上，开幕斗牛中。",
        "里聚追胥息，阶庭讼缿空。",
        "纪纲官特峻，帷幄地弥崇。",
        "吏治连城肃，仓储绝塞充。",
        "锦官清镇俗，玉垒静临戎。",
        "膏泽涵荒阻，春阳煦滞穷。",
        "钧衡求隽望，龟筮协渊衷。",
        "间出千龄合，平居一德同。",
        "股肱康事力，舟楫济川功。",
        "远大经纶略，精微献替忠。",
        "夕冰分外阃，昼锦过江东。",
        "比户仁声入，提封喜气融。",
        "信深销众伪，明盛破群蒙。",
        "正洽讴歌美，俄更节制雄。",
        "保民追吕尚，分土继逢公。",
        "淄水移幢碧，牛山驻旆红。",
        "鱼盐方舸集，绮绣万箱丛。",
        "少憩驱千骑，行归冠百工。",
        "衮衣天下咏，岂独是倥侗。"
      ],
      "author": {
        "id": 8104,
        "name": "曾巩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 173933,
      "title": "过高士坊",
      "content": [
        "一亩萧然绝世喧，抗怀那肯就笼樊。",
        "功名晚更为余事，灾异初尝出至言。",
        "郡阁已空徐孺榻，里人犹识郑公门。",
        "斯文未丧如繇我，后代当知李仲元。"
      ],
      "author": {
        "id": 8104,
        "name": "曾巩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 173934,
      "title": "余杭久旱赵悦道入境之夕四郊雨足二首  其一",
      "content": [
        "连章天上乞身闲，笑入吴船拥节还。",
        "一夜风雷驱旱魃，始知霖雨出人间。"
      ],
      "author": {
        "id": 8104,
        "name": "曾巩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 173935,
      "title": "余杭久旱赵悦道入境之夕四郊雨足二首  其二",
      "content": [
        "旌旗东下路尘开，六月风云席上回。",
        "正恐一方人暍死，直将霖雨过江来。"
      ],
      "author": {
        "id": 8104,
        "name": "曾巩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 173936,
      "title": "钱塘上元夜祥符寺陪咨臣郎中丈燕席",
      "content": [
        "月明如昼露叶浓，锦帐名郎笑语同。",
        "金地夜寒消美酒，玉人春困倚东风。",
        "红云灯火浮沧海，碧水楼台浸远空。",
        "白发蹉跎欢意少，强颜犹入少年丛。"
      ],
      "author": {
        "id": 8104,
        "name": "曾巩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 173937,
      "title": "送沈谏议",
      "content": [
        "东南经济得时英，方底除书下汉庭。",
        "将幕鼓旗惊白昼，谏垣冠剑动青冥。",
        "指㧑瓯越归谈笑，镇压江吴出醉醒。",
        "金鼎盐梅须大用，九霄应已梦仪刑。"
      ],
      "author": {
        "id": 8104,
        "name": "曾巩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 173938,
      "title": "酬王微之汴中见赠",
      "content": [
        "黄流浑浑来沙际，佳气葱葱近日边。",
        "河汉槎虽通远客，蓬莱风未纵归船。",
        "山城剧饮销红烛，水驿高吟襞彩笺。",
        "老去相逢情自密，不关清赏合留连。"
      ],
      "author": {
        "id": 8104,
        "name": "曾巩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 173939,
      "title": "寄郓州邵资政",
      "content": [
        "铅笔雠书客，朱轓守土臣。",
        "素餐方侧席，黄发已侵巾。",
        "喜有山围郭，仍怜水满津。",
        "清华闲耳目，潇洒长精神。",
        "秀色秋来重，寒声雨后新。",
        "宿云当户牖，流月过松筠。",
        "北圃分殊境，西湖断俗尘。",
        "渚花红四出，沙鸟翠相亲。",
        "芡老含珠实，鱼惊跃锦鳞。",
        "飞梁凌窅渺，虚榭压奫沦。",
        "岭对横修竹，洲分抱白苹。",
        "静宜人事拙，闲觉道腴真。",
        "器小难周物，官微幸庇身。",
        "簿书偷暇日，杖屦想幽人。",
        "溯险飞游艇，探奇漾钓缗。",
        "形縻甘鹤怨，心泰得鸥驯。",
        "督府恩容久，芳笺讯问频。",
        "门庭严卫戟，尊俎从华绅。",
        "却起烟霞兴，还思水石邻。",
        "自嗤田父乐，那可荐鸿钧。"
      ],
      "author": {
        "id": 8104,
        "name": "曾巩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 173940,
      "title": "和邵资政",
      "content": [
        "拂衣久欲求三径，窃食聊须把一麾。",
        "世路贱贫从所好，老年胸臆固无奇。",
        "樊笼偶得沧洲趣，芜颣难酬白雪辞。",
        "督府繇来恩礼厚，每容商也与言诗。"
      ],
      "author": {
        "id": 8104,
        "name": "曾巩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 173941,
      "title": "和孔教授",
      "content": [
        "治烦方喜众材同，坐啸南阳郡阁中。",
        "几案有尘书檄简，里闾无事稻粱丰。",
        "衣冠济济归儒学，俎豆诜诜得古风。",
        "幸屈异能来助我，敢将颜色在蜚鸿。"
      ],
      "author": {
        "id": 8104,
        "name": "曾巩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 173942,
      "title": "喜雪二首  其一",
      "content": [
        "欲休还舞任风吹，断续繁云作阵随。",
        "已塞茅蹊人起晚，更迷沙渚鸟飞迟。",
        "混同天地归无迹，润色山川入有为。",
        "太守不辞留客醉，丰年佳兆可前知。"
      ],
      "author": {
        "id": 8104,
        "name": "曾巩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 173943,
      "title": "喜雪二首  其二",
      "content": [
        "杂雨零初急，因风洒更狂。",
        "英华倾月窟，光气泻天潢。",
        "宛转花飞密，纡余舞态长。",
        "化材随大小，成器任圆方。",
        "秀已滋山国，清尤助水乡。",
        "色严齐上下，明盛析毫芒。",
        "润屋情夸诞，埋轮兴激昂。",
        "收功归泽物，全德在包荒。",
        "预喜仓箱富，潜知海岳康。",
        "萧晨迎贺客，歌吹趣传觞。"
      ],
      "author": {
        "id": 8104,
        "name": "曾巩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 173944,
      "title": "雪后同徐秘丞皇甫节推孔教授北园晚步",
      "content": [
        "沙草正黄濒海意，江梅还白故园情。",
        "循除远水春前急，绕郭空山雪后明。",
        "林影易斜寒日短，角声吹去暮云平。",
        "最惭佳客忘形契，肯伴衰翁著屐行。"
      ],
      "author": {
        "id": 8104,
        "name": "曾巩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 173945,
      "title": "郡斋即事二首  其一",
      "content": [
        "画戟森门宠误蒙，从来田舍一衰翁。",
        "囷仓穰穰逢康岁，闾里恂恂有古风。",
        "瞷氏宿奸投海外，伏生新学始山东。",
        "依然自昔兴王地，长在南阳佳气中。"
      ],
      "author": {
        "id": 8104,
        "name": "曾巩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 173946,
      "title": "郡斋即事二首  其二",
      "content": [
        "满轩山色长浮黛，绕舍泉声不受尘。",
        "四境带牛无事日，两衙封印自繇身。",
        "白羊酒熟初看雪，黄杏花开欲探春。",
        "总是济南为郡乐，更将诗兴属何人。"
      ],
      "author": {
        "id": 8104,
        "name": "曾巩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 173947,
      "title": "忆越中梅",
      "content": [
        "浣沙亭北小山梅，兰渚移来手自栽。",
        "今日旧林冰雪地，泠香幽艳向谁开。"
      ],
      "author": {
        "id": 8104,
        "name": "曾巩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 173948,
      "title": "再赋喜雪",
      "content": [
        "六花飞舞势蹁跹，点缀寒林态更妍。",
        "山险龙蛇盘鸟道，野平江海变畬田。",
        "人狂奔月非关夜，马健乘云别有天。",
        "况值白羊新酒熟，可能相就庆丰年。"
      ],
      "author": {
        "id": 8104,
        "name": "曾巩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 173949,
      "title": "寄致仕欧阳少师",
      "content": [
        "四海文章伯，三朝社稷臣。",
        "功名垂竹帛，风义动簪绅。",
        "此道推先觉，诸儒出后尘。",
        "忘机心皎皎，乐善意循循。",
        "大略才超古，昌言勇绝人。",
        "抗怀轻绂冕，沥恳谢陶钧。",
        "耕稼归莘野，畋渔返渭滨。",
        "五年清兴属，一日壮图伸。",
        "北阙恩知旧，东宫命数新。",
        "鸾凰开羽翼，骥𫘧放精神。",
        "旷达林中趣，高闲物外身。",
        "挥金延故老，置驿候嘉宾。",
        "主当西湖月，勾留颍水春。",
        "露寒消鹤怨，沙静见鸥驯。",
        "酒熟夸浮蚁，书成感获麟。",
        "激昂疏受晚，冲淡赤松亲。",
        "龙卧倾时望，鸿冥耸士伦。",
        "少休均逸豫，独往异沉沦。",
        "策画咨询急，仪刑瞩想频。",
        "应须协龟筮，更起为生民。"
      ],
      "author": {
        "id": 8104,
        "name": "曾巩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 173950,
      "title": "冬夜即事",
      "content": [
        "印奁封罢阁铃闲，喜有秋毫免素餐。",
        "市粟易求仓廪实，邑尨无警里闾安。",
        "香清一榻氍毹暖，月淡千门霿凇寒。",
        "闻说丰年从此始，更回笼烛卷帘看。"
      ],
      "author": {
        "id": 8104,
        "name": "曾巩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 173951,
      "title": "酬介甫还自舅家书所感",
      "content": [
        "旱气满原野，子行归旧庐。",
        "吁天高未动，望岁了何如。",
        "荒土欲生火，涸溪容过车。",
        "民期得霖雨，吾岂灌园蔬。"
      ],
      "author": {
        "id": 8104,
        "name": "曾巩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 173952,
      "title": "西湖二首  其一",
      "content": [
        "左符千里走东方，喜有西湖六月凉。",
        "塞上马归终反复，泰山鸱饱正飞扬。",
        "懒宜鱼鸟心常静，老觉诗书味更长。",
        "行到平桥初见日，满川风露紫荷香。"
      ],
      "author": {
        "id": 8104,
        "name": "曾巩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 173953,
      "title": "西湖二首  其二",
      "content": [
        "湖面平随苇岸长，碧天垂影入清光。",
        "一川风露荷花晓，六月蓬瀛燕坐凉。",
        "沧海桴浮成旷荡，明河槎上更微茫。",
        "何须辛苦求人外，自有仙乡在水乡。"
      ],
      "author": {
        "id": 8104,
        "name": "曾巩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 173954,
      "title": "早起赴行香",
      "content": [
        "枕前听尽小梅花，起见中庭月未斜。",
        "微破宿云犹度雁，欲深烟柳已藏鸦。",
        "井轳声急推寒玉，笼烛光繁秉绛纱。",
        "行到市桥人语密，马头依约对朝霞。"
      ],
      "author": {
        "id": 8104,
        "name": "曾巩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 173955,
      "title": "席上",
      "content": [
        "市井萧条烟火微，两衙散后雪深时。",
        "若无一曲传金盏，争奈衰翁两鬓丝。"
      ],
      "author": {
        "id": 8104,
        "name": "曾巩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 173956,
      "title": "和陈郎中",
      "content": [
        "材薄安时甘寂寞，身闲乘兴喜登临。",
        "每寻香草牵狂思，曾向幽兰费苦吟。",
        "明月几人非按剑，高山从古少知音。",
        "数篇清绝赓歌意，默见冯唐异俗心。"
      ],
      "author": {
        "id": 8104,
        "name": "曾巩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 173957,
      "title": "雪后",
      "content": [
        "雪景鲜妍犹弄色，柳条葱蒨已抽萌。",
        "风光苒苒流双毂，人事悠悠寄一枰。",
        "射羿未应今独有，嘲雄何必史能评。",
        "且将画诺供谈笑，更选名园载酒行。"
      ],
      "author": {
        "id": 8104,
        "name": "曾巩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 173958,
      "title": "舜泉",
      "content": [
        "山麓旧耕迷故垄，井干余汲见飞泉。",
        "清涵广陌能成雨，冷浸平湖别有天。",
        "南狩一时成往事，重华千古似当年。",
        "更应此水无休歇，余泽人间世世传。"
      ],
      "author": {
        "id": 8104,
        "name": "曾巩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 173959,
      "title": "阅武堂",
      "content": [
        "五朝坏冶归皇极，万里车书共太平。",
        "胡马不闚光禄塞，汉家常肄羽林兵。",
        "柳间自诧投壶乐，桑下方安佩犊行。",
        "高枕四封无一事，腐儒何幸偶专城。"
      ],
      "author": {
        "id": 8104,
        "name": "曾巩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 173960,
      "title": "环波亭",
      "content": [
        "水心还有拂云堆，日日应须把酒杯。",
        "杨柳巧含烟景合，芙蓉争带露华开。",
        "城头山色相围出，檐底波声四面来。",
        "谁信瀛洲未归去，两州俱得小蓬莱。"
      ],
      "author": {
        "id": 8104,
        "name": "曾巩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 173961,
      "title": "鹊山亭",
      "content": [
        "大亭孤起压城颠，屋角峨峨插紫烟。",
        "泺水飞绡来野岸，鹊山浮黛入晴天。",
        "少陵骚雅今谁和，东海风流世谩传。",
        "太守自吟还自笑，归来乘月尚留连。"
      ],
      "author": {
        "id": 8104,
        "name": "曾巩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 173962,
      "title": "芍药厅",
      "content": [
        "小碧阑干四月天，露红烟紫不胜妍。",
        "肯为云住阳台女，恐逐风飞饰室仙。",
        "洧外送归情放荡，省中番直势拘挛。",
        "何如萧洒山城守，浅酌清吟济水边。"
      ],
      "author": {
        "id": 8104,
        "name": "曾巩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 173963,
      "title": "水香亭",
      "content": [
        "临池飞构鬰岧峣，棂槛无风影自摇。",
        "群玉过林抽翠竹，双虹垂岸跨平桥。",
        "烦依美藻鱼争饵，清见寒沙水满桡。",
        "莫问荷花开几曲，但知行处异香飘。"
      ],
      "author": {
        "id": 8104,
        "name": "曾巩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 173964,
      "title": "静化堂",
      "content": [
        "修檐䡾䡾背成阴，行尽松篁一径深。",
        "好鸟自飞还自下，白云无事亦无心。",
        "客来但饮平阳酒，衙退常携靖节琴。",
        "世路人情方扰扰，一游须抵万黄金。"
      ],
      "author": {
        "id": 8104,
        "name": "曾巩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 173965,
      "title": "仁风厅",
      "content": [
        "凛凛风生寄此堂，尘埃消尽兴何长。",
        "朱丝鼓舞逢千载，白羽吹扬慰一方。",
        "已散浮云沧海上，更飞霖雨泰山傍。",
        "谁知万物心焦日，独对松筠四座凉。"
      ],
      "author": {
        "id": 8104,
        "name": "曾巩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 173966,
      "title": "阅武堂下新渠",
      "content": [
        "方渠新凿北林开，流水遥经画阁来。",
        "洗耳厌闻夸势利，濯缨羞去傍尘埃。",
        "不忧待月干诗笔，已欲看华泛酒杯。",
        "却忆虎溪桥上过，夜凉临砌尚徘徊。"
      ],
      "author": {
        "id": 8104,
        "name": "曾巩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 173967,
      "title": "凝香斋",
      "content": [
        "每觉西斋景最幽，不知官是古诸侯。",
        "一尊风月身无事，千里耕桑岁有秋。",
        "云水醒心鸣好鸟，玉沙清耳漱寒流。",
        "沉烟细细临黄卷，疑在香炉最上头。"
      ],
      "author": {
        "id": 8104,
        "name": "曾巩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 173968,
      "title": "北渚亭",
      "content": [
        "四楹虚彻地无邻，断送孤高与使君。",
        "午夜坐临沧海日，半天吟看泰山云。",
        "青徐气接川原秀，常碣风连草木薰。",
        "莫笑一樽留恋久，下阶尘土便纷纷。"
      ],
      "author": {
        "id": 8104,
        "name": "曾巩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 173969,
      "title": "芙蓉桥",
      "content": [
        "雁翅横连杜若洲，碧阑干影在中流。",
        "蓬莱日日游人到，谁道仙风解引舟。"
      ],
      "author": {
        "id": 8104,
        "name": "曾巩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 173970,
      "title": "百花台",
      "content": [
        "烟波与客同樽酒，风月全家上采舟。",
        "莫问台前花远近，试看何似武陵游。"
      ],
      "author": {
        "id": 8104,
        "name": "曾巩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 173971,
      "title": "次道子中书问归期",
      "content": [
        "窃食东州岁未期，蓬莱人问几时归。",
        "凭阑到处临清泚，开阁终朝对翠微。",
        "两印每闲军市静，双旌多偃送迎稀。",
        "一枝数粒身安稳，不羡云鹏九万飞。"
      ],
      "author": {
        "id": 8104,
        "name": "曾巩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 173972,
      "title": "霿凇",
      "content": [
        "园林初日静无风，霿凇花开处处同。",
        "记得集英深殿里，舞人齐插玉笼𩭤。"
      ],
      "author": {
        "id": 8104,
        "name": "曾巩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 173973,
      "title": "正月六日雪霁",
      "content": [
        "雪消山水见精神，满眼东风送早春。",
        "明日杏园应烂熳，便须期约看花人。"
      ],
      "author": {
        "id": 8104,
        "name": "曾巩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 173974,
      "title": "寄顾子敦",
      "content": [
        "清旷亭边雁欲回，南湖分浪入城来。",
        "空山过腊犹藏雪，野岸先春已放梅。",
        "三径未归聊自适，一尊寻胜每同开。",
        "如今试想长松下，玉麈高谈岂易陪。"
      ],
      "author": {
        "id": 8104,
        "name": "曾巩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 173975,
      "title": "二月八日北城闲步",
      "content": [
        "土膏初动麦苗青，饱食城头信意行。",
        "便起高亭临北渚，欲乘长日劝春耕。"
      ],
      "author": {
        "id": 8104,
        "name": "曾巩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 173976,
      "title": "咏柳",
      "content": [
        "乱条犹未变初黄，倚得东风势便狂。",
        "解把飞花蒙日月，不知天地有清霜。"
      ],
      "author": {
        "id": 8104,
        "name": "曾巩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 173977,
      "title": "北园会客不饮",
      "content": [
        "画桥南北水西东，高下花枝绿间红。",
        "𣨼得春风人尽醉，独醒谁似白头翁。"
      ],
      "author": {
        "id": 8104,
        "name": "曾巩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 173978,
      "title": "西湖纳凉",
      "content": [
        "问吾何处避炎蒸，十顷西湖照眼明。",
        "鱼戏一篙新浪满，鸟啼千步绿阴成。",
        "虹腰隠隠松桥出，鹢首峨峨画舫行。",
        "最喜晚凉风月好，紫荷香里听泉声。"
      ],
      "author": {
        "id": 8104,
        "name": "曾巩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 173979,
      "title": "喜雨",
      "content": [
        "偶徇一官偷禄计，便怀千里长人忧。",
        "桑间举箔蚕初茧，陇上挥镰麦已秋。",
        "更喜风雷生北极，顿驱云雨出灵湫。",
        "从今菽粟非虚祷，会见瓯窭果满篝。"
      ],
      "author": {
        "id": 8104,
        "name": "曾巩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 173980,
      "title": "雨后环波亭次韵 次李秀才得鱼字韵",
      "content": [
        "候月已知星好雨，卜年方喜梦维鱼。",
        "从今拨置庭中事，最喜西轩睡枕书。"
      ],
      "author": {
        "id": 8104,
        "name": "曾巩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 173981,
      "title": "雨后环波亭次韵 次绾得风字韵",
      "content": [
        "荷芰东西鱼映叶，樵舟朝暮客乘风。",
        "清泉雨后分毛发，何必南湖是镜中。"
      ],
      "author": {
        "id": 8104,
        "name": "曾巩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 173982,
      "title": "雨后环波亭次韵 次维得禽字韵",
      "content": [
        "黄蜀葵开收宿雨，紫桑椹熟啭新禽。",
        "看花弄水非无事，犹胜纷纷别用心。"
      ],
      "author": {
        "id": 8104,
        "name": "曾巩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 173983,
      "title": "雨后环波亭次韵 次综得花字韵",
      "content": [
        "丹杏一番收美实，绿荷无数放新花。",
        "西湖雨后清心目，坐到城头泊暝鸦。"
      ],
      "author": {
        "id": 8104,
        "name": "曾巩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 173984,
      "title": "去年久旱六月十三日入境得雨今年复旱得雨亦六月十三日也",
      "content": [
        "去年六月焦原雨，入得东州第一朝。",
        "今日看云旧时节，又来农畔听萧萧。"
      ],
      "author": {
        "id": 8104,
        "name": "曾巩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 173985,
      "title": "到郡一年",
      "content": [
        "薄材何幸拥朱轩，窃食东州已一年。",
        "陇上雨余看麦秀，桑间日永问蚕眠。",
        "官名虽冗身无累，心事长闲地自偏。",
        "祇恐再期官满去，每来湖岸合留连。"
      ],
      "author": {
        "id": 8104,
        "name": "曾巩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 173986,
      "title": "孔教授张法曹以曾论荐特示长笺",
      "content": [
        "绿发朱颜两少年，出伦清誉每相先。",
        "壁中字为时人考，圯上书从老父传。",
        "泮水笑谈邀法饮，高斋闲燕属佳篇。",
        "衰翁厚幸怀双璧，更起狂心慕荐贤。"
      ],
      "author": {
        "id": 8104,
        "name": "曾巩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 173987,
      "title": "酬强几圣",
      "content": [
        "俯仰林泉绕舍清，经年闲卧济南城。",
        "山田雨足心无事，水榭华开眼更明。",
        "新霁烟云飞观出，晚凉歌吹画桥横。",
        "寄声裴令樽前客，祇欠高谈一座倾。"
      ],
      "author": {
        "id": 8104,
        "name": "曾巩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    }
  ],
