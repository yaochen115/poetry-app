{
  "data": [
    {
      "id": 156040,
      "title": "游集灵观",
      "content": [
        "小洞烟霞国，重阳风雨秋。",
        "欧公嵩岳步，朱子武夷舟。",
        "香火真吾职，觥筹且此游。",
        "龙山马台事，糠粃旧王侯。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 156041,
      "title": "题凝祥观",
      "content": [
        "前路风尘走且僵，我来一日此徜徉。",
        "欧公自是游嵩观，迂叟原非过太行。",
        "始信神仙还有国，不知蛮触是何乡。",
        "世间如此纷纷者，赢得山林作道场。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 156042,
      "title": "游青源二首  其一",
      "content": [
        "钟鱼闲日月，竹树老风烟。",
        "一径溪声满，四山天影圆。",
        "无言都是趣，有想便成缘。",
        "梦破啼猿雨，开元六百年。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 156043,
      "title": "游青源二首  其二",
      "content": [
        "空庭横䗖蝀，断碣偃龙蛇。",
        "活火参禅笋，真泉透佛茶。",
        "晚钟何处雨，春水满城花。",
        "夜影灯前客，江西七祖家。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 156044,
      "title": "题碧落堂",
      "content": [
        "大厦新成燕雀欢，与君聊此共清闲。",
        "地居一郡楼台上，人在半空烟雨间。",
        "修复尽还今宇宙，感伤犹记旧江山。",
        "近来又报秋风紧，颇觉忧时鬓欲斑。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 156045,
      "title": "和龚使君韵",
      "content": [
        "淡和心事葛天民，回首归来清渭滨。",
        "长倩君宾孙子行，道原义仲辈流人。",
        "一生受用忘非是，万事升沉等故新。",
        "近日贞元朝士少，蒲轮有命出枫宸。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 156046,
      "title": "饯新班弟",
      "content": [
        "送君天上去，当户理瑶琴。",
        "万里白鸥远，千山黄叶深。",
        "江空行路影，日暮倚门心。",
        "若见西湖雪，霸桥人正吟。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 156047,
      "title": "别弟赴新昌",
      "content": [
        "十载从游久，诸公讲切精。",
        "天渊分理欲，内外一知行。",
        "立政须规范，修身是法程。",
        "对床小疏隔，恋恋弟兄情。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 156048,
      "title": "和韵送逸轩刘民章",
      "content": [
        "少日屠龙事已劳，送人千里发江涛。",
        "蓬莱地近风方细，阊阖门开日正高。",
        "春里看花须款款，雨中剪韭且陶陶。",
        "金吾已办长安月，双凤扶云立海鳌。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 156049,
      "title": "题宣州叠嶂楼",
      "content": [
        "初日照高楼，轻烟在疏树。",
        "峨峨远岫出，泯泯清江去。",
        "簷隙委残籀，屋隅连宿莽。",
        "荟蔚互低昂，熹微分散聚。",
        "城郭谅非昔，山川俨如故。",
        "童鬒已零落，姝颜慰迟莫。",
        "沈沈澹忘归，欲归重回顾。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 156050,
      "title": "题宣州推官厅览翠堂",
      "content": [
        "都官自楚产，文采光陆离。",
        "当年从事君，如与山川期。",
        "岁月忽巳遒，天球落尘土。",
        "岂曰无嘉宾，过者不我顾。",
        "谁令赤城子，发坎出方珉。",
        "灵物必复见，其见乃以人。",
        "回视城南端，飞甍俯苍蒨。",
        "物理有屈伸，流峙岂云变。",
        "寥寥南楼月，至今有遐音。",
        "千年一邂逅，共调风中琴。",
        "亦欲结方轨，揽茝事幽寻。",
        "行行且言迈，踟蹰思何深。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 156051,
      "title": "登双溪阁",
      "content": [
        "碧落神仙宅，当年庾谢来。",
        "烟云连草树，山水近楼台。",
        "万雉银缸举，千鸦铁骑回。",
        "梅花衣上月，把玩为徘徊。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 156052,
      "title": "题吴城山",
      "content": [
        "龙行人鬼外，神在地天间。",
        "彭蠡石砮出，洞庭商舶还。",
        "秋风黄鹄阔，春雨白鸥闲。",
        "云际青如粟，河流接海山。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 156053,
      "title": "贫女吟四首  其一",
      "content": [
        "柴门寒自闭，不识赏花心。",
        "春笋翠如玉，为人拈绣针。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 156054,
      "title": "贫女吟四首  其二",
      "content": [
        "竹扇掩红颜，辛苦纫白苎。",
        "人间罗雪香，白苎汗如雨。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 156055,
      "title": "贫女吟四首  其三",
      "content": [
        "西风两鬓松，凉意吹伶俜。",
        "百巧不救贫，误拜织女星。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 156056,
      "title": "贫女吟四首  其四",
      "content": [
        "巧梳手欲冰，小颦为寒怯。",
        "有时衿肘露，颇与雪争洁。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 156057,
      "title": "名姝吟",
      "content": [
        "丈夫至白首，钟鼎垂功名。",
        "未有朱门中，而无丝竹声。",
        "与主共富贵，不见主苦辛。",
        "名姝从何来，婉娈出神京。",
        "京人薄生男，生女即不贫。",
        "东家从王侯，西家事公卿。",
        "吾行天下多，朱紫稀晨星。",
        "大都不一一，甚者旷数城。",
        "如何世上福，冉冉归娉婷。",
        "乃知长安市，家家生贵人。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 156058,
      "title": "东方有一士",
      "content": [
        "万金结游侠，千金买歌舞。",
        "丹青映第宅，从者塞衢路。",
        "身为他人役，名声落尘土。",
        "他人一何伤，富贵还自苦。",
        "东方有一士，败垣半风雨。",
        "不识丝与竹，飞雀满庭户。",
        "一饭或不饱，夜梦无惊寤。",
        "此事古来多，难与俗人语。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 156059,
      "title": "和故人韵  其一",
      "content": [
        "去岁湟中谷，医疮咸粜新。",
        "一言堪救药，三秩敢贪嗔。",
        "自是仁由己，休论哲保身。",
        "当时若瘖默，何面见乡人。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 156060,
      "title": "和故人韵  其二",
      "content": [
        "人情嗟愈变，世法合何如。",
        "气以心平定，才因意广疏。",
        "时行或时止，无咎亦无誉。",
        "第一严交际，琴绅敢不书。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 156061,
      "title": "赋吉州隆庆寺塔火",
      "content": [
        "玉塔穿空不可梯，剨然霹雳暗招提。",
        "四城决破吴胥眼，一炷然成汉卓脐。",
        "风雨满山连地卷，鬼神现世觉天低。",
        "时人子细回头看，万事悠悠落日西。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 156062,
      "title": "寄故人刘方斋",
      "content": [
        "溪头浊潦拥鱼虾，笑杀渔翁下钓差。",
        "棹取扁舟湖海去，悠悠心事寄芦花。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 156063,
      "title": "题高君宝绀泉",
      "content": [
        "渟渟岩下泓，澄碧落梧影。",
        "寒瑶披清飙，残月照濎濙。",
        "俯渊测浮云，流日荡苕颖。",
        "向来沧浪歌，孺子不可诇。",
        "载霑衣上尘，怀古意深永。",
        "招招素心人，相期发深省。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 156064,
      "title": "题曾氏连理木",
      "content": [
        "皇后嘉树生僪佹，四衢五衢合一轨。",
        "德泽纯洽八方一，乘木而王固如此。",
        "大明香琴橘，贞观玉华李。",
        "一时图传传奇观，荣华过眼转九易。",
        "惟有武城宅前树，不知何年已连理。",
        "从来县官不以闻，武城子孙世专美。",
        "人言协气薰嘉生，此家孝友陶协气。",
        "朱门多少锁乔木，百年瞬息滋一喟。",
        "焉得鼎鼎为轮囷，受命不迁相曾氏。",
        "传闻此木更八世，方遇麻阳大夫记。",
        "麻阳又几年，却入青螺地舆志。",
        "比来彻当路，表名连瑞里。",
        "有日捧图上，嘉禾灵草共青史。",
        "物生隠显殆有时，展如之人亦应尔。",
        "楩楠杞梓离奇生继此，庐陵城北不止称三瑞。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 156065,
      "title": "题滕王阁",
      "content": [
        "五云窗户瞰沧浪，犹带唐人翰墨香。",
        "日月四时黄道阔，江山一片画图长。",
        "回风何处抟双雁，冻雨谁人驾独航。",
        "回首十年此漂泊，阁前新柳已成行。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 156066,
      "title": "题黄冈寺次吴履斋韵",
      "content": [
        "长江几千里，万折必归东。",
        "南浦惊新雁，庐山隔晚风。",
        "人行荒树外，秋在断芜中。",
        "何日洗兵马，车书四海同。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 156067,
      "title": "龙雾洲觉海寺次李文溪壁间韵",
      "content": [
        "阇黎钟后访团蒲，江色漫漫昼欲晡。",
        "一笛梅边何满子，千蓑芦外笔头奴。",
        "急风吹雁还家未，新雨生涛到海无。",
        "本是白鸥随浩荡，野田漂泊不为孤。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 156068,
      "title": "题钟圣举积学斋",
      "content": [
        "东家筑黄金，西家列珊瑚。",
        "叹此草露晞，良时聊斯须。",
        "古人重孜孜，殖学乃菑畬。",
        "彼美不琢雕，椟中竟何如。",
        "空同白云深，君子式其庐。",
        "棐几照初阳，垂签动凉嘘。",
        "方寸起岑楼，一勺生龙鱼。",
        "辰乎曷来迟，竞诸复竞诸。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 156069,
      "title": "题颜景彝八窗玲珑  其一",
      "content": [
        "我闼无纤埃，风日自清好。",
        "面面有芙蓉，何如交翠草。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 156070,
      "title": "题颜景彝八窗玲珑  其二",
      "content": [
        "吾闻开十牖，不及一户明。",
        "泰宇有天光，八荒尽夷庚。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 156071,
      "title": "予邓峒□巽斋欧阳先生为淦邓峒赋诗以孝子慈孙望于人先生之盛心也敢不拜手敬赞邓君勉之",
      "content": [
        "乃翁犹旅殡，霜露几焄蒿。",
        "日与清江游，云连桂岭高。",
        "时无郭元振，梦有令狐绹。",
        "目断方田墓，招魂我欲骚。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 156072,
      "title": "题陈正献公六梅亭",
      "content": [
        "相府亭前梅六株，四围香影护琴书。",
        "月华犹带玉堂色，风味曾分金鼎余。",
        "五柳门前空寂寞，三槐堂上竟萧疏。",
        "惟渠不变凌霜操，千古风标只自如。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 156073,
      "title": "文山即事",
      "content": [
        "宇宙风烟阔，山林日月长。",
        "开滩通燕尾，伐石割羊肠。",
        "盘谷堪居李，庐山偶姓康。",
        "知名总闲事，一醉棹沧浪。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 156074,
      "title": "出山",
      "content": [
        "日日骑马来山中，归时明月长在地。",
        "但愿山人一百年，一年三百余番醉。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 156075,
      "title": "辟山寄朱约山",
      "content": [
        "一笠一蓑三钓矶，归来不费买山赀。",
        "洞天福地深数里，石壁湍流清四时。",
        "樵牧旧蹊今可马，鬼神天巧不容诗。",
        "先生曾有空同约，那里江山未是奇。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 156076,
      "title": "山中即事",
      "content": [
        "携壶藉草醉斜阳，白鹤飞来月下双。",
        "芦叶西风惊别浦，芭蕉夜雨隔疏窗。",
        "千年帝子朱帘梦，一曲仙人铁笛腔。",
        "若问山翁还瘦否，手持渔竹下寒江。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 156077,
      "title": "宿山中用前韵",
      "content": [
        "南山之隩北山阳，羽扇轻风共影双。",
        "画桨菰蒲明月笛，青灯蟋蟀白云窗。",
        "半生游子成行债，一夜佳人作别腔。",
        "倚钓重来此蓑笠，梅花十里雪空江。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 156078,
      "title": "山中",
      "content": [
        "沧洲棹影荻花凉，欵乃一声江水长。",
        "頼有莼风堪斫脍，便无花月亦飞觞。",
        "山中世已惊东晋，席上人多赋晚唐。",
        "何处鱼羹不可饭，蚤拚泉石入膏肓。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 156079,
      "title": "山中谩成柬刘方斋",
      "content": [
        "东风解冻出行嬉，一哄烟尘隔翠微。",
        "自有溪山真乐地，从来富贵是危机。",
        "二三辈行惟须醉，多少公卿未得归。",
        "明日主人酬一座，小船旋网鳜鱼肥。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 156080,
      "title": "山中载酒用萧敬夫韵赋江涨",
      "content": [
        "拍拍春风满面浮，出门一笑大江流。",
        "坐中狂客有醉白，物外闲人惟弈秋。",
        "晴抹雨粧总西子，日开云暝一滁州。",
        "忽传十万军声至，如在浙江亭上游。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 156081,
      "title": "山中立夏用坐客韵",
      "content": [
        "归来泉石国，日月共溪翁。",
        "夏气重渊底，春光万象中。",
        "穷吟到云黑，淡饮胜裙红。",
        "一阵弦声好，人间解愠风。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 156082,
      "title": "山中和韵",
      "content": [
        "白扇挥残暑，青鞋踏嫩晴。",
        "花床寻小隠，石鼎引长鸣。",
        "纱帽有时去，酒壶惟意倾。",
        "山僧痴与坐，闲却瘦弥明。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 156083,
      "title": "山中自赋",
      "content": [
        "□□□□□□□，门外苍松一水修。",
        "不必清高逼巢许，祇教潇洒胜由求。",
        "空花自满三千界，老树相看五百秋。",
        "坐有鹰扬人物在，怕牵昨梦上渔舟。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 156084,
      "title": "入山即事",
      "content": [
        "江流风㶁㶁，云薄雨丝丝。",
        "上马忙呼繖，巡簷静看棋。",
        "露天厨作泞，沙地水生池。",
        "秉烛留前夕，兹游更绝奇。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 156085,
      "title": "山中感兴三首  其一",
      "content": [
        "载酒之东郊，东郊草新绿。",
        "一雨生江波，洲渚失其足。",
        "青春岂不惜，行乐非所欲。",
        "采芝复采芝，终朝不盈掬。",
        "大风从何来，奇响振空谷。",
        "我马何玄黄，息我西山麓。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 156086,
      "title": "山中感兴三首  其二",
      "content": [
        "山中有流水，霜降石自出。",
        "骤雨东南来，消长不终日。",
        "故人书问至，为言北风急。",
        "山深人不知，塞马谁得失。",
        "挑灯看古史，感泪纵横发。",
        "幸生圣明时，渔樵以自适。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 156087,
      "title": "山中感兴三首  其三",
      "content": [
        "桃花何夭夭，杨柳何依依。",
        "去年白鸟集，今年黄鹄飞。",
        "昔为江上潮，今为山中云。",
        "江上潮有声，山中云无情。",
        "一年足自念，况复百年长。",
        "但存松柏心，天地真茫茫。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 156088,
      "title": "山中呈聂心远诸客  其一",
      "content": [
        "谁入山来问野舟，一篙花外渡深流。",
        "小颦风树蹁跹鹤，浅约湍沙浩荡鸥。",
        "湖上有时思洛社，人间何处不滁州。",
        "徘徊才是黄昏候，短笛先催月上楼。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 156089,
      "title": "山中呈聂心远诸客  其二",
      "content": [
        "黄叶婆娑上钓舟，唤回旧梦到江流。",
        "多情政自怜樯燕，两鬓终当付野鸥。",
        "未说离怀向南浦，须知诗意在夔州。",
        "朔风昨夜吹沙急，早觉寒声战玉楼。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 156090,
      "title": "山中六言三首  其一",
      "content": [
        "两两渔舟摇下，双双紫燕飞回。",
        "流水白云芳草，清风明月苍苔。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 156091,
      "title": "山中六言三首  其二",
      "content": [
        "鹤外竹声簌簌，座边松影疏疏。",
        "夜静不收棋局，日高犹卧纱厨。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 156092,
      "title": "山中六言三首  其三",
      "content": [
        "风煖江鸿海燕，雨晴簷鹊林鸠。",
        "一段青山颜色，不随江水俱流。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 156093,
      "title": "用萧敬夫韵",
      "content": [
        "庭院芭蕉碎绿阴，高山一曲寄瑶琴。",
        "西风游子万山影，明月故乡千里心。",
        "江上断鸿随我老，天涯芳草为谁深。",
        "雪中若作梅花梦，约莫孤山人姓林。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 156094,
      "title": "山中  其一",
      "content": [
        "烟云开窈缈，荆棘剪离披。",
        "蜡屐上下齿，竹枝长短词。",
        "半山江色透，独树午阴迟。",
        "世上儿孙老，有人犹看棋。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 156095,
      "title": "山中  其二",
      "content": [
        "倏忽当年遇，蒙茸几度披。",
        "水霞明画卷，草树幻骚词。",
        "鸟过目不瞬，江流意自迟。",
        "世人空黑白，一色看坡棋。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 156096,
      "title": "竹花",
      "content": [
        "黄家紫家鬭魏姚，夷齐玉立青萧萧。",
        "便是人间小天地，不特水上作萍漂。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 156097,
      "title": "夜归",
      "content": [
        "市桥灯火未阑珊，一簇人家树影间。",
        "想把神仙争羡我，不知我正羡渠闲。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 156098,
      "title": "八月十六日见梅",
      "content": [
        "广寒殿里玉楼开，那得孤山处士来。",
        "半夜西风半身影，梦中骑得雪馿回。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 156099,
      "title": "和萧秋屋韵",
      "content": [
        "芦花作雪照波流，黄叶声中一半秋。",
        "明月婵娟千里梦，扁舟汗漫五湖游。",
        "星辰活动惊歌笑，风露轻寒敌拍浮。",
        "赢得年年清赏处，山河全影入金瓯。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 156100,
      "title": "月夜",
      "content": [
        "月到中天云划开，断桥幻出玉楼台。",
        "夜深一鹤掠舟过，疑是坡仙赤壁来。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 156101,
      "title": "江行",
      "content": [
        "日日看山好，山山山色苍。",
        "忘机鸥下早，恋厩马行忙。",
        "松晓清风湿，荷秋流水香。",
        "短蓑吹铁笛，年岁大江长。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 156102,
      "title": "纸帐",
      "content": [
        "纸帐白如雪，上有坐客影。",
        "一白不自由，黑光荡无定。",
        "人倦影已散，依然雪花莹。",
        "须臾秉烛眠，相忘心目静。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 156103,
      "title": "为刘定伯索油蕨",
      "content": [
        "我欲登山去采薇，江南秋雨正霏霏。",
        "仙家解有逡巡手，一筯西风落翠微。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 156104,
      "title": "山中小集",
      "content": [
        "江山闲胜赏，万户不须留。",
        "客醉客多事，吾诗吾自酬。",
        "夕风吹绛蜡，春色漾黄流。",
        "宾从归来夜，滁翁无此游。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 156105,
      "title": "新年",
      "content": [
        "梅花枕上听司晨，起绾金章候拜亲。",
        "喜对慈颜看铺鬓，发虽疏脱未如银。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 156106,
      "title": "生日和聂吉甫",
      "content": [
        "青蒲花未老，黄竹笋初生。",
        "细味诗工部，闲评字率更。",
        "大江流日影，时鸟说春荣。",
        "共作千年计，身谋政自轻。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 156107,
      "title": "生日和谢爱山长句",
      "content": [
        "寓形落落大块间，嘘吸一气自往还。",
        "桑弧未了男子事，何能局促甘囚山。",
        "昔年此日作初度，宾客如云剧欢舞。",
        "今年避影却闭门，捧觞自寿白头母。",
        "故人忆我能远来，虹光满袖生琼瑰。",
        "一杯相属慰岑寂，使我发笑愁颜开。",
        "簸扬且听箕张口，丈夫壮气须冲斗。",
        "夜阑拂剑碧光寒，握手相期出云表。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 156108,
      "title": "生日谢朱约山和来韵",
      "content": [
        "元丰五年正月日，洛中耆英佳话出。",
        "当时韩公七十九，欢噱赓酬老吟笔。",
        "伟然冠剑照孔鸾，鲐背鸠杖蒲轮安。",
        "韩公而下文宽夫，相高以寿不以官。",
        "洛尘已随流水急，云仍相逢松下石。",
        "顾我行辈真我来，兼謩故事强安排。",
        "约对青山共长久，醉歌要赛滁州守。",
        "愿随后社著深衣，阑风伏雨从是非。",
        "便令携樽西墅去，山花山鸟为歌舞。",
        "招招瑶母来庭闱，拍手共笑偷桃儿。",
        "吾山陂陀白云满，猿鹤司我北门管。",
        "紫霞隔断鸡犬声，下有琥珀滋长龄。",
        "向来福地七十二，此亦清高仙地位。",
        "朝游昆仑暮崆峒，驾风鞭霆迎我公。",
        "丹崖翠壁千万丈，与公上上上上上。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 156109,
      "title": "生日山中和萧敬夫韵",
      "content": [
        "山深不用结凉棚，风起江苹暑气轻。",
        "处士林泉自今古，男儿弧矢付豪英。",
        "客来不必笼中羽，我爱无如橘里枰。",
        "一任苍松栽十里，他年犹见茯苓生。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 156110,
      "title": "与朱古平饮山中和萧敬夫韵",
      "content": [
        "江山自足引千杯，况有如今此客哉。",
        "石室只还湖守住，芦峰曾屈晦翁来。",
        "酒酣剩有诗酬唱，步倦何妨车马回。",
        "游徧此山方可别，北崖莫遣晓云开。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 156111,
      "title": "所怀",
      "content": [
        "英英香蕙莹朝华，收拾东风作一家。",
        "燕语鶑啼春又夏，灯花剔尽暗窗斜。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 156112,
      "title": "山中偶成",
      "content": [
        "白鹤飞来牵我衣，东风吹我下渔矶。",
        "当年祇为青山误，直草君王一诏归。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 156113,
      "title": "次约山赋杏花韵",
      "content": [
        "名花韵在午晴初，雨沁臙脂脸更敷。",
        "蒲驿莫妨娱刺史，锦坊岂不胜中书。",
        "时无艳曲临轩纵，公莫巍坛韫匮沽。",
        "春老绿阴青子近，东风来往一吹嘘。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 156114,
      "title": "赠南安黄梅峰",
      "content": [
        "清浅风流圣得知，黄昏归鹤月来时。",
        "岭头更有高寒处，却是江南第一枝。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 156115,
      "title": "送人往湖南",
      "content": [
        "雁拖秋月洞庭边，客路凄凉野菊天。",
        "云隔酒尊横北海，风吹诗史落西川。",
        "夜深鬼火千山雪，春后鹃花一树烟。",
        "为我祝融峰上看，朝暾白处礼蓬仙。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 156116,
      "title": "题张景召簿尉梅墅并饯入南",
      "content": [
        "唤醒三影燕支魂，一枝半树专黄昏。",
        "江南暗香鬰不住，霜风吹入罗浮村。",
        "疏枝不入辋川画，暗香不到东山棋。",
        "云阶一枕梨花梦，参横月落无人知。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 156117,
      "title": "和谢爱山晚吟韵日晚与客散步因诵夕阳虽好不多时之句谢爱山欣然赋之余亦率然口占以和亦一时之乐也",
      "content": [
        "日落未落天沧凉，悬崖挂壁留余光。",
        "紫烟翠雾空迷茫，飕飕度壑松风长。",
        "牛背短笛催归忙，飘飘逸兴空悠扬。",
        "襟怀洒落万虑亡，须臾薄暝山色藏。",
        "长歌浩浩相激昂，淡云弄月微昏黄。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 156118,
      "title": "别谢爱山  其一",
      "content": [
        "绿绮知音早，青灯对语迟。",
        "那知今雨别，又重故人思。",
        "山隔诗情远，云含客思悲。",
        "小楼今夜笛，莫向月中吹。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 156119,
      "title": "别谢爱山  其二",
      "content": [
        "君今拂衣去，我独枕书眠。",
        "一片过林雨，数声当户蝉。",
        "情长空有恨，吟苦不成篇。",
        "后会知何日，西风老雁天。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 156120,
      "title": "和胡琴窗",
      "content": [
        "买得青山贵似金，瘦筇上下费沉吟。",
        "花开花落相关意，云去云来自在心。",
        "夜雨一江渔唱小，秋风两袖客愁深。",
        "夹堤密与栽杨柳，剩有行人待绿阴。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 156121,
      "title": "七月十三夜用灯牌字韵凑成一诗与诸宾一笑",
      "content": [
        "赤壁当年赋子虚，西风忽复到菰蒲。",
        "蟾蜍影里千秋鉴，蟋蟀声中七月图。",
        "诗思飘飘入云汉，歌声隠隠动江湖。",
        "万家箫鼓连灯火，见说来年此事无。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 156122,
      "title": "病中作",
      "content": [
        "岁月侵寻见二毛，剑花冷落䴙鹈膏。",
        "睡余吸海龙身瘦，渴里奔云马骨高。",
        "百忌不容亲酒具，千愁那解减诗豪。",
        "起来大作屠门嚼，自笑我非儿女曹。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 156123,
      "title": "又二绝  其一",
      "content": [
        "瞿塘隘处真重险，勾漏坡前又一滩。",
        "世事不容轻易看，翻云覆雨等闲间。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 156124,
      "title": "又二绝  其二",
      "content": [
        "病中忽悮通真理，静处专寻入定工。",
        "雨汗淋头都不管，须臾和气自冲融。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 156125,
      "title": "又赋  其一",
      "content": [
        "一病忽两月，蓬头夏涉秋。",
        "形羸心自壮，手弱笔仍遒。",
        "昨夜灯如喜，今宵蝶莫愁。",
        "问谁驱五疟，正与五穷谋。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 156126,
      "title": "又赋  其二",
      "content": [
        "一病四十日，西风草木凉。",
        "倚床腰见骨，览镜眼留眶。",
        "倦策吟诗杖，频烧读易香。",
        "夜深排果饵，乞巧大医王。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 156127,
      "title": "又赋  其三",
      "content": [
        "病里心如故，闲中事更生。",
        "睡猫随我懒，黠鼠向人鸣。",
        "羽扇看棋坐，黄冠扶杖行。",
        "灯前翻自喜，瘦得此诗清。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 156128,
      "title": "又赋  其四",
      "content": [
        "骤雨知何处，一溪秋水生。",
        "苦吟肩鹤瘦，多病耳蝉鸣。",
        "隠几惟便睡，挑包正倦行。",
        "山深明月夜，乞我半窗清。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 156129,
      "title": "又赋  其五",
      "content": [
        "寄兴逃吾病，吟诗老此生。",
        "风高鸿雁起，晴久鹁鸠鸣。",
        "野树辞秋落，溪云带雨行。",
        "晚凉便懒坐，移傍竹阴清。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 156130,
      "title": "借道冠有赋",
      "content": [
        "病中萧散服黄冠，笑倒群儿指为弹。",
        "秘监贺君曾道士，翰林苏子亦祠官。",
        "酒壶钓具有时乐，茶灶笔床随处安。",
        "幸有山阴深密处，他年炼就九还丹。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 156131,
      "title": "又赋",
      "content": [
        "一番潮信过，时暂脱熬煎。",
        "心似辘轳转，身如徽纆缠。",
        "夜听饥鼠啸，昼看伏雌眠。",
        "急雨千山动，应知为解弦。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 156132,
      "title": "病甚梦召至帝所获宥觉而顿愈遂赋",
      "content": [
        "卧听风雷叱，天官赦小臣。",
        "平生无害物，不死复为人。",
        "道德门庭远，君亲念虑新。",
        "自怜蝼蚁辈，岂意动苍旻。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 156133,
      "title": "病愈简刘小村  其一",
      "content": [
        "秋光沁人骨，意气晓来新。",
        "古鼎龙团雪，虚簷麈尾春。",
        "商山弈棋老，赤壁洞箫宾。",
        "风月真仓扁，招呼入屋频。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 156134,
      "title": "病愈简刘小村  其二",
      "content": [
        "倦余心似醉，病起首如蓬。",
        "黄竹断桥雨，白苹长笛风。",
        "仙仙鸥屡舞，咄咄雁书空。",
        "孤负秋来眼，闲挑爨下桐。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 156135,
      "title": "夜坐偶成",
      "content": [
        "萧萧秋夜凉，明月入我户。",
        "揽衣起中庭，仰见牛与女。",
        "坐久寒露下，悲风动纨素。",
        "不遇王子乔，此意谁与语。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 156136,
      "title": "简琴窗云屋竹轩诸友",
      "content": [
        "世情千万变，险甚剑头炊。",
        "嗜传姑成癖，登山且作痴。",
        "烟霞非疾痼，泉石自心驰。",
        "独喜精神健，山中剩有诗。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 156137,
      "title": "用前韵留琴窗",
      "content": [
        "百年矛上淅，万事枕中炊。",
        "病苦还思老，贪嗔未若痴。",
        "云低天欲动，江长岸如驰。",
        "明月西风健，山头赋别诗。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 156138,
      "title": "又用韵简李深之",
      "content": [
        "晚尊和月吸，早饭带星炊。",
        "鹏鷃从高下，螳蝉任黠痴。",
        "水澄神自止，云远意俱驰。",
        "门外谁车马，故人来课诗。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 156139,
      "title": "早起偶成  其一",
      "content": [
        "澹澹池光曙，沉沉野色秋。",
        "片云生北舍，只雁过南楼。",
        "有见皆成趣，无言总是愁。",
        "芭蕉夜来水，咽罢自搔头。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
