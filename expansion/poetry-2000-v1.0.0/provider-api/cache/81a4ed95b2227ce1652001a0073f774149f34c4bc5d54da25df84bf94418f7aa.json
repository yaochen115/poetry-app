{
  "data": [
    {
      "id": 265529,
      "title": "三阁辞四首 三",
      "content": [
        "沉香帖阁柱，金缕画门楣。",
        "回首降旛下，已见黍[离]离。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 265530,
      "title": "三阁辞四首 四",
      "content": [
        "三人出眢井，一身登槛车。",
        "朱门漫临水，不可见鲈鱼。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 265531,
      "title": "纥那曲二首 一",
      "content": [
        "杨柳郁青青，竹枝无限情。",
        "周郎一回顾，听唱纥那声。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 265532,
      "title": "纥那曲二首 二",
      "content": [
        "踏曲兴无穷，调同词不同。",
        "愿郎千万寿，长作主人翁。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 265533,
      "title": "淮阴行五首 一",
      "content": [
        "簇簇淮阴市，竹楼缘岸上。",
        "好日起樯竿，乌飞惊五两。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 265534,
      "title": "淮阴行五首 二",
      "content": [
        "今日转船头，金乌指西北。",
        "烟波与春草，千里同一色。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 265535,
      "title": "淮阴行五首 三",
      "content": [
        "船头大铜镮，摩挲光阵阵。",
        "早早使风来，沙头一眼认。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 265536,
      "title": "淮阴行五首 四",
      "content": [
        "何物令侬羡，羡郎船尾燕。",
        "衔泥趂樯竿，宿食长相见。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 265537,
      "title": "淮阴行五首 五",
      "content": [
        "隔浦望行船，头昂尾幰幰。",
        "无奈晚来时，清淮春浪软。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 265538,
      "title": "浑侍中宅牡丹",
      "content": [
        "径尺千余朵，人间有此花。",
        "今朝见颜色，更不向诸家。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 265539,
      "title": "咏红柿子",
      "content": [
        "晓连星影出，晚带日光悬。",
        "本因遗采掇，翻自保天年。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 265540,
      "title": "吕八见寄郡内书怀因而戏和",
      "content": [
        "文苑振金声，循良冠百城。",
        "不知今史氏，何处列君名。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 265541,
      "title": "秋风引",
      "content": [
        "何处秋风至，萧萧送鴈群。",
        "朝来入庭树，孤客最先闻。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 265542,
      "title": "柳花词三首 一",
      "content": [
        "开从绿条上，散逐香风远。",
        "故取花落时，悠扬占春晚。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 265543,
      "title": "柳花词三首 二",
      "content": [
        "轻飞不假风，轻落不委地。",
        "撩乱舞晴空，发人无限思。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 265544,
      "title": "柳花词三首 三",
      "content": [
        "晴天暗暗雪，来送青春暮。",
        "无意似多情，千家万家去。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 265545,
      "title": "路傍曲",
      "content": [
        "南山宿雨晴，春入凤凰城。",
        "处处闻弦管，无非送酒声。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 265546,
      "title": "君山怀古",
      "content": [
        "属车八十一，此地阻长风。",
        "千载威灵尽，赭山寒水中。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 265547,
      "title": "庭竹",
      "content": [
        "露涤铅粉节，风摇青玉枝。",
        "依依似君子，无地不相宜。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 265548,
      "title": "唐郎中宅与诸公同饮酒看牡丹",
      "content": [
        "今日花前饮，甘心醉数杯。",
        "但愁花有语，不为老人开。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 265549,
      "title": "题寿安甘棠馆二首 一",
      "content": [
        "公馆似仙家，池清竹径斜。",
        "山禽忽惊起，冲落半岩花。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 265550,
      "title": "题寿安甘棠馆二首 二",
      "content": [
        "门前洛阳道，门里桃花路。",
        "尘土与烟霞，其间十余步。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 265551,
      "title": "古词二首 一",
      "content": [
        "轩后初冠冕，前旒为蔽明。",
        "安知从复道，然后见人情。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 265552,
      "title": "古词二首 二",
      "content": [
        "簿领乃俗士，清谈信古风。",
        "吾观苏令绰，朱墨一何工。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 265553,
      "title": "寓兴二首 一",
      "content": [
        "常谈即至理，安事非常情。",
        "寄语何平叔，无为轻老生。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 265554,
      "title": "寓兴二首 二",
      "content": [
        "世途多礼数，鹏鷃各逍遥。",
        "何事陶彭泽，抛官为折腰。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 265555,
      "title": "咏史二首 一",
      "content": [
        "骠骑非无势，少卿终不去。",
        "世道剧颓波，我心如砥柱。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 265556,
      "title": "咏史二首 二",
      "content": [
        "贾生明王道，卫绾工车戏。",
        "同遇汉文时，何人居贵位。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 265557,
      "title": "经檀道济故垒",
      "content": [
        "万里长城坏，荒营野草秋。",
        "秣陵多士女，犹唱白符鸠。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 265558,
      "title": "伤段右丞",
      "content": [
        "江海多豪气，朝廷有直声。",
        "何言马蹄下，一旦是佳城。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 265559,
      "title": "伤独孤舍人",
      "content": [
        "昔别矜年少，今悲丧国华。",
        "远来同社燕，不见早梅花。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 265560,
      "title": "再伤庞尹",
      "content": [
        "京兆归何处，章台空暮尘。",
        "可怜鸾镜下，哭杀画眉人。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 265561,
      "title": "敬酬微公见寄二首 一",
      "content": [
        "凄凉沃州僧，顦顇柴桑宰。",
        "别来二十年，唯余两心在。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 265562,
      "title": "敬酬微公见寄二首 二",
      "content": [
        "越江千里镜，越岭四时雪。",
        "中有逍遥人，夜深观水月。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 265563,
      "title": "鄂渚留别李二十一表臣大夫",
      "content": [
        "高樯起行色，促柱动离声。",
        "欲问江深浅，应如远别情。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 265564,
      "title": "荅表臣赠别二首 一",
      "content": [
        "昔为瑶池侣，飞舞集蓬莱。",
        "今作江汉别，风雪一徘徊。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 265565,
      "title": "荅表臣赠别二首 二",
      "content": [
        "嘶马立未还，行舟路将转。",
        "江头瞑色深，挥袖依稀见。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 265566,
      "title": "始发鄂渚寄表臣二首 一",
      "content": [
        "祖帐管弦绝，客帆西风生。",
        "回车已不见，犹听马嘶声。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 265567,
      "title": "始发鄂渚寄表臣二首 二",
      "content": [
        "晓发柳林戍，遥城闻五鼓。",
        "忆与故人眠，此时犹晤语。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 265568,
      "title": "出鄂州界怀表臣二首 一",
      "content": [
        "离席一挥杯，别愁今尚醉。",
        "迟迟有情处，却恨江帆驶。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 265569,
      "title": "出鄂州界怀表臣二首 二",
      "content": [
        "梦觉疑连榻，舟行忽千里。",
        "不见黄鹤楼，寒沙雪相似。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 265570,
      "title": "和游房公旧竹亭闻琴绝句",
      "content": [
        "尚有竹间路，永无綦下尘。",
        "一闻流水曲，重忆餐霞人。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 265571,
      "title": "西州李尚书知愚与元武昌有旧远示二篇吟之泫然因以继和二首 一",
      "content": [
        "如何赠琴日，已是绝弦时。",
        "无复双金报，空余挂劒悲。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 265572,
      "title": "西州李尚书知愚与元武昌有旧远示二篇吟之泫然因以继和二首 二",
      "content": [
        "宝匣从此闲，朱弦谁复调。",
        "祗应随玉树，同向土中销。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 265573,
      "title": "别苏州二首 一",
      "content": [
        "三载为吴郡，临岐祖帐开。",
        "虽非谢桀黠，且为一裴回。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 265574,
      "title": "别苏州二首 二",
      "content": [
        "流水阊门外，秋风吹柳条。",
        "从来送客处，今日自魂销。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 265575,
      "title": "罢和州游建康",
      "content": [
        "秋水清无力，寒山暮多思。",
        "官闲不计程，徧上南朝寺。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 265576,
      "title": "九日登高",
      "content": [
        "世路山河险，君门烟雾深。",
        "年年上高处，未省不伤心。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 265577,
      "title": "荅柳子厚",
      "content": [
        "年方伯玉早，恨比四愁多。",
        "会待休车骑，相随出罻罗。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 265578,
      "title": "馆娃宫在旧郡西南砚石山前瞰姑苏台傍有采香径梁天监中置佛寺曰灵岩即故宫也信为绝境因赋二章 一",
      "content": [
        "宫馆贮娇娃，当时意大夸。",
        "艳倾吴国尽，笑入楚王家。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 265579,
      "title": "馆娃宫在旧郡西南砚石山前瞰姑苏台傍有采香径梁天监中置佛寺曰灵岩即故宫也信为绝境因赋二章 二",
      "content": [
        "月殿移椒壁，天花代舜华。",
        "唯余采香径，一带绕山斜。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 265580,
      "title": "听琴",
      "content": [
        "禅思何妨在玉琴，真僧不见听时心。",
        "秋堂境寂夜方半，云去苍梧湘水深。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 265581,
      "title": "魏宫词二首 一",
      "content": [
        "日晚长秋帘外报，望陵歌舞在明朝。",
        "添炉欲𦶟熏衣麝，忆得分时不忍烧。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 265582,
      "title": "魏宫词二首 二",
      "content": [
        "日映西陵松柏枝，下台相顾一相思。",
        "朝来乐府长歌曲，唱著君王自作词。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 265583,
      "title": "杨枝词二首 一",
      "content": [
        "迎得春光先到来，浅黄轻绿映楼台。",
        "只缘袅娜多情思，更被春风长倩猜。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 265584,
      "title": "杨枝词二首 二",
      "content": [
        "巫峡巫山杨柳多，朝云暮雨远相和。",
        "因想阳台无限事，为君回唱竹枝歌。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 265585,
      "title": "竹枝词二首 一",
      "content": [
        "杨柳青青江水平，闻郎江上唱歌声。",
        "东边日出西边雨，道是无晴却有晴。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 265586,
      "title": "竹枝词二首 二",
      "content": [
        "楚水巴山江雨多，巴人能唱本乡歌。",
        "今朝北客思归去，回入纥那披绿罗。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 265587,
      "title": "隄上行三首 一",
      "content": [
        "酒旗相望大隄头，堤下连樯堤上楼。",
        "日暮行人争渡急，桨声幽轧满中流。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 265588,
      "title": "隄上行三首 二",
      "content": [
        "江南江北望烟波，入夜行人相应歌。",
        "桃叶传情竹枝怨，水流无限月明多。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 265589,
      "title": "隄上行三首 三",
      "content": [
        "春堤缭绕水徘徊，酒舍旗亭次第开。",
        "日晚上楼招估客，轲峨大艑落颿来。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 265590,
      "title": "踏歌词四首 一",
      "content": [
        "春江月出大堤平，堤上女郎连袂行。",
        "唱尽新词欢不见，红霞映树鹧鸪鸣。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 265591,
      "title": "踏歌词四首 二",
      "content": [
        "桃蹊柳陌好经过，灯下妆成月下歌。",
        "为是襄王故宫地，至今犹自细腰多。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 265592,
      "title": "踏歌词四首 三",
      "content": [
        "新词宛转递相传，振袖倾鬟风露前。",
        "月落乌啼云雨散，游童陌上拾花钿。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 265593,
      "title": "踏歌词四首 四",
      "content": [
        "日暮江头闻竹枝，南人行乐北人悲。",
        "自从雪里唱新曲，直到三春花尽时。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 265594,
      "title": "步虚词二首 一",
      "content": [
        "阿母种桃云海际，花落子成三千岁。",
        "海风吹折最繁枝，跪捧琼盘献天帝。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 265595,
      "title": "步虚词二首 二",
      "content": [
        "华表千年一鹤归，凝丹为顶雪为衣。",
        "星星仙语人听尽，却向五云翻翅飞。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 265596,
      "title": "阿娇怨",
      "content": [
        "望见葳蕤举翠华，试开金屋扫庭花。",
        "须臾宫女传来信，言幸平阳公主家。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 265597,
      "title": "秋词二首 一",
      "content": [
        "自古逢秋悲寂寥，我言秋日胜春朝。",
        "晴空一鹤排云上，便引诗情到碧霄。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 265598,
      "title": "秋词二首 二",
      "content": [
        "山明水净夜来霜，数树深红出浅黄。",
        "试上高楼清入骨，岂如春色嗾人狂。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 265599,
      "title": "秋扇词",
      "content": [
        "莫道恩情无重来，人间荣谢递相催。",
        "当时初入君怀袖，岂念寒炉有死灰。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 265600,
      "title": "竹枝词九首 一",
      "content": [
        "白帝城头春草生，白盐山下蜀江清。",
        "南人上来歌一曲，北人莫上动乡情。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 265601,
      "title": "竹枝词九首 二",
      "content": [
        "山桃红花满上头，蜀江春水拍山流。",
        "花红易衰似郎意，水流无限似侬愁。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 265602,
      "title": "竹枝词九首 三",
      "content": [
        "江上朱楼新雨晴，瀼西春水縠纹生。",
        "桥东桥西好杨柳，人来人去唱歌行。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 265603,
      "title": "竹枝词九首 四",
      "content": [
        "日出三竿春雾消，江头蜀客驻兰桡。",
        "凭寄狂夫书一纸，家住成都万里桥。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 265604,
      "title": "竹枝词九首 五",
      "content": [
        "两岸山花似雪开，家家春酒满银杯。",
        "昭君坊中多女伴，永安宫外踏青来。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 265605,
      "title": "竹枝词九首 六",
      "content": [
        "城西门前滟滪堆，年年波浪不能摧。",
        "懊恼人心不如石，少时东去复西来。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 265606,
      "title": "竹枝词九首 七",
      "content": [
        "瞿塘嘈嘈十二滩，人言道路古来难。",
        "长恨人心不如水，等闲平地起波澜。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 265607,
      "title": "竹枝词九首 八",
      "content": [
        "巫峡苍苍烟雨时，清猿啼在最高枝。",
        "个里愁人肠自断，由来不是此声悲。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 265608,
      "title": "竹枝词九首 九",
      "content": [
        "山上层层桃李花，云间烟火是人家。",
        "银钏金钗来负水，长刀短笠去烧畬。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 265609,
      "title": "杨柳枝词九首 一",
      "content": [
        "塞北梅花羌笛吹，淮南桂树小山词。",
        "请君莫奏前朝曲，听唱新翻杨柳枝。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 265610,
      "title": "杨柳枝词九首 二",
      "content": [
        "南陌东城春早时，相逢何处不依依。",
        "桃红李白皆夸好，须得垂杨相发挥。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 265611,
      "title": "杨柳枝词九首 三",
      "content": [
        "凤阙轻遮翡翠帏，龙池遥望曲尘丝。",
        "御沟春水相辉映，狂杀长安年少儿。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 265612,
      "title": "杨柳枝词九首 四",
      "content": [
        "金谷园中莺乱飞，铜驼陌上好风吹。",
        "城中桃李须臾尽，争似垂杨无限时。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 265613,
      "title": "杨柳枝词九首 五",
      "content": [
        "花萼楼前初种时，美人楼上鬬腰肢。",
        "如今抛掷长街里，露叶如啼欲向谁。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 265614,
      "title": "杨柳枝词九首 六",
      "content": [
        "炀帝行宫汴水滨，数枝杨柳不胜春。",
        "晚来风起花如雪，飞入宫墙不见人。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 265615,
      "title": "杨柳枝词九首 七",
      "content": [
        "御陌青门拂地垂，千条金缕万条丝。",
        "如今绾作同心结，将赠行人知不知。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 265616,
      "title": "杨柳枝词九首 八",
      "content": [
        "城外春风吹酒旗，行人挥袂日西时。",
        "长安陌上无穷树，唯有垂杨管别离。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 265617,
      "title": "杨柳枝词九首 九",
      "content": [
        "轻盈袅娜占年华，舞榭妆楼处处遮。",
        "春尽絮花留不得，随风好去落谁家。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 265618,
      "title": "浪淘沙九首 一",
      "content": [
        "九曲黄河万里沙，浪淘风簸自天涯。",
        "如今直上银河去，同到牵牛织女家。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 265619,
      "title": "浪淘沙九首 二",
      "content": [
        "洛水桥边春日斜，碧流清浅见琼砂。",
        "无端陌上狂风急，惊起鸳鸯出浪花。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 265620,
      "title": "浪淘沙九首 三",
      "content": [
        "汴水东流虎眼纹，清淮晓色鸭头春。",
        "君看渡口淘沙处，渡却人间多少人。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 265621,
      "title": "浪淘沙九首 四",
      "content": [
        "鹦鹉洲头浪飐沙，青楼春望日将斜。",
        "衔泥燕子争归舍，独自狂夫不忆家。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 265622,
      "title": "浪淘沙九首 五",
      "content": [
        "濯锦江边两岸花，春风吹浪正淘沙。",
        "女郎剪下鸳鸯锦，将向中流疋晚霞。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 265623,
      "title": "浪淘沙九首 六",
      "content": [
        "日照澄洲江雾开，淘金女伴满江隈。",
        "美人首饰侯王印，尽是沙中浪底来。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 265624,
      "title": "浪淘沙九首 七",
      "content": [
        "八月涛声吼地来，头高数丈触山回。",
        "须臾却入海门去，卷起沙堆似雪堆。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 265625,
      "title": "浪淘沙九首 八",
      "content": [
        "莫道谗言如浪深，莫言迁客似沙沉。",
        "千淘万漉虽辛苦，吹尽狂沙始到金。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 265626,
      "title": "浪淘沙九首 九",
      "content": [
        "流水淘沙不暂停，前波未灭后波生。",
        "令人忽忆潇湘渚，回唱迎神三两声。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 265627,
      "title": "洛中送韩七中丞之吴兴口号五首 一",
      "content": [
        "昔年意气结群英，几度朝回一字行。",
        "海北江南零落尽，两人相见洛阳城。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 265628,
      "title": "洛中送韩七中丞之吴兴口号五首 二",
      "content": [
        "自从云散各东西，每日欢娱却惨凄。",
        "离别苦多相见少，一生心事在书题。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    }
  ],
