{
  "data": [
    {
      "id": 373158,
      "title": "劳山居寄呈吴处士",
      "content": [
        "官居鼎鼐古今无，名世才臣独一余。",
        "贤阁御题龙墨灿，诏归补衮在须臾。"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 373159,
      "title": "从军行五首",
      "content": [
        "候骑出纷纷，元戎霍冠军。",
        "汉鞞秋聒地，羌火昼烧云。",
        "万里戈城合，三边羽檄分。",
        "乌孙驱未尽，肯顾辽阳勋。",
        "韩旆拂丹霄，汉军新破辽。",
        "红尘驱卤簿，白羽拥嫖姚。",
        "战苦军犹乐，功高将不骄。",
        "至今丁零塞，朔吹空萧萧。",
        "百万逐呼韩，频年不解鞍。",
        "兵屯绝漠暗，马饮浊河干。",
        "破虏功未录，劳师力已殚。",
        "须防肘腋下，飞祸出无端。",
        "飞将下天来，奇谋阃外裁。",
        "水心龙剑动，地肺雁山开。",
        "望气燕师锐，当锋虏阵摧。",
        "从今射雕骑，不敢过云堆。",
        "黄纸君王诏，青泥校尉书。",
        "誓师张虎落，选将擐犀渠。",
        "雾暗津蒲失，天寒塞柳疏。",
        "横行十万骑，欲扫虏尘余。"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 373160,
      "title": "陇头水二首",
      "content": [
        "陇头水欲绝，陇水不堪闻。",
        "碎影摇枪垒，寒声咽幔军。",
        "素从盐海积，绿带柳城分。",
        "日落天边望，逶迤入塞云。",
        "秦陇逼氐羌，征人去未央。",
        "如何幽咽水，并欲断君肠。",
        "西注悲穷漠，东分忆故乡。",
        "旅魂声搅乱，无梦到咸阳。"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 373161,
      "title": "塞下曲二首",
      "content": [
        "寒塞无因见落梅，胡人吹入笛声来。",
        "劳劳亭上春应度，夜夜城南战未回。",
        "都护今年破武威，胡沙万里鸟空飞。",
        "旄竿瀚海扫云出，毡骑天山蹋雪归。"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 373162,
      "title": "览史",
      "content": [
        "黄绮皆皓发，秦时隐商山。",
        "嘉谋匡帝道，高步游天关。",
        "不爱珪组絏，却思林壑还。",
        "放歌长松下，日与孤云闲。"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 373163,
      "title": "咏史",
      "content": [
        "独负高世资，冥冥寄浮俗。",
        "卞子去不归，何人辩荆玉。",
        "鬻舂意不浅，污迹身岂辱。",
        "鸾铩乐迍邅，虬蟠甘窘束。",
        "五噫谲且正，可以见心曲。"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 373164,
      "title": "咏史",
      "content": [
        "田氏门下客，冯公众中贱。",
        "一朝市义还，百代名独擅。",
        "始知下客不可轻，能使主人功业成。",
        "借问高车与珠履，"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 373166,
      "title": "奉酬陆使君见过，各赋院中一物，得江蓠",
      "content": [
        "江蓠生古砌，花每落禅床。",
        "嘉客未采掇，空门自馨香。",
        "名因诗目见，色对道心忘。",
        "不遇陆内史，谁知殊众芳。"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 373167,
      "title": "赋得谢墅送王长史",
      "content": [
        "世业西山墅，移家长我身。",
        "萧疏遗树老，寂寞废田春。",
        "车巷伤前辙，篱沟忆旧邻。",
        "何堪再过日，更送北归人。"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 373170,
      "title": "奉同颜使君真卿送李侍御萼，赋得荻塘路",
      "content": [
        "落日车遥遥，客心在归路。",
        "细草暗回塘，春泉萦古渡。",
        "遗踪叹芜没，远道悲去住。",
        "寂寞荻花空，行人别无数。"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 373171,
      "title": "《赋颜氏古今一事，得晋仙传》，送颜逸",
      "content": [
        "曾看颜氏传，多记晋时仙。",
        "却忆桐君老，俱还桂父年。",
        "青春留鬓发，白日向云烟。",
        "远别赍遗简，囊中有几篇。"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 373173,
      "title": "赋得夜雨滴空阶，送陆羽归龙山",
      "content": [
        "闲阶夜雨滴，偏入别情中。",
        "断续清猿应，淋漓候馆空。",
        "气令烦虑散，时与早秋同。",
        "归客龙山道，东来杂好风。"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 373176,
      "title": "《听素法师讲法华经》",
      "content": [
        "法子出西秦，名齐漆道人。",
        "才敷药草义，便见雪山春。",
        "护讲龙来远，闻经鹤下频。",
        "应机如一雨，谁不涤心尘。"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 373177,
      "title": "咏敡上人座右画松",
      "content": [
        "写得长松意，千寻数尺中。",
        "翠阴疑背日，寒色欲生风。",
        "真树孤标在，高人立操同。",
        "一枝遥可折，吾欲问生公。"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 373179,
      "title": "妙喜寺逵公院赋得夜磬送吕评事",
      "content": [
        "一磬寒山至，凝心转清越。",
        "细和虚籁尽，疏绕悬泉发。",
        "在夜吟更长，停空韵难绝。",
        "幽僧悟深定，归客忘远别。",
        "寂历无性中，真声何起灭。"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 373181,
      "title": "仙女台",
      "content": [
        "寂寂旧桑田，谁家女得仙。",
        "应无鸡犬在，空有子孙传。",
        "古木花犹发，荒台路未迁。",
        "暮来云一片，疑是欲归年。"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 373184,
      "title": "南池杂咏五首：水月",
      "content": [
        "夜夜池上观，禅身坐月边。",
        "虚无色可取，皎洁意难传。",
        "若向空心了，长如影正圆。"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 373185,
      "title": "南池杂咏五首：溪云",
      "content": [
        "舒卷意何穷，萦流复带空。",
        "有形不累物，无迹去随风。",
        "莫怪长相逐，飘然与我同。"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 373186,
      "title": "南池杂咏五首：虚舟",
      "content": [
        "虚舟动又静，忽似去逢时。",
        "触物知无迕，为梁幸见遗。",
        "因风到此岸，非有济川期。"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 373187,
      "title": "南池杂咏五首：寒山",
      "content": [
        "侵空撩乱色，独爱我中峰。",
        "无事负轻策，闲行蹑幽踪。",
        "众山摇落尽，寒翠更重重。"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 373188,
      "title": "南池杂咏五首：寒竹",
      "content": [
        "袅袅孤生竹，独立山中雪。",
        "苍翠摇动风，婵娟带寒月。",
        "狂花不相似，还共凌冬发。"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 373190,
      "title": "惜暮景",
      "content": [
        "疏阴花不动，片景松梢度。",
        "夏日旧来长，佳游何易暮。"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 373192,
      "title": "古别离",
      "content": [
        "太湖三山口，吴王在时道。",
        "寂寞千载心，无人见春草。",
        "谁识缄怨者，持此伤怀抱。",
        "孤舟畏狂风，一点宿烟岛。",
        "望所思兮若何，月荡漾兮空波。",
        "云离离兮北断，",
        "春风胡为兮塞路，使我归梦兮撩乱。"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 373193,
      "title": "拟长安春词",
      "content": [
        "春信在河源，春风荡妾魂。",
        "春歌杂𫛸鴂，春梦绕轘辕。",
        "春絮愁偏满，春丝闷更繁。",
        "春期不可定，春曲懒新翻。"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 373194,
      "title": "效古",
      "content": [
        "思君转战度交河，强弄胡琴不成曲。",
        "日落应愁陇底难，"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 373196,
      "title": "铜雀妓",
      "content": [
        "强开尊酒向陵看，忆得君王旧日欢。",
        "不觉余歌悲自断，非关艳曲转声难。"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 373198,
      "title": "哭吴县房耸明府",
      "content": [
        "仁人迈厚德，可谓名实全。",
        "抚迹若疏旷，会心极精研。",
        "履危节讵屈，著论识不偏。",
        "恨以荣级浅，嘉猷未及宣。",
        "伊人期远大，志业难比肩。",
        "昭世既合并，吾君藉陶甄。",
        "奈何明明理，与善徒空诠。",
        "征教或稽圣，穷源反问天。",
        "一官自吴邑，六翮委江壖。",
        "始是牵丝日，翻成撤瑟年。",
        "金膏果不就，玉佩长此捐。",
        "倚伏信冥昧，夭修惊后先。",
        "安知忘情子，爱网素已褰。",
        "为有深仁感，遂令真性迁。",
        "心悲空林下，泪洒秋景前。",
        "夫子寡兄弟，抚孤伤藐然。",
        "倾云为惨结，吊鹤共联翩。",
        "割念命归驾，诀词向空筵。",
        "树桃阴始合，爱客位常悬。",
        "幡然远行时，崇望归朝旋。",
        "悟兹欢宴隔，哀被岁月延。",
        "书带变芳草，履痕移绿钱。",
        "冥期傥可逢，生尽会无缘。",
        "幸愿示因业，代君运精专。",
        "相思转寂寞，独往西林泉。",
        "欲见故人心，时阅所赠篇。",
        "素高陶靖节，今重楚先贤。",
        "芳躅将遗爱，可为终古传。"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 373203,
      "title": "万回寺",
      "content": [
        "万里称逆化，愚蠢性亦全。",
        "紫绂拖身上，妖姬安膝前。",
        "见他拘坐寂，故我是眠禅。",
        "吾知至人心，杳若青冥天。"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 373204,
      "title": "禅诗",
      "content": [
        "万法出无门，纷纷使智昏。",
        "徒称谁氏子，独立天地元。",
        "实际且何有，物先安可存。",
        "须知不动念，照出万重源。"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 373208,
      "title": "山雪",
      "content": [
        "夕阳在西峰，叠翠萦残雪。",
        "狂风卷絮回，惊猿攀玉折。",
        "何意山中人，误报山花发。"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 373209,
      "title": "江上风",
      "content": [
        "江风西复东，飘暴忽何穷。",
        "初生虚无际，稍起荡漾中。",
        "应吹夏口樯竿折，定蹙湓城浪花咽。",
        "今朝莫怪沙岸明，"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 373210,
      "title": "山雨",
      "content": [
        "一片雨，山半晴。",
        "长风吹落西山上，满树萧萧心耳清。",
        "云鹤惊乱下，水香凝不然。",
        "风回雨定芭蕉湿，"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 373211,
      "title": "问遥山禅老",
      "content": [
        "天与松子寿，独饮日月精。",
        "复令颜子贤，胡为夭其生。",
        "吾将寻河源，上天问天何不平？",
        "吾将诘仙老，",
        "明朝欲向翅头山，问取禅公此义还。"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 373212,
      "title": "禅思",
      "content": [
        "真我性无主，谁为尘识昏。",
        "奈何求其本，若拔大木根。",
        "妄以一念动，势如千波翻。",
        "伤哉子桑扈，虫臂徒虚言。",
        "神威兴外论，宗邪生异源。",
        "空何妨色在，妙岂废身存。",
        "寂灭本非寂，喧哗曾未喧。",
        "嗟嗟世上禅，不共智者论。"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 373213,
      "title": "支公诗",
      "content": [
        "支公养马复养鹤，率性无机多脱略。",
        "天生支公与凡异，"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 373214,
      "title": "述梦",
      "content": [
        "梦中归见西陵雪，渺渺茫茫行路绝。",
        "觉来还在剡东峰，"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 373217,
      "title": "戏题二首",
      "content": [
        "看饮逢歌日屡曛，我身何似系浮云。",
        "时人不解野僧意，归去溪头作鸟群。",
        "喧喧共在是非间，终日谁知我自闲。",
        "偶客狂歌何所为，欲于人事强相关。"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 373218,
      "title": "杂寓兴",
      "content": [
        "嗟嗟号呶子，世称谪仙俦。",
        "媚俗被鲛绡，欺天荐昫修。",
        "奔景谓可致，驰龄言易流。",
        "燕昭昧往事，嬴政亡前筹。",
        "三山果不见，九仙忽悠悠。",
        "君看牛山乐，君见麋浦游。",
        "昨日千金子，联绵成古丘。",
        "吾将揽明月，照尔生死流。",
        "至乐享爰居，惭贻达者尤。",
        "冥冥光尘内，机丧成海沤。"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 373219,
      "title": "杂兴六首",
      "content": [
        "吾观谈天客，工言丧其精。",
        "万物资广庇，此中何有情。",
        "若为昧颜蹠，修短怨太清。",
        "高论让邹子，放词征屈生。",
        "请从象外推，至论尤明明。",
        "短龄役长世，扰扰悟不早。",
        "嫔女身后空，欢娱梦中好。",
        "从教西陵树，千载伤怀抱。",
        "鹤驾何冥冥，鼇洲去浩浩。",
        "柔颜感三花，凋发悲蔓草。",
        "月中伐桂人是谁，",
        "谁高齐公子，泣听雍门琴。",
        "死且何足伤，殊非达人心。",
        "独高庭中鹤，意远贵氛埃。",
        "有时青冥游，顾我还下来。",
        "白云琅玕色，一片生虚无。",
        "此物若无心，若何卷还舒。",
        "疏散遂吾性，栖山更无机。",
        "寥寥高松下，独有闲云归。",
        "精意不可道，冥然还掩扉。"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 373220,
      "title": "偶然五首",
      "content": [
        "乐禅心似荡，吾道不相妨。",
        "独悟歌还笑，谁言老更狂。",
        "偶然寂无喧，吾了心性源。",
        "可嫌虫食木，不笑鸟能言。",
        "隐心不隐迹，却欲住人寰。",
        "欠树移春树，无山看画山。",
        "居喧我未错，真意在其间。",
        "虏语嫌不学，胡音从不翻。",
        "说禅颠倒是，乐杀金王孙。",
        "真隐须无矫，忘名要似愚。",
        "只将两条事，空却汉潜夫。"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 373225,
      "title": "浮云三章",
      "content": [
        "浮云浮云，集于扶桑。",
        "扶桑茫茫，日暮之光。",
        "匪日之暮，浮云之污。",
        "嗟我怀人，犹心如蠹。",
        "浮云浮云，集于咸池。",
        "咸池微微，日昃之时。",
        "匪日之昃，浮云之惑。",
        "嗟我怀人，忧心如织。",
        "浮云浮云，集于高舂。",
        "高舂蒙蒙，日夕之容。",
        "匪日之夕，浮云之积。",
        "嗟我怀人，忧心如惄。"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 373228,
      "title": "晨登乐游原，望终南积雪",
      "content": [
        "凌晨拥弊裘，径上古原头。",
        "雪霁山疑近，天高思若浮。",
        "琼峰埋积翠，玉嶂掩飞流。",
        "曜彩含朝日，摇光夺寸眸。",
        "寒空标瑞色，爽气袭皇州。",
        "清眺何人得，终当独再游。"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 373229,
      "title": "送商季皋",
      "content": [
        "比来知尔有诗名，莫恨东归学未成。",
        "新丰有酒为我饮，消取故园伤别情。"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 373230,
      "title": "吊灵均词",
      "content": [
        "昧天道兮有无，听汨渚兮踌躇。",
        "期灵均兮若存，",
        "天独何兮有君，君在万兮不群。",
        "既冰心兮皎洁，",
        "风激烈兮楚竹死，国殇人悲兮雨飔飔。",
        "雨飔飔兮望君时，"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 373231,
      "title": "步虚词",
      "content": [
        "予因览真诀，遂感西城君。",
        "玉笙下青冥，人间未曾闻。",
        "日华炼精魄，皎皎无垢氛。",
        "谓我有仙骨，且令饵氤氲。",
        "俯仰愧灵颜，愿随鸾鹄群。",
        "俄然动风驭，缥渺归青云。"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 373232,
      "title": "奉应颜尚书真卿观玄真子置酒张乐舞破阵画洞庭三山歌",
      "content": [
        "道流迹异人共惊，寄向画中观道情。",
        "如何万象自心出，",
        "石文乱点急管催，云态徐挥慢歌发。",
        "乐纵酒酣狂更好，",
        "盻睐方知造境难，象忘神遇非笔端。",
        "昨日幽奇湖上见，",
        "秋空暮景飒飒容，翻疑是真画不得。",
        "颜公素高山水意，"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 373233,
      "title": "答韦山人隐起龙文药瓢歌",
      "content": [
        "野人药瓢天下绝，全如浑金割如月。",
        "彪炳文章智使然，",
        "韦生能诗兼好异，获此灵瓢远相遗。",
        "仙侯玉帖人漫传，",
        "背上骊龙蟠不睡，张鳞摆颔生风云。",
        "世人强知金丹道，",
        "聊将系肘步何轻，便有三山孤鹤情。",
        "东方小儿乏此物，"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 373234,
      "title": "桃花石枕歌赠康从事",
      "content": [
        "卞山幽石产奇璞，荆人至死采不著。",
        "何人琢枕持赠君，",
        "至宝由来览者稀，今君独鉴应欲惜。",
        "何辞售与章天真，",
        "四座喧喧争目悦，巧过造化称一绝。",
        "莫言昨日因错磨，",
        "高窗正午风飒变，室中不减春天寒。",
        "主人所重重枕德，"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 373235,
      "title": "张伯英草书歌",
      "content": [
        "伯英死后生伯高，朝看手把山中毫。",
        "先贤草律我草狂，",
        "阆风游云千万朵，惊龙蹴踏飞欲堕。",
        "更睹邓林花落朝，",
        "有时取势气更高，忆得春江千里涛。",
        "张生奇绝难再遇，",
        "黄公酒垆兴偏入，阮籍不嗔嵇亦顾。",
        "长安酒榜醉后书，"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 373236,
      "title": "寒栖子歌",
      "content": [
        "君在庐山知不群，有疑是鹤又是云。",
        "生死尘埃污不得，",
        "拂除衣上饵烟霞，昨夜胥门宿蔡家。",
        "天然不饮亦不食，",
        "停形为饵天地根，世人皆死我独存。",
        "洗虑因吞清明箓，",
        "能令鬼哭神效灵，身如飘风不可绊。",
        "朝游崆峒夕汗漫，",
        "海上仙游不可见，人间日落空桑枝。"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 373237,
      "title": "翔隼歌送王端公",
      "content": [
        "古人赏神骏，何如秋隼击。",
        "独立高标望霜翮，",
        "晴空四顾忽不见，有时独出青霞傍。",
        "穷阴万里落寒日，",
        "见君高情有所属，赠别因歌翔隼曲。",
        "离亭惨惨客散时，"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 373238,
      "title": "白云歌寄陆中丞使君长源",
      "content": [
        "一见西山云，使人情意远。",
        "凭高发咏何超遥，",
        "洁白不由阴雨积，高明肯共杂烟重。",
        "万物有形皆有著，",
        "或逢天上或人间，人自营营云自闲。",
        "忽尔飞来暂为侣，",
        "白云遇物无偏颇，自是人心见同异。",
        "阊阖天门宜曙看，",
        "谁怜西山云，亭亭处幽绝。",
        "坐石长看非我羁，"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 373239,
      "title": "裴端公使君清席，赋得青桂歌送徐长史",
      "content": [
        "昔年攀桂为留人，今朝攀桂送归客。",
        "秋风桃李摇落尽，",
        "应怜独秀空林上，空赏敷华积雪间。",
        "昨夜一枝生在月，"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 373240,
      "title": "周长史昉画毗沙门天王歌",
      "content": [
        "长史画神独感神，高步区中无两人。",
        "雅而逸，高且真，",
        "慈威示物虽凛凛，在德无秋唯有春。",
        "吾知真象本非色，",
        "写出霜缣可舒卷，何人应识此情远。",
        "秋斋清寂无外物，",
        "至今云旗图我形，为君一顾烟尘清。"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 373241,
      "title": "奉和颜鲁公真卿落玄真子舴艋舟歌",
      "content": [
        "沧浪子后玄真子，冥冥钓隐江之汜。",
        "刳木新成舴艋舟，",
        "从水远逝兮任风还，朝五湖兮夕三山。",
        "停纶乍入芙蓉浦，",
        "竹竿袅袅鱼簁簁，此中自得还自笑。",
        "汗漫一游何可期，"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 373242,
      "title": "郑容全成蛟形木机歌",
      "content": [
        "万物贵天然，天然不可得。",
        "浑朴无劳剞劂工，",
        "可中风雨一朝至，还应不是池中物。",
        "苍山万重采一枝，",
        "高人心，多越格。",
        "有时就月吟春风，持来座右惊神客。",
        "爱君开合江之滨，白云黄鹤长相亲。",
        "南郭子綦我不识，"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 373243,
      "title": "奉同颜使君真卿清风楼赋得洞庭歌送吴炼师归林屋洞",
      "content": [
        "名山洞府到金庭，三十六洞称最灵。",
        "不有古仙启其秘，",
        "三千甲子朝玉帝，世上如今名始闻。",
        "吐纳青牙养肌发，",
        "吴兴太守道家流，仙师远放清风楼。",
        "应将内景还飞去，",
        "世人不到君自到，缥缈仙都谁与俦。",
        "黄鹤孤云天上物，"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 373244,
      "title": "戛铜碗为龙吟歌",
      "content": [
        "逸僧戛碗为龙吟，世上未曾闻此音。",
        "一从太尉房公赏，",
        "似出龙泉万丈底，乍怪声来近而远。",
        "未必全由戛者功，",
        "遥闻不断在烟杪，万籁无声天境空。",
        "乍向天台宿华顶，",
        "今日铿锽江上闻，蛟螭奔飞如得群。",
        "声过阴岭恐成雨，",
        "人生万事将此同，暮贱朝荣动还寂。"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 373245,
      "title": "饮茶歌诮崔石使君",
      "content": [
        "越人遗我剡溪茗，采得金牙爨金鼎。",
        "素瓷雪色缥沫香，",
        "再饮清我神，忽如飞雨洒轻尘。",
        "三饮便得道，",
        "愁看毕卓瓮间夜，笑向陶潜篱下时。",
        "崔侯啜之意不已，"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 373246,
      "title": "买药歌送杨山人",
      "content": [
        "华阴少年何所希，欲饵丹砂化骨飞。",
        "江南药少淮南有，",
        "夜惊潮没鸬鹚堰，朝看日出芙蓉楼。",
        "摇荡春风乱帆影，",
        "河间姹女直千金，紫阳夫人服不死。",
        "吾于此道复何如，"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 373247,
      "title": "薛卿教长行歌",
      "content": [
        "桂阳仙柳道家说，昔传苏君今是薛。",
        "聊将握槊偶时人，",
        "初疑月破云中堕，复怪星移指下攒。",
        "谁识兵奇势可保，",
        "凫惊隼击疾若飞，左顾右盻生光辉。",
        "家本联姻汉戚里，",
        "扈游长乐与祈年，人望青云白日边。",
        "谪宦江南岁阴晚，"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 373248,
      "title": "桃花石枕歌送安吉康丞",
      "content": [
        "君吏桃州尚奇迹，桃州采得桃花石。",
        "烂疑朝日照已舒，",
        "应羡花开不凋悴，应嘉玉片无缁磷。",
        "立性坚刚平若砥，",
        "君心所好我独知，别多见少长相思。",
        "从来赏玩安左右，"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 373249,
      "title": "赋得吴王送女潮歌，送李判官之河中府",
      "content": [
        "见说吴王送女时，行宫直到荆溪口。",
        "溪上千年送女潮，",
        "平波忽起二三尺，此上疑与神仙宅。",
        "今人犹望荆之湄，",
        "溪草何草号帝女，溪竹何竹号湘妃。",
        "灵涛旦暮自堪伤，",
        "不知别后相见期，君意何如此潮水。"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 373250,
      "title": "观李中丞洪二美人唱歌轧筝歌",
      "content": [
        "君家双美姬，善歌工筝人莫知。",
        "轧用蜀竹弦楚丝，",
        "美人矜名曲不误，蹙响时时如迸泉。",
        "赵琴素所嘉，",
        "淫声已阕雅声来，游鱼𪡋喁鹤裴回。",
        "主人高情始为开，",
        "文章已冠诸人籍。",
        "每笑石崇无道情，轻身重色祸亦成。",
        "君有佳人当禅伴，于中不废学无生。",
        "爱君天然性寡欲，",
        "不意全家万里来，湖中再见春山绿。",
        "吴兴公舍幽且闲，"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 373251,
      "title": "陈氏童子草书歌",
      "content": [
        "书家孺子有奇名，天然大草令人惊。",
        "僧虔老时把笔法，",
        "有时作点险且能，太行片石看欲崩。",
        "偶然长掣浓入燥，",
        "桐花飞尽子规思，主人高歌兴不至。",
        "浊醪不饮嫌昏沈，",
        "王家小令草最狂，为予洒出惊腾势。"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 373252,
      "title": "饮茶歌送郑容",
      "content": [
        "丹丘羽人轻玉食，采茶饮之生羽翼。",
        "名藏仙府世空知，",
        "霜天半夜芳草折，烂漫缃花啜又生。",
        "赏君此茶祛我疾，"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 373253,
      "title": "花石长枕歌答章居士赠",
      "content": [
        "楚山有石郢人琢，琢成长枕知是玉。",
        "全疑冰片坐恐销，",
        "吾师道吾不执宝，今日感君因执看。",
        "试叩铿然应清律，",
        "南山有云鹄在空，长松为我生凉风。",
        "高友朗咏乐其中，"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 373254,
      "title": "观王右丞维沧洲图歌",
      "content": [
        "沧洲误是真，萋萋忽盈视。",
        "便有春渚情，褰裳掇芳芷。",
        "飒然风至草不动，始悟丹青得如此。",
        "丹青变化不可寻，",
        "沧洲说近三湘口，谁知卷得在君手。",
        "披图拥褐临水时，"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 373255,
      "title": "洞庭山维谅上人院阶前孤生橘树歌",
      "content": [
        "洞庭仙山但生橘，不生凡木与梨栗。",
        "真子无私自不栽，",
        "若言此物无道性，何意孤生来就人。",
        "二月三月山初暖，",
        "九月十月争破颜，金实离离色殷殷，一夜天晴香满山。",
        "天生珍木异于俗，俗士来逢不敢触。",
        "清阴独步禅起时，"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 373256,
      "title": "春夜赋得漉水囊歌，送郑明府",
      "content": [
        "吴缣楚练何白皙，居士持来遗禅客。",
        "禅客能裁漉水囊，",
        "夕望东峰思漱盥，昽昽斜月悬灯纱。",
        "徙倚花前漏初断，",
        "因识仁人为宦情，还如漉水爱苍生。",
        "聊歌一曲与君别，"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 373257,
      "title": "湛处士枸杞架歌",
      "content": [
        "天生灵草生灵地，误生人间人不贵。",
        "独君井上有一根，",
        "春风亦解爱此物，袅袅时来傍香实。",
        "湿云缀叶摆不去，",
        "我独全生异此辈，顺时荣落不相背。",
        "孤松自被斧斤伤，",
        "撷芳生影风洒怀，其致翛然此中足。"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 373258,
      "title": "观裴秀才松石障歌",
      "content": [
        "谁工此松唯拂墨，巧思丹青营不得。",
        "初写松梢风正生，",
        "左右双松更奇绝，龙鳞麈尾仍半折。",
        "经春寒色聚不散，",
        "何年蒨蒨苔黏迹，几夜潺潺水击痕。",
        "裴生诗家后来客，"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 373259,
      "title": "送顾处士歌",
      "content": [
        "吴门顾子予早闻，风貌真古谁似君。",
        "人中黄宪与颜子，",
        "醉书在箧称绝伦，神画开厨怕飞出。",
        "谢氏檀郎亦可俦，",
        "知君别业长洲外，欲行秋田循畎浍。",
        "门前便取觳觫乘，",
        "满道喧喧遇君别，争窥玉润与冰清。"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 373260,
      "title": "水精数珠歌",
      "content": [
        "西方真人为行密，臂上记珠皎如日。",
        "佛名无著心亦空，"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 373261,
      "title": "兵后西日溪行",
      "content": [
        "一从清气上为天，仙叟何年见干海。",
        "黄河几度浊复清，",
        "风吹花片使我迷，时时问山惊踏雪。",
        "石梁丹灶意更奇，",
        "路是武陵路，人非秦代人。",
        "饭松得高侣，濯足偶清津。",
        "数片昔贤磐石在，几回并坐戴纶巾。"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 373262,
      "title": "姑苏行",
      "content": [
        "古台不见秋草衰，却忆吴王全盛时。",
        "千年月照秋草上，",
        "山中精灵安可睹，辙迹人踪麋鹿聚。",
        "婵娟西子倾国容，"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 373263,
      "title": "短歌行",
      "content": [
        "古人若不死，吾亦何所悲。",
        "萧萧烟雨九原上，",
        "人生在世共如此，何异浮云与流水。",
        "短歌行，",
        "何为不学金仙侣，一悟空王无死生。"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 373264,
      "title": "山月行",
      "content": [
        "家家望秋月，不及秋山望。",
        "山中万境长寂寥，",
        "忧虞欢乐皆占月，月本无心同不同。",
        "自从有月山不改，"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 373265,
      "title": "顾渚行寄裴方舟",
      "content": [
        "我有云泉邻渚山，山中茶事颇相关。",
        "𫛸鴂鸣时芳草死，",
        "由来惯采无近远，阴岭长兮阳崖浅。",
        "大寒山下叶未生，",
        "迷山乍被落花乱，度水时惊啼鸟飞。",
        "家园不远乘露摘，",
        "昨夜西峰雨色过，朝寻新茗复如何。",
        "女宫露涩青芽老，",
        "清泠真人待子元，贮此芳香思何极。"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 373266,
      "title": "武源行赠丘卿岑",
      "content": [
        "昔年群盗阻江东，吴山动摇楚泽空。",
        "齐人亦戴蜂虿毒，",
        "万人死地当虎口，一旦生涯悬彀中。",
        "昨日将军殉死节，",
        "长洲南去接孤城，居人散尽鼓噪惊。",
        "三春不见芳草色，",
        "纵横计出皆获全，士卒身先每轻死。",
        "扫平氛祲望吴门，",
        "如何弃置功不录，通籍无名滞江曲。",
        "灞亭不重李将军，",
        "野战攻城尽如此，即今谁是霍嫖姚。"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 373267,
      "title": "长安少年行",
      "content": [
        "翠楼春酒虾蟆陵，长安少年皆共矜。",
        "纷纷半醉绿槐道，躞蹀花骢骄不胜。"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 373268,
      "title": "风入松",
      "content": [
        "西岭松声落日秋，千枝万叶风飗飗。",
        "美人援琴弄成曲，",
        "搅寒松兮又夜起。",
        "夜未央，曲何长，金徽更促声泱泱。",
        "何人此时不得意，意苦弦悲闻客堂。"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 373271,
      "title": "答李季兰",
      "content": [
        "天女来相试，将花欲染衣。",
        "禅心竟不起，还捧旧花归。"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 373276,
      "title": "次日",
      "content": [
        "野外有一人，独立无四邻。",
        "彼见是我身，我见是彼身。"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
