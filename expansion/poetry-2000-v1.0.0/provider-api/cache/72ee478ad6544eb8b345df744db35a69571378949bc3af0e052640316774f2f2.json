{
  "data": [
    {
      "id": 377769,
      "title": "菩萨蛮·菩萨蛮 其九",
      "content": [
        "满宫明月梨花白，故人万里关山隔。",
        "金雁一双飞，泪痕沾绣衣。",
        "小园芳草绿，家住越溪曲。",
        "杨柳色依依，燕归君不归。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377770,
      "title": "菩萨蛮·菩萨蛮 其十",
      "content": [
        "宝函钿雀金㶉𫛶，沉香阁上吴山碧。",
        "杨柳又如丝，驿桥春雨时。",
        "画楼音信断，芳草江南岸。",
        "鸾镜与花枝，此情谁得知。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377771,
      "title": "菩萨蛮·菩萨蛮 其十一",
      "content": [
        "南园满地堆轻絮，愁闻一霎清明雨。",
        "雨后却斜阳，杏花零落香。",
        "无言匀睡脸，枕上屏山掩。",
        "时节欲黄昏，无聊独倚门。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377772,
      "title": "菩萨蛮·菩萨蛮 其十二",
      "content": [
        "夜来皓月才当午，重帘悄悄无人语。",
        "深处麝烟长，卧时留薄妆。",
        "当年还自惜，往事那堪忆。",
        "花落月明残，锦衾知晓寒。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377773,
      "title": "菩萨蛮·菩萨蛮 其十三",
      "content": [
        "雨暗夜合玲珑日，万枝香袅红丝拂。",
        "闲梦忆金堂，满庭萱草长。",
        "绣帘垂簏簌，眉黛远山绿。",
        "春水渡溪桥，凭栏魂欲消。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377774,
      "title": "菩萨蛮·菩萨蛮 其十四",
      "content": [
        "竹风轻动庭除冷，珠帘月上玲珑影。",
        "山枕隐秾妆，绿檀金凤凰。",
        "两蛾愁黛浅，故国吴宫远。",
        "春恨正关情，画楼残点声。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377775,
      "title": "更漏子·更漏子 其一",
      "content": [
        "柳丝长，春雨细，花外漏声迢递。",
        "惊塞雁，起城乌，画屏金鹧鸪。",
        "香雾薄，透帘幕，惆怅谢家池阁。",
        "红烛背，绣帘垂，梦长君不知。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377776,
      "title": "更漏子·更漏子 其二",
      "content": [
        "星斗稀，钟鼓歇，帘外晓莺残月。",
        "兰露重，柳风斜，满庭堆落花。",
        "虚阁上，倚栏望，还似去年惆怅。",
        "春欲暮，思无穷，旧欢如梦中。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377777,
      "title": "更漏子·更漏子 其三",
      "content": [
        "金雀钗，红粉面，花里暂时相见。",
        "如我意，感君怜，此情须问天。",
        "香作穗，蜡成泪，还似两人心意。",
        "山枕腻，锦衾寒，觉来更漏残。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377778,
      "title": "更漏子·更漏子 其四",
      "content": [
        "相见稀，相忆久，眉浅淡烟如柳。",
        "垂翠幕，结同心，待郎熏绣衾。",
        "城上月，白如雪，蝉鬓美人愁绝。",
        "宫树暗，鹊桥横，玉签初报明。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377779,
      "title": "更漏子·更漏子 其五",
      "content": [
        "背江楼，临海月，城上角声呜咽。",
        "堤柳动，岛烟昏，两行征雁分。",
        "京口路，归帆渡，正是芳菲欲度。",
        "银烛尽，玉绳低，一声村落鸡。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377780,
      "title": "更漏子·更漏子 其六",
      "content": [
        "玉炉香，红蜡泪，偏照画堂秋思。",
        "眉黛薄，鬓云残，夜长衾枕寒。",
        "梧桐树，三更雨，不道离情正苦。",
        "一叶叶，一声声，空阶滴到明。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377781,
      "title": "归国遥·归国遥·香玉",
      "content": [
        "香玉，翠凤宝钗垂簏簌，胜金粟，越罗春水绿。",
        "画堂照帘残烛，梦余更漏促。",
        "谢娘无限心曲，晓屏山断续。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377782,
      "title": "归国遥·归国遥·双脸",
      "content": [
        "双脸，小凤战蓖金飐艳。",
        "舞衣无力风敛，藕丝秋色染。",
        "锦帐绣帷斜掩，露珠清晓簟。",
        "粉心黄蕊花靥，黛眉山两点。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377783,
      "title": "酒泉子·酒泉子·花映柳条",
      "content": [
        "花映柳条，闲向绿萍池上。",
        "凭栏干，窥细浪，雨萧萧。",
        "近来音信两疏索，洞房空寂寞。",
        "掩银屏，垂翠箔，度春宵。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377784,
      "title": "酒泉子·酒泉子·日映纱窗",
      "content": [
        "日映纱窗，金鸭小屏山碧。",
        "故乡春，烟霭隔，背兰釭。",
        "宿妆惆怅倚高阁，千里云影薄。",
        "草初齐，花又落，燕双双。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377785,
      "title": "酒泉子·酒泉子·楚女不归",
      "content": [
        "楚女不归，楼枕小河春水。",
        "月孤明，风又起，杏花稀。",
        "玉钗斜簪云鬟髻，裙上金缕凤。",
        "八行书，千里梦，雁南归。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377786,
      "title": "酒泉子·酒泉子·罗带惹香",
      "content": [
        "罗带惹香，犹系别时红豆。",
        "泪痕新，金缕旧，断离肠。",
        "一双娇燕语雕梁，还是去年时节。",
        "绿阴浓，芳草歇，柳花狂。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377787,
      "title": "定西番·定西番·汉使昔年离别",
      "content": [
        "汉使昔年离别。",
        "攀弱柳，折寒梅，上高台。",
        "千里玉关春雪，雁来人不来。",
        "羌笛一声愁绝，月徘徊。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377788,
      "title": "定西番·定西番·海燕欲飞调羽",
      "content": [
        "海燕欲飞调羽。",
        "萱草绿，杏花红，隔帘栊。",
        "双鬓翠霞金缕，一枝春艳浓。",
        "楼上月明三五，琐窗中。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377789,
      "title": "定西番·定西番·细雨晓莺春晚",
      "content": [
        "细雨晓莺春晚。",
        "人似玉，柳如眉，正相思。",
        "罗幕翠帘初卷，镜中花一枝。",
        "肠断塞门消息，雁来稀。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377790,
      "title": "杨柳枝·杨柳枝·宜春苑外最长条",
      "content": [
        "宜春苑外最长条，闲袅春风伴舞腰。",
        "正是玉人肠绝处，一渠春水赤栏桥。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377791,
      "title": "杨柳枝·杨柳枝·南内墙东御路傍",
      "content": [
        "南内墙东御路傍，须知春色柳丝黄。",
        "杏花未肯无情思，何事行人最断肠。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377792,
      "title": "杨柳枝·杨柳枝·苏小门前柳万条",
      "content": [
        "苏小门前柳万条，毵毵金线拂平桥。",
        "黄莺不语东风起，深闭朱门伴舞腰。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377793,
      "title": "杨柳枝·杨柳枝·金缕毵毵碧瓦沟",
      "content": [
        "金缕毵毵碧瓦沟，六宫眉黛惹香愁。",
        "晚来更带龙池雨，半拂栏干半入楼。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377794,
      "title": "杨柳枝·杨柳枝·馆娃宫外邺城西",
      "content": [
        "馆娃宫外邺城西，远映征帆近拂提。",
        "系得王孙归意切，不关芳草绿萋萋。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377795,
      "title": "杨柳枝·杨柳枝·两两黄鹂色似金",
      "content": [
        "两两黄鹂色似金，袅枝啼露动芳音。",
        "春来幸自长如线，可惜牵缠荡子心。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377796,
      "title": "杨柳枝·杨柳枝·御柳如丝映九重",
      "content": [
        "御柳如丝映九重，凤凰窗映绣芙蓉。",
        "景阳楼畔千条路，一面新妆等晓风。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377797,
      "title": "杨柳枝·杨柳枝·织锦机边莺语频",
      "content": [
        "织锦机边莺语频，停梭垂泪忆征人。",
        "塞门三月犹萧索，纵有垂杨未觉春。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377798,
      "title": "南歌子·南歌子·手里金鹦鹉",
      "content": [
        "手里金鹦鹉，胸前绣凤凰。",
        "偷眼暗形相，不如从嫁与，作鸳鸯。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377799,
      "title": "南歌子·南歌子·似带如丝柳",
      "content": [
        "似带如丝柳，团酥握雪花。",
        "帘卷玉钩斜，九衢尘欲暮，逐香车。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377800,
      "title": "南歌子·南歌子·鬓堕低梳髻",
      "content": [
        "鬓堕低梳髻，连娟细扫眉。",
        "终日两相思，为君憔悴尽，百花时。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377801,
      "title": "南歌子·南歌子·脸上金霞细",
      "content": [
        "脸上金霞细，眉间翠钿深。",
        "倚枕覆鸳衾，隔帘莺百啭，感君心。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377802,
      "title": "南歌子·南歌子·扑蕊添黄子",
      "content": [
        "扑蕊添黄子，呵花满翠鬟。",
        "鸳枕映屏山，明月三五夜，对芳颜。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377803,
      "title": "南歌子·南歌子·转盼如波眼",
      "content": [
        "转盼如波眼，娉婷似柳腰。",
        "花里暗相招，忆君肠欲断，恨春宵。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377804,
      "title": "南歌子·南歌子·懒拂鸳鸯枕",
      "content": [
        "懒拂鸳鸯枕，休缝翡翠裙。",
        "罗帐罢炉熏，近来心更切，为思君。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377805,
      "title": "河渎神·河渎神·河上望丛柯",
      "content": [
        "河上望丛柯，庙前春雨来时。",
        "楚山无限鸟飞迟，兰棹空伤别离。",
        "何处杜鹃啼不歇，艳红开尽如血。",
        "蝉鬓美人愁绝，百花芳草佳节。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377806,
      "title": "河渎神·河渎神·孤庙对寒潮",
      "content": [
        "孤庙对寒潮，西陵风雨萧萧。",
        "谢娘惆怅倚兰桡，泪流玉箸千条。",
        "暮天愁听思归乐，早梅香满山郭。",
        "回首两情萧索，离魂何处飘泊。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377807,
      "title": "河渎神·河渎神·铜鼓赛神来",
      "content": [
        "铜鼓赛神来，满庭幡盖徘徊。",
        "水村江浦过风雷，楚山如画烟开。",
        "离别橹声空萧索，玉容惆怅妆薄。",
        "青麦燕飞落落，卷帘愁对珠阁。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377808,
      "title": "女冠子·女冠子·含娇含笑",
      "content": [
        "含娇含笑，宿翠残红窈窕。",
        "鬓如蝉，寒玉簪秋水，轻纱卷碧烟。",
        "雪胸鸾镜里，琪树凤楼前。",
        "寄语青娥伴，早求仙。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377809,
      "title": "女冠子·女冠子·霞帔云发",
      "content": [
        "霞帔云发，钿镜仙容似雪。",
        "画愁眉，遮语回轻扇，含羞下绣帷。",
        "玉楼相望久，花洞恨来迟。",
        "早晚乘鸾去，莫相遗。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377810,
      "title": "玉蝴蝶·玉蝴蝶·霞帔云发",
      "content": [
        "秋风凄切伤离，行客未归时。",
        "塞外草先衰江，南雁到迟。",
        "芙蓉凋嫩脸，杨柳堕新眉。",
        "摇落使人悲，断肠谁得知。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377811,
      "title": "清平乐·清平乐·上阳春晚",
      "content": [
        "上阳春晚，宫女愁蛾浅。",
        "新岁清平思同辇，争那长安路远。",
        "凤帐鸳被徒熏，寂寞花锁千门。",
        "竞把黄金买赋，为妾将上明君。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377812,
      "title": "清平乐·清平乐·洛阳愁绝",
      "content": [
        "洛阳愁绝，杨柳花飘雪。",
        "终日行人恣攀折，桥下流水呜咽。",
        "上马争劝离觞，南浦莺声断肠。",
        "愁杀平原年少，回首挥泪千行。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377813,
      "title": "遐方怨·遐方怨·凭绣槛",
      "content": [
        "凭绣槛，解罗帷。",
        "未得君书，肠断，潇湘春雁飞。",
        "不知征马几时归，海棠花谢也，雨霏霏。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377814,
      "title": "遐方怨·遐方怨·花半坼",
      "content": [
        "花半坼，雨初晴。",
        "未卷珠帘，梦残，惆怅闻晓莺。",
        "宿妆眉浅粉山横，约鬟鸾镜里，绣罗轻。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377815,
      "title": "诉衷情·诉衷情·莺语花舞春昼午",
      "content": [
        "莺语花舞春昼午，雨霏微。",
        "金带枕，宫锦，凤凰帷。",
        "柳弱蝶交飞，依依。",
        "辽阳音信稀，梦中归。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377816,
      "title": "思帝乡·思帝乡·花花",
      "content": [
        "花花，满枝红似霞。",
        "罗袖画帘肠断，卓香车。",
        "回面共人闲语，战篦金凤斜。",
        "惟有阮郎春尽，不归家。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377817,
      "title": "梦江南·梦江南·千万恨",
      "content": [
        "千万恨，恨极在天涯。",
        "山月不知心里事，水风空落眼前花，摇曳碧云斜。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377818,
      "title": "梦江南·梦江南·梳洗罢",
      "content": [
        "梳洗罢，独倚望江楼。",
        "过尽千帆皆不是，斜晖脉脉水悠悠，肠断白苹洲。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377819,
      "title": "河传·河传·江畔",
      "content": [
        "江畔，相唤。",
        "晓妆鲜，仙景个女采莲。",
        "请君莫向那岸边，少年，好花新满船。",
        "红袖摇曳逐风暖，垂玉腕，肠向柳丝断。",
        "浦南归，浦北归，莫知，晚来人已稀。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377820,
      "title": "河传·河传·湖上",
      "content": [
        "湖上，闲望。",
        "雨萧萧，烟浦花桥路遥。",
        "谢娘翠蛾愁不消，终朝，梦魂迷晚潮。",
        "荡子天涯归棹远，春已晚，莺语空肠断。",
        "若耶溪，溪水西，柳堤，不闻郎马嘶。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377821,
      "title": "河传·河传·同伴",
      "content": [
        "同伴，相唤。",
        "杏花稀，梦里每愁依违。",
        "仙客一去燕已飞，不归，泪痕空满衣。",
        "天际云鸟引晴远，春已晚，烟霭渡南苑。",
        "雪梅香，柳带长，小娘，转令人意伤。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377822,
      "title": "番女怨·番女怨·万枝香雪开已遍",
      "content": [
        "万枝香雪开已遍，细雨双燕。",
        "钿蝉筝，金雀扇，画梁相见。",
        "雁门消息不归来，又飞回。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377823,
      "title": "番女怨·番女怨·碛南沙上惊雁起",
      "content": [
        "碛南沙上惊雁起，飞雪千里。",
        "玉连环，金镞箭，年年征战。",
        "画楼离恨锦屏空，杏花红。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377824,
      "title": "荷叶杯·荷叶杯·一点露珠凝冷",
      "content": [
        "一点露珠凝冷，波影。",
        "满池塘。",
        "绿茎红艳两相乱，肠断。",
        "水风凉。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377825,
      "title": "荷叶杯·荷叶杯·镜水夜来秋月",
      "content": [
        "镜水夜来秋月，如雪。",
        "采莲时。",
        "小娘红粉对寒浪，惆怅。",
        "正思惟。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377826,
      "title": "荷叶杯·荷叶杯·楚女欲归南浦",
      "content": [
        "楚女欲归南浦，朝雨。",
        "湿愁红。",
        "小船摇漾入花里，波起。",
        "隔西风。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    }
  ],
