{
  "data": [
    {
      "id": 3185,
      "title": "古别离",
      "content": [
        "东门柳，年年岁岁征人手。",
        "千人万人于此别，柳亦能堪几人折。",
        "愿君遄归与君期，要及此柳未衰时。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 3186,
      "title": "蜡梅四绝句  其一",
      "content": [
        "花房小如许，铜剪黄金涂。",
        "中有万斛香，与君细细输。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 3187,
      "title": "蜡梅四绝句  其二",
      "content": [
        "来从底处所，黄露满衣湿。",
        "缘憨翻得怜，亭亭倚风立。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 3188,
      "title": "蜡梅四绝句  其三",
      "content": [
        "奕奕金仙面，排行立晓晴。",
        "殷勤夜来雪，少住作珠璎。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 3189,
      "title": "蜡梅四绝句  其四",
      "content": [
        "亭亭金步摇，朝日明汉宫。",
        "当时好光景，一似此园中。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 3190,
      "title": "次韵富季申主簿梅花",
      "content": [
        "东风知君将出游，玉人迥立林之幽。",
        "欹墙数苞乃尔瘦，中有万斛江南愁。",
        "君哦新诗我听莹，句里无尘春色静。",
        "人人索笑那得禁，独为君诗起君病。",
        "欲语未语令人嗟，桃李回看眼中沙。",
        "同心不见昭仪种，五出时惊公主花。",
        "典衣重作明朝约，聊复宽君念归洛。",
        "笛催疏影日更疏，快饮莫教春寂寞。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 3191,
      "title": "钱东之教授惠泽州吕道人砚为赋长句",
      "content": [
        "君不见铜雀台边多事土，走上觚棱荫歌舞。",
        "余香分尽垢不除，却寄书林污缣楮。",
        "岂如此瓦凝青膏，冷面不识奸雄曹。",
        "吕公已去泫余泣，通谱未许弘农陶。",
        "暮年得君真耐久，摩挲玉质云生手。",
        "未知南越石虚中，亦有文章似君否。",
        "西家扑满本弟昆，趣尚清浊何年分。",
        "一朝堕地真瓦砾，莫望韩公无瘗文。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 3192,
      "title": "以石龟子施觉心长老",
      "content": [
        "老龟千年作一息，天地并入支床力。",
        "何年生此石肠儿，非皮裹骨骨裹皮。",
        "君家元绪不慎口，遂与老桑同一朽。",
        "知君游世磨不磷，往作道人之石友。",
        "道人莫欺此龟无六眸，试与话禅当点头。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 3193,
      "title": "陪诸公登南楼啜新茶家弟出建除体诗诸公既和余因次韵",
      "content": [
        "建康九酝羙，侑以八品珍。",
        "除瘴去热恼，与茶不相亲。",
        "满月堕九天，紫面光磷磷。",
        "平生酪奴谤，脉脉气未申。",
        "定论得公诗，雅号知凝神。",
        "执持甘露椀，未觉有等伦。",
        "破睡及四座，愧我非嘉宾。",
        "危楼与世隔，万事不及唇。",
        "成公方坐啸，赏此玉花匀。",
        "收杯未要忙，再试晴天云。",
        "开口得一笑，兹游念当频。",
        "闭眼归默存，助发梨枣春。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 3194,
      "title": "诸公和渊明止酒诗因同赋",
      "content": [
        "爱河漂一世，既溺不能止。",
        "不如淡生活，吟诗北窗里。",
        "肺肝亦何罪，困此毛锥子。",
        "不如友曲生，是子差可喜。",
        "三杯取径醉，万绪散莫起。",
        "奈何刘伶妇，苦语见料理。",
        "不如一觉睡，浩然忘彼己。",
        "三十六策中，此策信高矣。",
        "政使江变酒，誓不涉其涘。",
        "尚须学王通，艺黍供祭祀。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 3195,
      "title": "以纸托乐秀才捣治",
      "content": [
        "古人争名翰墨薮，柿叶桑根俱不朽。",
        "固知老褚下欧阳，控御管城须好手。",
        "嫁非好时聊自强，幅则甚短惭甚长。",
        "闻道蔡侯闲石臼，为借余力生银光。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 3196,
      "title": "述怀呈十七家叔  其一",
      "content": [
        "儿时学道逃悲欢，只今未免忧饥寒。",
        "浮生万事蚁旋磨，冷官十年鱼上竿。",
        "竹林步兵亦忍辱，长安闭门出无仆。",
        "门前故人拥庐儿，政坐向来甘碌碌。",
        "公不见古人有待良不多，利名溺人甚风。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 3197,
      "title": "述怀呈十七家叔  其二",
      "content": [
        "波。",
        "垂露成帏仲长统，明月为烛张志和。",
        "尘中别多会日少，世事欲谈何可了。",
        "胸中万卷已无用，劝公留。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 3198,
      "title": "述怀呈十七家叔  其三",
      "content": [
        "眼送飞鸟。",
        "两翁观光今几时，赋归有约时已稽。",
        "未暇藏身北山北，且须。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 3199,
      "title": "述怀呈十七家叔  其四",
      "content": [
        "觅地西枝西。",
        "愿从我翁归洗耳，不用妓女污山水。",
        "肩舆亦莫要仆夫，自有门生与儿子。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 3200,
      "title": "同叔易于观我斋分韵得自字",
      "content": [
        "小草浪出山，大隐乃居市。",
        "功名一画饼，甚矣痴儿计。",
        "倾身犯火宅，顾自以为戏。",
        "汗颜逢冰子，更复问奚自。",
        "三肃斋中人，本是青云器。",
        "虽然山上山，政尔吏非吏。",
        "肃肃窗前竹，见引著胜地。",
        "世间剧寒暑，了不受荣悴。",
        "门前剥啄客，欲问观我意。",
        "但持邯郸枕，赠我一觉睡。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 3201,
      "title": "观我斋再分韵得下字",
      "content": [
        "一慵缚两脚，闭户了晨夜。",
        "梦攀城西树，起造君子舍。",
        "紫髯出堂堂，见客披衣谢。",
        "平生功名手，嗜静如食蔗。",
        "小斋剧冰壶，中明外无罅。",
        "要知日用事，趺坐看鸟下。",
        "主人心了了，竹石亦闲暇。",
        "儿童惯看客，我车当日驾。",
        "平分斋中闲，风月不待借。",
        "还须酒屡费，不用牛心炙。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 3202,
      "title": "寄题商洛宰令狐励迎翠楼",
      "content": [
        "西来金衣鹤，书落汝水湄。",
        "云霞映道路，中有迎翠诗。",
        "遥知五斗粟，未办买山资。",
        "政要百尺楼，了此浮天眉。",
        "森然诗中画，想见凭栏时。",
        "朝曦与暮霭，百变皆令姿。",
        "君方领此意，簿书何急为。",
        "众手剧云雨，唯山不瑕疪。",
        "当年四老翁，视世轻于芝。",
        "坐令山偃蹇，不受人招麾。",
        "谁欤楼中客，俯仰与山期。",
        "顾要君折腰，督邮真小儿。",
        "因之感我意，故岩归已迟。",
        "便携灵运屐，不待德璋移。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 3203,
      "title": "次韵谢天宁老见贻",
      "content": [
        "庭柏不受寒，依然照人绿。",
        "雾收晨光发，可玩不可掬。",
        "道人方出定，不复辨羊鹿。",
        "微云度遥天，一笑立于独。",
        "嗟予晚闻道，学看传灯录。",
        "三生蠹书鱼，万卷今可束。",
        "毂虽已破碎，犹欲大其辐。",
        "是身堪底用，况乃五斗粟。",
        "自从识师面，日月几转毂。",
        "受师炉中烟，无处著荣辱。",
        "周妻与何肉，恨我未免俗。",
        "从今谢百事，请作龟头缩。",
        "却笑长沙傅，区区问淹速。",
        "聊将非舌言，往和无谱曲。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 3204,
      "title": "陈叔易学士母阮氏挽词  其一",
      "content": [
        "典刑奕奕照来今，鹤发鱼轩汝水浔。",
        "避地梁鸿不偕老，弄乌莱子若为心。",
        "送葬忽见三千乘，奉裞那闻五百金。",
        "妇德母仪俱不愧，碑铭知已托张林。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 3205,
      "title": "陈叔易学士母阮氏挽词  其二",
      "content": [
        "去年披雾识儒先，欲拜萱堂未敢前。",
        "卢壶要传纱缦业，王裒忽废蓼莪篇。",
        "秀眉隔梦黄垆里，落日驱风丹旐边。",
        "佛子归真定何处，空令苦泪涨黄泉。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 3206,
      "title": "归洛道中",
      "content": [
        "洛阳城边风起沙，征衫岁岁负年华。",
        "归途忽践杨柳影，春事已到芜菁花。",
        "道路无穷几倾毂，牛羊既饱各知家。",
        "人生扰扰成底事，马上哦诗日又斜。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 3207,
      "title": "道中寒食  其一",
      "content": [
        "飞絮春犹冷，离家食更寒。",
        "能供几岁月，不办了悲欢。",
        "刺史蒲萄酒，先生苜蓿盘。",
        "一官违壮节，百虑集征鞍。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 3208,
      "title": "道中寒食  其二",
      "content": [
        "斗粟淹吾驾，浮云笑此生。",
        "有酒酬岁月，无梦到功名。",
        "客里逢归雁，愁边有乱莺。",
        "杨花不解事，更作倚风轻。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 3209,
      "title": "龙门",
      "content": [
        "不到龙门十载强，断崖依旧挂斜阳。",
        "金银佛寺浮佳气，花木禅房接上方。",
        "羸马暂来还径去，流莺多处最难忘。",
        "老僧不作留人意，看水看山白发长。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 3210,
      "title": "次韵谢心老以缘事至鲁山",
      "content": [
        "禅师瓶贮几多空，欲问以书无去鸿。",
        "鲁县人迎波若杖，天宁树起吉祥风。",
        "荒山春色篇章里，快士交情笔砚中。",
        "一日尘沙双碧眼，归时应与去时同。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 3211,
      "title": "友人惠石两峰巉然取杜子美玉山高并两峰寒之句名曰小玉山",
      "content": [
        "旧喜看书今不看，且留双眼向孱颜。",
        "从来作梦大槐国，此去藏身小玉山。",
        "暮霭朝曦一生了，高天厚地两峰闲。",
        "九华诗句喧寰宇，细比真形伯仲间。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 3212,
      "title": "秋夜",
      "content": [
        "中庭淡月照三更，白露洗空河汉明。",
        "莫遣西风吹叶尽，却愁无处著秋声。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 3213,
      "title": "跋外祖存诚子帖",
      "content": [
        "乱眼龙蛇起平陆，前身羲献已黄墟。",
        "客来空认袁公额，泪尽惭无杨恽书。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 3214,
      "title": "咏蟹",
      "content": [
        "量才不数制鱼额，四海神交顾建康。",
        "但见横行疑长躁，不知公子实无肠。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 3215,
      "title": "留别心老",
      "content": [
        "老心霜下松，名与隆公齐。",
        "人物北斗南，佛事东院西。",
        "平生四海脚，不踏四海泥。",
        "晚说汝州禅，饱啖天宁虀。",
        "梦中与我遇，相扶两枯藜。",
        "每见眼自明，不复烦金篦。",
        "却从梦中别，未免意惨污。",
        "它时访生死，林深路应迷。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 3216,
      "title": "中牟道中二首  其一",
      "content": [
        "雨意欲成还未成，归云却作伴人行。",
        "依然壤郭中牟县，千尺浮屠管送迎。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 3217,
      "title": "中牟道中二首  其二",
      "content": [
        "杨柳招人不待媒，蜻蜓近马忽相猜。",
        "如何得与凉风约，不共尘沙一并来。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 3218,
      "title": "秋雨",
      "content": [
        "尘起一月忧无禾，瓦鸣三日忧雨多。",
        "书生重口轻肝肾，不如墙角蚯蚓方长哦。",
        "少昊行秋龙洒道，风作万木皆商歌。",
        "病夫强起开户立，万个银竹惊森罗。",
        "人间伟观如此少，倚杖不觉泥及靴。",
        "菊丛欹倒未足道，老境知奈梧桐何。",
        "是事且置当务本，菜圃已添三万科。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 3219,
      "title": "中秋不见月",
      "content": [
        "去年中秋端正月，照我霑襟万条血。",
        "姮娥留笑待今年，净洗金觥对银阙。",
        "高唐妬妇心不闲，招得封姨同作难。",
        "岂惟恨满月宫里，肠断西山吴彩鸾。",
        "却疑周生怀月去，待到三更黑如故。",
        "人间今乏赵知微，无复清游继天柱。",
        "南枝乌鹊不敢哗，倚杖三叹风枝斜。",
        "明年强健更相约，会见林间金背蟆。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 3220,
      "title": "九日赏菊",
      "content": [
        "黄花不负秋，与秋作光辉。",
        "夜霜犹作恶，朝日为解围。",
        "今晨岂重九，节意入幽菲。",
        "孤芳擅天地，众卉亦已微。",
        "殷勤黄金靥，照耀白板扉。",
        "沽酒欲寿花，孔兄与我违。",
        "清坐绝省事，未觉此计非。",
        "夕英岂不腴，骚人自难肥。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 3221,
      "title": "游葆真池上",
      "content": [
        "墙厚不盈咫，人间隔蓬莱。",
        "高柳唤客游，我辈御风来。",
        "坐久落日尽，澹澹池光开。",
        "白云行水中，一笑三徘徊。",
        "鸭儿轻岁月，不受急景催。",
        "试作弄篙惊，徐去首不回。",
        "无心与境接，偶遇信悠哉。",
        "再来知何似，有句端难裁。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 3222,
      "title": "次韵王尧明郊祀显相之作",
      "content": [
        "奏书初不待衡谭，奠璧都南万玉参。",
        "黄屋倚霄明半夜，紫坛承月眩诸龛。",
        "声喧大吕初终六，影动玄圭陟降三。",
        "可是天公须羯鼓，已回寒驭作春酣。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 3223,
      "title": "端门听赦咏雪",
      "content": [
        "云叶垂鸡竿，雪花眩鸾旗。",
        "一天丰年意，飘入万寿巵。",
        "茫茫玉妃班，影乱千官仪。",
        "也知楼头喜，舞态方自持。",
        "教坊可怜女，面赤婆娑时。",
        "天公一笑罢，未觉风来迟。",
        "小儒惊伟观，到笏不敢吹。",
        "归家得细说，平分遗妻儿。",
        "茅檐玉三尺，坐玩可乐饥。",
        "生活太冷淡，侑以一篇诗。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 3224,
      "title": "游玉仙观以春风吹倒人为韵得吹字",
      "content": [
        "清游天不借，破帽沙疾吹。",
        "下马榱桷鸣，未恨十里陂。",
        "风余檐铎语，坐定炉烟迟。",
        "新春碧瓦丽，古意乔木奇。",
        "黄冠见客喜，此士定不羁。",
        "但愧城中尘，浼子青松枝。",
        "人间争夺丑，我亦寄枯棋。",
        "输赢共一笑，马影催归时。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 3225,
      "title": "路归马上再赋",
      "content": [
        "偶然思玉仙，便到玉仙游。",
        "兴尽未及郭，玉仙失回头。",
        "成毁俱一念，今昔浪百忧。",
        "未知横笛子，亦解此意不。",
        "春风所经过，水色如泼油。",
        "垂鞭见落日，世事剧悠悠。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 3226,
      "title": "来禽花",
      "content": [
        "来禽花高不受折，满意清明好时节。",
        "人间风日不贷春，昨暮烟脂今日雪。",
        "舍东芜菁满眼黄，胡蝶飞去专斜阳。",
        "妍嗤都无十日事，付与梧桐一夏凉。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 3227,
      "title": "放慵",
      "content": [
        "暖日薰杨柳，浓春醉海棠。",
        "放慵真有味，应俗苦相妨。",
        "宦拙从人笑，交疏得自藏。",
        "云移稳扶杖，燕坐独焚香。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 3228,
      "title": "清明二绝  其一",
      "content": [
        "街头女儿双髻鸦，随蜂趁蝶学夭邪。",
        "东风也作清明节，开遍来禽一树花。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 3229,
      "title": "清明二绝  其二",
      "content": [
        "卷地风抛市井声，病夫危坐了清明。",
        "一帘晚日看收尽，杨柳微风百媚生。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 3230,
      "title": "春日  其一",
      "content": [
        "朝来庭树有鸣禽，红绿扶春上远林。",
        "忽有好诗生眼底，安排句法已难寻。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 3231,
      "title": "春日  其二",
      "content": [
        "忆看梅雪缟中庭，转眼桃梢无数青。",
        "万事一身双鬓发，竹床欹卧数窗棂。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 3232,
      "title": "夏日集葆真池上以绿阴生昼静赋诗得静字",
      "content": [
        "清池不受暑，幽讨起予病。",
        "长安车辙边，有此荷万柄。",
        "是身虽可懒，共寄无尽兴。",
        "鱼游水底凉，鸟宿林间静。",
        "谈余日亭午，树影一时正。",
        "清风不负客，意重百金赠。",
        "聊将两鬓蓬，起照千丈镜。",
        "微波喜摇人，小立待其定。",
        "梁王今何许，柳色几衰盛。",
        "人生行乐耳，诗律已其剩。",
        "邂逅一樽酒，它年五君咏。",
        "重期踏月来，夜半啸烟艇。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 3233,
      "title": "游慧林寺以三峡炎蒸定有无为韵得定字是日欲逃暑阁下而守阁童子持不可",
      "content": [
        "我如东郊马，欹侧甘瘦病。",
        "今晨举足轻，起行得幽胜。",
        "抚窗唤懒融，槁面初出定。",
        "眼中无长物，坐久炉烟正。",
        "门前几乌帽，来往送朝暝。",
        "岂知帽影边，有地白日静。",
        "宝阁阴肃肃，童子色不令。",
        "年来惜违人，一笑取归径。",
        "愿言捐何肉，终岁奉清净。",
        "檐铎岂印吾，出门有余听。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 3234,
      "title": "道山宿直",
      "content": [
        "离离树子鹊惊飞，独倚枯筇无限时。",
        "千丈虚廊贮明月，十分奇事更新诗。",
        "人间路绝窗扉语，天上云空阁影移。",
        "遥想王戎烛下算，百年辛苦一生痴。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 3235,
      "title": "雨晴",
      "content": [
        "天缺西南江面清，纤云不动小滩横。",
        "墙头语鹊衣犹湿，楼外残雷气未平。",
        "尽取微凉供稳睡，急搜奇句报新晴。",
        "今宵绝胜无人共，卧看星河尽意明。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 3236,
      "title": "十月",
      "content": [
        "十月天公作许悲，负霜鸿雁不停飞。",
        "莽连万里云一去，红尽千林秋径归。",
        "病夫搜句了节序，小斋焚香无是非。",
        "睡过三冬莫开户，北风不贷芰荷衣。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 3237,
      "title": "漫郎",
      "content": [
        "漫郎功业大悠然，拄笏看山了十年。",
        "黑白半头明镜里，丹青千树恶风前。",
        "星霜屡费惊人句，天地元须使鬼钱。",
        "踏破九州无一事，只今分付结跏禅。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 3238,
      "title": "柳絮",
      "content": [
        "柳送腰支日几回，更教飞絮舞楼台。",
        "颠狂忽作高千丈，风力微时稳下来。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 3239,
      "title": "侯处士女挽词",
      "content": [
        "畴昔翁才比太师，固应生女作门楣。",
        "人间似梦风旌出，佛子何之宰树悲。",
        "五百裞金空穗帐，三千车乘忽荒陂。",
        "它年不共江流去，突兀张林妇德碑。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 3240,
      "title": "登天清寺塔",
      "content": [
        "为眼不计脚，攀梯受微辛。",
        "半天拍阑干，惊倒地上人。",
        "风从万里来，老夫方岸巾。",
        "荒荒春浮木，浩浩空纳尘。",
        "夕阳差万瓦，赤鲤欲动鳞。",
        "须臾暮烟合，青鲂映奫沦。",
        "万化本日驰，高处觉眼新。",
        "借问龛中仙，坐稳今几辰。",
        "俗子书满壁，澹然不生嗔。",
        "唯有太行山，修供独殷勤。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 3241,
      "title": "浴室观雨以催诗走群龙为韵得走字",
      "content": [
        "微云生屋脊，欹枕看培𪣻。",
        "崔嵬乱一瞬，泰华入搔首。",
        "须臾万银竹，壮观惊户牖。",
        "摧击竟自碎，映空白烟走。",
        "余飚送未了，日色在井口。",
        "去冬三寸雪，寒日澹相守。",
        "商量细细融，未觉经旬久。",
        "谁能料天工，办此颖脱手。",
        "一凉满天地，平分到庭柳。",
        "叶端啸余风，送我一杯酒。",
        "画屏题细字，尽记同来友。",
        "俗眼之所遗，此事当不朽。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 3242,
      "title": "夏至日与太学同舍会葆真二首  其一",
      "content": [
        "微官有阀阅，三赋池上诗。",
        "林密知夏深，仰看天离离。",
        "官忙负远兴，觞至及良时。",
        "荷气夜来雨，百鸟清昼迟。",
        "微风不动苹，坐看水色移。",
        "门前争夺场，取欢不偿悲。",
        "欲归未得去，日暮多黄鹂。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 3243,
      "title": "夏至日与太学同舍会葆真二首  其二",
      "content": [
        "明波影千柳，绀屋朝万荷。",
        "物新感节移，意定觉景多。",
        "游鱼聚亭影，镜面散微涡。",
        "江湖岂在远，所欠雨一蓑。",
        "忽看带箭禽，三叹无奈何。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 3244,
      "title": "翁高邮挽诗",
      "content": [
        "万里功名路，三生翰墨身。",
        "暮年铜虎重，浮世石羊新。",
        "天地悭豪杰，山川泣吏民。",
        "空传四十诔，竟不识斯人。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 3245,
      "title": "秋试院将出书所寓窗",
      "content": [
        "门前柿叶已堪书，弄镜烧香聊自娱。",
        "百世窗明窗暗里，题诗不用著工夫。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 3246,
      "title": "秋日",
      "content": [
        "琢句不成添鬓丝，且搘筇杖看云移。",
        "槐花落尽全林绿，光景浑如初夏时。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 3247,
      "title": "夏日",
      "content": [
        "赤日可中庭，树影歛不开。",
        "烛龙未肯忙，一步九徘徊。",
        "梦中惊耳鸣，欲觉闻远雷。",
        "屋山奇峰起，欹枕看云来。",
        "变化信难料，转头失崔嵬。",
        "虽然不成雨，风起亦快哉。",
        "槐叶万背白，少振十日埃。",
        "白团岂办此，掷去羞薄才。",
        "蜻蜓泊墙阴，近人故多猜。",
        "墙西岂更热，已去却飞回。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 3248,
      "title": "送王周士赴发运司属官",
      "content": [
        "宁食三斗尘，有手不揖无诗人。",
        "宁饮三斗醋，有耳不听无味句。",
        "墙东草深兰发薰，君先梦我我梦君。",
        "小窗诵诗灯花喜，窗外北风怒未已。",
        "书生得句胜得官，风其少止尽人欢。",
        "五更月晕一千丈，明日君当泛淮浪。",
        "去去三十六策中，第一买酒鏖北风。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 3249,
      "title": "试院春晴",
      "content": [
        "今日天气佳，忽思赋新诗。",
        "春光挟晴色，并上桃花枝。",
        "白云浩浩去，天色青陆离。",
        "余霏遇晚日，彩翠纷新奇。",
        "天公出变化，惊倒痴绝儿。",
        "逶迤或耐久，美好固暂时。",
        "平生一枝筇，稳处念力衰。",
        "澹然意已足，却赴青灯期。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 3250,
      "title": "试院书怀",
      "content": [
        "细读平安字，愁边失岁华。",
        "疏疏一帘雨，淡淡满枝花。",
        "投老诗成癖，经春梦到家。",
        "茫然十年事，倚杖数栖鸦。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 3251,
      "title": "次韵何文缜题颜持约画水墨梅花二首  其一",
      "content": [
        "窗间光影晚来新，半幅溪藤万里春。",
        "从此不贪江路好，剩拚心力唤真真。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 3252,
      "title": "次韵何文缜题颜持约画水墨梅花二首  其二",
      "content": [
        "夺得斜枝不放归，倚窗承月看熹微。",
        "墨池雪岭春俱好，付与诗人说是非。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 3253,
      "title": "又六言",
      "content": [
        "未央宫里红杏，羯鼓三声打开。",
        "大庾岭头梅萼，管城呼上屏来。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 3254,
      "title": "题持约画轴",
      "content": [
        "日落川更阔，烟生山欲浮。",
        "舟中有闲地，载我得同游。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 3255,
      "title": "为陈介然题持约画",
      "content": [
        "层层水落白滩生，万里征鸿小作程。",
        "日暮微风过荷叶，陂南陂北听秋声。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 3256,
      "title": "寄题兖州孙大夫绝尘亭二首  其一",
      "content": [
        "不读远游赋，放怀兹地宜。",
        "云山绕窗户，万态争纷披。",
        "世故日已远，风水方逶迤。",
        "倚杖夜来雨，东山烟散迟。",
        "人间许长史，不与此心期。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 3257,
      "title": "寄题兖州孙大夫绝尘亭二首  其二",
      "content": [
        "境空纳浩荡，日暮生泬寥。",
        "竹声池边起，欲断还萧萧。",
        "丈人方微吟，万象各动摇。",
        "林间光景异，月出东山椒。",
        "门前谁剥啄，已逝不须邀。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 3258,
      "title": "梅花两绝句  其一",
      "content": [
        "客行满山雪，香处是梅花。",
        "丁宁明月夜，认取影横斜。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 3259,
      "title": "梅花两绝句  其二",
      "content": [
        "晓天青脉脉，玉面立疏篱。",
        "山中尔许树，独自费人诗。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 3260,
      "title": "送善相僧超然归庐山",
      "content": [
        "九叠峰前远法师，长安尘染坐禅衣。",
        "十年依旧双瞳碧，万里今持一笑归。",
        "鼠目向来吾自了，龟肠从与世相违。",
        "酒酣更欲烦公说，黄叶漫山锡杖飞。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 3261,
      "title": "休日早起",
      "content": [
        "昽昽窗影来，稍稍禽声集。",
        "开门知有雨，老树半身湿。",
        "剧谈了无味，远游非所急。",
        "蒲团著身宽，安取万户邑。",
        "开镜白云渡，卷帘秋光入。",
        "饱受今日闲，明朝复羁絷。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 3262,
      "title": "夏夜",
      "content": [
        "幽窗报夕霁，微月在屋橑。",
        "手中白羽扇，共此夜寥寥。",
        "六月天正碧，三更树微摇。",
        "缅怀山中景，兹夕感路遥。",
        "长啸送行云，可望不可招。",
        "夜阑林光发，白露濡青条。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 3263,
      "title": "棋",
      "content": [
        "长日无公事，闲围李远棋。",
        "傍观真一笑，互胜不移时。",
        "幸未逢重霸，何妨著献之。",
        "晴天散飞雹，惊动隔墙儿。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 3264,
      "title": "与伯顺饭于文纬大光出宋汉杰画秋山",
      "content": [
        "焚香消午睡，开画逢秋山。",
        "皇都马声中，有此四士闲。",
        "离离南国树，闪闪湘水湾。",
        "悠悠孤鸟去，澹澹晨辉还。",
        "屐上十年蜡，未散腰脚顽。",
        "不如一诣君，坐此岩石间。",
        "远峰如修眉，近峰如堕鬟。",
        "书生饱作祟，眼乱纷斓斑。",
        "一笑遗世人，聊破千载颜。",
        "诗成即画记，可益不可删。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 3265,
      "title": "九日宜春苑午憩幕中听大光诵朱迪功诗",
      "content": [
        "酒酣耳热不能歌，奈此一川黄菊何。",
        "卧听西风吹好句，老夫无恨幕生波。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 3266,
      "title": "冬至二首  其一",
      "content": [
        "少年多意气，老去一分无。",
        "闭户了冬至，日长添数珠。",
        "北风不贷节，鸿雁天南驱。",
        "乌帽亦何幸，七日守屋庐。",
        "石炉深炷火，撩乱一榻书。",
        "只可自怡悦，不堪寄张扶。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 3267,
      "title": "冬至二首  其二",
      "content": [
        "人生本是客，杜叟顾未知。",
        "今年我闻道，悲乐两脱遗。",
        "日色如昨日，未觉墉阴迟。",
        "不须行年记，异代寻吾诗。",
        "东家窈窕娘，融蜡幻梅枝。",
        "但恐负时节，那知有愁时。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 3268,
      "title": "西省酴醾架上残雪可爱戏同王元忠席大光赋诗",
      "content": [
        "酴醾花底当年事，夜雪模糊照酒阑。",
        "北省今朝枝上雪，还揩病眼作花看。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 3269,
      "title": "对酒",
      "content": [
        "新诗满眼不能裁，鸟度云移落酒杯。",
        "官里簿书无日了，楼头风雨见秋来。",
        "是非衮衮书生老，岁月匆匆燕子回。",
        "笑抚江南竹根枕，一樽呼起鼻中雷。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 3270,
      "title": "后三日再赋",
      "content": [
        "天生瘿木不须栽，说与儿童是酒杯。",
        "落日留霞知我醉，长风吹月送诗来。",
        "一官扰扰身增病，万事悠悠首独回。",
        "不奈长安小车得，睡乡深处作奔雷。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 3271,
      "title": "将赴陈留寄心老",
      "content": [
        "今日忽不乐，图书从纠纷。",
        "不见汝州师，但见西来云。",
        "长安岂无树，忆师堂前柳。",
        "世路九折多，游子百事丑。",
        "三年成一梦，梦破说梦中。",
        "来时西门雨，去日东门风。",
        "书到及师闲，为我点枯笔。",
        "画作谪官图，羸骖带寒日。",
        "他时取归路，千里作一程。",
        "饱吃残年饭，就师听竹声。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 3272,
      "title": "赴陈留二首  其一",
      "content": [
        "草草一梦阑，行止本难期。",
        "岁晚陈留路，老马三振鬐。",
        "自看鞭袖影，旷野日落迟。",
        "柳林行不尽，想见春风时。",
        "点点羊散村，阵阵鸿投陂。",
        "城中那有此，触处皆新诗。",
        "举手谢路人，醉语勿瑕疵。",
        "我行有官事，去作三年痴。",
        "遥闻辟谷仙，阅世河水湄。",
        "时从玩木影，政尔不忧饥。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 3273,
      "title": "赴陈留二首  其二",
      "content": [
        "马上摩挲眼，出门光景新。",
        "鸦鸣半陂雪，路转一林春。",
        "旧岁有三日，全家无十人。",
        "平生鹦鹉盏，今夕最关身。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 3274,
      "title": "至陈留",
      "content": [
        "烟际亭亭塔，招人可得回。",
        "等闲为梦了，闻健出关来。",
        "日落河冰壮，天长鸿雁哀。",
        "平生远游意，随处一徘徊。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 3275,
      "title": "客里",
      "content": [
        "客里东风起，逢人只四愁。",
        "悠悠杂唯唯，莫莫更休休。",
        "窗影鸟双度，水声船逆流。",
        "一官成一集，尽付古河头。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 3276,
      "title": "初至陈留南镇夙兴赴县",
      "content": [
        "五更风摇白竹扉，整冠上马不可迟。",
        "三家陂口鸡喔喔，早于昨日朝天时。",
        "行云弄月翳复吐，林间明灭光景奇。",
        "川原四望鬰高下，荡摇苍茫森陆离。",
        "客心忽动群鸟起，马影渐薄村墟移。",
        "须臾东方云锦发，向来所见今难追。",
        "两眼聊随万象转，一官已判三年痴。",
        "只将乘除了吾事，推去木枕收此诗。",
        "写我新篇作画障，不须更觅丹青师。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 3277,
      "title": "游八关寺后池上",
      "content": [
        "落日生春色，微澜动古池。",
        "柳林横绝野，藜杖去寻诗。",
        "不有今年谪，争成此段奇。",
        "殷勤雪颅老，随客转荒陂。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 3278,
      "title": "种竹",
      "content": [
        "种竹不必高，摇绿当我楹。",
        "向来三家墅，无此笙箫声。",
        "皇天有老眼，为閟十日晴。",
        "护我萧萧碧，伟事邻翁惊。",
        "同林偶落此，相向意甚平。",
        "何须俟迷日，可笑世俗情。",
        "明年万夭矫，穿地听雷鸣。",
        "但恨种竹人，南山合归耕。",
        "佗时梦中路，留眼记所更。",
        "苍云屯十里，不见陈留城。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 3279,
      "title": "对酒",
      "content": [
        "陈留春色撩诗思，一日搜肠一百回。",
        "燕子初归风不定，桃花欲动雨频来。",
        "人间多待须微禄，梦里相逢记此杯。",
        "白竹扉前容醉舞，烟村渺渺欠高台。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 3280,
      "title": "寒食",
      "content": [
        "草草随时事，萧萧傍水门。",
        "浓阴花照野，寒食柳围村。",
        "客袂空佳节，莺声忽故园。",
        "不知何处笛，吹恨满清尊。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 3281,
      "title": "再游八关",
      "content": [
        "古镇易为客，了身一篮舆。",
        "贪游八关寺，忘却子公书。",
        "青青天气肃，澹澹春意初。",
        "东风经古池，满面生纡余。",
        "卯申缚壮士，人世信少娱。",
        "时来照兹水，点检鬓与须。",
        "日暮登古原，微白见远墟。",
        "念我遂初赋，徘徊月生裾。",
        "悠悠不同抱，悄悄就归途。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 3282,
      "title": "感怀",
      "content": [
        "少日争名翰墨场，只今扶杖送斜阳。",
        "青青草木浮元气，渺渺山河接故乡。",
        "作吏不妨三折臂，搜诗空费九回肠。",
        "子房与我同羁旅，世事千般酒一觞。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 3283,
      "title": "窦园醉中前后五绝句  其一",
      "content": [
        "东风吹雨小寒生，杨柳飞花乱晚晴。",
        "客子从今无可恨，窦家园里有莺声。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
