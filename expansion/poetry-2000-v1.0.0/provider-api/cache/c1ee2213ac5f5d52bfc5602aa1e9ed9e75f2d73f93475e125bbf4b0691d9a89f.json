{
  "data": [
    {
      "id": 262284,
      "title": "昭应官舍",
      "content": [
        "绕厅春草合，知道县家闲。",
        "行见雨遮院，卧看人上山。",
        "避风新浴后，请假未醒间。",
        "朝客轻卑吏，从他不往还。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 262285,
      "title": "送严大夫赴桂州",
      "content": [
        "岭头分界候，一半属湘潭。",
        "水驿门旗出，山峦洞主参。",
        "辟邪犀角重，解酒荔枝甘。",
        "莫叹京华远，安南更有南。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 262286,
      "title": "望行人",
      "content": [
        "自从江树秋，日日望江楼。",
        "梦见离珠浦，书来在桂州。",
        "不同鱼比目，终恨水分流。",
        "久不开明镜，多应是白头。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 262287,
      "title": "塞上",
      "content": [
        "漫漫复凄凄，黄沙暮渐迷。",
        "人当故乡立，马过旧营嘶。",
        "断雁逢冰碛，回军占雪溪。",
        "夜来山下哭，应是送降奚。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 262288,
      "title": "杜中丞书院新移小竹",
      "content": [
        "此地本无竹，远从山寺移。",
        "经年求养法，隔日记浇时。",
        "嫩绿卷新叶，残黄收故枝。",
        "色轻寒不动，声与静相宜。",
        "爱护出常数，稀稠看自知。",
        "贫来缘未有，客散独行迟。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 262289,
      "title": "同于汝锡赏白牡丹",
      "content": [
        "晓日花初吐，春寒白未凝。",
        "月光裁不得，苏合点难胜。",
        "柔腻于云叶，新鲜掩鹤膺。",
        "统心黄倒晕，侧茎紫重棱。",
        "乍敛看如睡，初开问欲譍。",
        "竝香幽蕙死，比艳美人憎。",
        "价数千金贵，形相两眼疼。",
        "自知颜色好，愁被彩光凌。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 262290,
      "title": "送吴郎中赴忠州",
      "content": [
        "西台复南省，清白上天知。",
        "家每因穷散，官多为直移。",
        "遥边过驿近，买药出城迟。",
        "朝野凭人别，亲情伴酒悲。",
        "故园愁去后，白发想回时。",
        "何处忠州界，山头卓望旗。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 262291,
      "title": "照镜",
      "content": [
        "终日自缠绕，此身无适缘。",
        "万愁生旅夜，百病凑衰年。",
        "少睡憎明屋，慵行待暖天。",
        "痒头梳有虱，风耳炙闻蝉。",
        "摇白方多错，回金法不全。",
        "家贫何所恋，时在老僧边。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 262292,
      "title": "秋日送杜虔州",
      "content": [
        "忆得宿新宅，别来余蕙香。",
        "初闻守郡远，一日卧空床。",
        "野驿烟火湿，路人消息狂。",
        "山楼添鼓角，村栅立旗枪。",
        "晚渚露荷败，早衙风桂凉。",
        "谢家章句出，江月少辉光。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 262293,
      "title": "送郑权尚书南海",
      "content": [
        "七郡双旌贵，人皆不忆廻。",
        "戍头龙脑铺，关口象牙堆。",
        "勅设熏𬬻出，蛮辞咒节开。",
        "市喧山贼破，金贱海船来。",
        "白氎家家织，红蕉处处栽。",
        "已将身报国，莫起望乡台。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 262294,
      "title": "题别遗爱草堂兼呈李十使君",
      "content": [
        "曾住𬬻峰下，书堂对药台。",
        "斩新萝径合，依旧竹牕开。",
        "砌水亲看决，池荷手自栽。",
        "五年方𫏐至，一宿又须回。",
        "纵未长归得，犹胜不到来。",
        "君家白鹿洞，闻道亦生苔。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 262295,
      "title": "赏牡丹",
      "content": [
        "此花名价别，开艳益皇都。",
        "香遍苓菱死，红烧踯躅枯。",
        "软光笼细脉，妖色暖鲜肤。",
        "满蘂攒黄粉，含棱缕绛苏。",
        "好和薰御服，堪画入宫图。",
        "晚态愁新妇，残粧望病夫。",
        "教人知个数，留客赏斯须。",
        "一夜轻风起，千金买亦无。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 262296,
      "title": "赠王枢密",
      "content": [
        "三朝行坐镇相随，今上春宫见小时。",
        "脱下御衣先赐著，进来龙马每教骑。",
        "长承密旨归家少，独奏边机出殿迟。",
        "自是姓同亲向说，九重争得外人知。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 262297,
      "title": "早秋过龙武李将军书斋",
      "content": [
        "高树蝉声秋巷里，朱门冷静似闲居。",
        "重装墨画数茎竹，长著香薰一架书。",
        "语笑侍儿知礼数，吟哦野客任狂疎。",
        "就中爱读英雄传，欲立功勋恐不如。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 262298,
      "title": "江陵即事",
      "content": [
        "瘴云梅雨不成泥，十里津楼压大堤。",
        "蜀女下沙迎水客，巴童傍驿卖山鸡。",
        "寺多红药烧人眼，地足青苔染马蹄。",
        "夜半独眠愁在远，北看归路隔蛮溪。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 262299,
      "title": "题花子赠渭州陈判官",
      "content": [
        "腻如云母轻如粉，艳胜香黄薄胜蝉。",
        "点绿斜蒿新叶嫩，添红石竹晚花鲜。",
        "鸳鸯比翼人初帖，蛱蝶重飞样未传。",
        "况复萧郎有情思，可怜春日镜台前。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 262300,
      "title": "送从姪拟赴江陵少尹",
      "content": [
        "江陵少尹好闲官，亲故皆来劝自宽。",
        "无事日长贫不易，有才年少屈终难。",
        "沙头欲买红螺盏，渡口多呈白角盘。",
        "应向章华台下醉，莫冲云雨夜深寒。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 262301,
      "title": "华清宫感旧",
      "content": [
        "尘到朝元边使急，千官夜发六龙回。",
        "辇前月照罗衫泪，马上风吹蜡烛灰。",
        "公主妆楼金锁涩，贵妃汤殿玉莲开。",
        "有时云外闻天乐，知是先皇沐浴来。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 262302,
      "title": "九仙公主旧庄",
      "content": [
        "仙居五里外门西，石路亲回御马蹄。",
        "天使来栽宫里树，罗衣自买院前溪。",
        "野牛行傍浇花井，本主分将灌药畦。",
        "楼上凤皇飞去后，白云红叶属山鸡。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 262303,
      "title": "郭家溪亭",
      "content": [
        "高亭望见长安树，春草冈西旧院斜。",
        "光动绿烟遮岸行，粉开红艳塞溪花。",
        "野泉闻洗亲王马，古柳曾停贵主车。",
        "妆阁书楼倾侧尽，云山新卖与官家。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 262304,
      "title": "题金家竹溪",
      "content": [
        "少年因病离天仗，乞得归家自养身。",
        "买断竹溪无别主，散分泉水与新邻。",
        "山头鹿下长惊犬，池面鱼行不怕人。",
        "乡使到来常欵语，还闻世上有功臣。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 262305,
      "title": "题应圣观",
      "content": [
        "精思堂上画三身，回作仙宫度美人。",
        "赐额御书金字贵，行香天乐羽衣新。",
        "空廊鸟啄花甎缝，小殿虫缘玉像尘。",
        "头白女冠犹说得，蔷薇不似已前春。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 262306,
      "title": "同于汝锡游降圣观",
      "content": [
        "秦时桃树满山坡，骑鹿先生降大罗。",
        "路尽溪头逢地少，门连内里见天多。",
        "荒泉坏简朱砂暗，古塔残经篆字讹。",
        "闻说开元斋醮日，晓移行漏帝亲过。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 262307,
      "title": "逍遥翁溪亭",
      "content": [
        "逍遥翁在此裴回，帝改溪名起石台。",
        "车马到春常借问，子孙因选暂归来。",
        "稀疎野竹人移折，零落蕉花雨打开。",
        "无主青山何所直，卖供官税不如灰。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 262308,
      "title": "寻李山人不遇",
      "content": [
        "山客长须少在时，溪中放鹤洞中碁。",
        "生金有气寻还远，仙药成窠见即移。",
        "莫为无家陪寺食，应缘将米寄人炊。",
        "从头石上留名去，独向南峰问老师。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 262309,
      "title": "题石瓮寺",
      "content": [
        "青崖白石夹城东，泉脉钟声内里通。",
        "地压龙蛇山色别，屋连宫殿匠名同。",
        "簷灯经夏纱笼黑，溪叶先秋腊树红。",
        "天子亲题诗总在，画扉长鏁碧龛中。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 262310,
      "title": "早登西禅寺阁",
      "content": [
        "上方台殿第三层，朝壁红窗日气凝。",
        "烟雾开时分远寺，山川晴处见崇陵。",
        "沙湾漾水图新粉，绿野荒阡晕色缯。",
        "莫说城南月灯阁，自诸楼看总难胜。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 262311,
      "title": "题江寺兼求药子",
      "content": [
        "隋朝旧寺楚江头，深谢师僧引客游。",
        "空赏野花无过夜，若看琪树即须秋。",
        "红珠落地求谁与，青角垂阶自不收。",
        "愿乞野人三两粒，归家将助小庭幽。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 262312,
      "title": "题诜法师院",
      "content": [
        "三年说戒龙宫里，巡礼还来向水行。",
        "多爱贫穷人远请，长修破落寺先成。",
        "秋天盆底新荷色，夜地房前小竹声。",
        "僧院不求诸处好，转经唯有一窗明。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 262313,
      "title": "酬于汝锡晓雪见寄",
      "content": [
        "欲明天色白漫漫，打叶穿帘雪未干。",
        "薄落堦前人踏尽，差池树里鸟衔残。",
        "旋销迎暖沾墙少，斜舞遮春到地难。",
        "劳动更裁新样绮，红灯一夜剪刀寒。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 262314,
      "title": "从军后寄山中友人",
      "content": [
        "爱仙无药住溪贫，脱却山衣事汉臣。",
        "夜半听鸡梳白发，天明走马入红尘。",
        "村童近去嫌腥食，野鹤高飞避俗人。",
        "劳动先生远相示，别来弓箭不离身。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 262315,
      "title": "寄汴州令狐相公",
      "content": [
        "三军江口拥双旌，虎帐长开自教兵。",
        "机鏁恶徒狂寇尽，恩驱老将壮心生。",
        "水门向晚茶商闹，桥市通宵酒客行。",
        "秋日梁王池阁好，新歌散入管弦声。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 262316,
      "title": "别李赞侍御",
      "content": [
        "同受艰难骠骑营，半年中听揭枪声。",
        "草头送酒驱村乐，贼里看花著探兵。",
        "讲易工夫寻已圣，说诗门户别来情。",
        "荐书自入无消息，卖尽寒衣却出城。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 262317,
      "title": "和蒋学士新授章服",
      "content": [
        "五色箱中绛服春，笏花成就白鱼新。",
        "看宣赐处惊回眼，著谢恩时便称身。",
        "瑞草唯承天上露，红鸾不受世间尘。",
        "翰林同贺文章出，惊动茫茫下界人。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 262318,
      "title": "岁晚自感",
      "content": [
        "人皆欲得长年少，无那排门白发催。",
        "一向破除愁不尽，百方回避老须来。",
        "草堂未办终须置，松树难成亦且栽。",
        "沥酒愿从今日后，更逢二十度花开。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 262319,
      "title": "昭应官舍",
      "content": [
        "痴顽终日羡人闲，却喜因官得近山。",
        "斜对寺楼分寂寂，远从溪路借潺潺。",
        "眇身多病唯亲药，空院无钱不要关。",
        "文案把来看未会，虽书一字甚慙颜。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 262320,
      "title": "寄旧山僧",
      "content": [
        "因依老宿发心初，半学修心半读书。",
        "雪后每常同席卧，花时未省两山居。",
        "猎人箭底求伤雁，钓户竿头乞活鱼。",
        "一向风尘取烦恼，不知衰病日难除。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 262321,
      "title": "武陵春日",
      "content": [
        "寻春何事却悲凉，春到他乡忆故乡。",
        "秦女洞桃欹涧碧，楚王堤柳舞烟黄。",
        "波涛入梦家山远，名利关身客路长。",
        "不似冥心叩尘寂，玉编金轴有仙方。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 262322,
      "title": "寄分司张郎中",
      "content": [
        "一别京华年岁久，卷中多见岭南诗。",
        "声名已压众人上，愁思未平双鬓知。",
        "江郡迁移犹远地，仙官荣庞是分司。",
        "青天白日当头上，会有求闲不得时。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 262323,
      "title": "上武元衡相公",
      "content": [
        "旌旗坐镇蜀江雄，帝命重开旧合崇。",
        "襃贬唐书天历上，捧持尧日庆云中。",
        "孤情逈出鸾皇远，健思潜搜海岳空。",
        "长得萧何为国相，自西流水尽朝宗。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 262324,
      "title": "上张弘靖相公",
      "content": [
        "传封三世尽河东，家占中条第一峰。",
        "旱岁天教作霖雨，明时帝用补山龙。",
        "草开旧路沙痕在，日照新池凤迹重。",
        "卑散自知霄汉隔，若为门下赐从容。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 262325,
      "title": "上裴度舍人",
      "content": [
        "小松双对凤池开，履迹衣香逼上台。",
        "天意皆从彩毫出，宸心尽向紫烟来。",
        "非时玉案呈宣旨，每日金堦谢赐回。",
        "仙侣何因记名姓，县丞头白走尘埃。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 262326,
      "title": "上杜元颖相公",
      "content": [
        "学士金銮殿后居，天中行坐侍龙舆。",
        "承恩不许离床谢，密诏常教倚案书。",
        "马上唤遮红觜鸭，船头看钓赤鳞鱼。",
        "闲曹散吏无相识，犹记荆州拜谒初。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 262327,
      "title": "赠卢汀谏议",
      "content": [
        "青蛾不得在床前，空室焚香独自眠。",
        "功证诗篇离景象，药成官位属神仙。",
        "闲过寺观长冲夜，立送封章直上天。",
        "近见兰台诸吏说，御诗新集未教传。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 262328,
      "title": "贺杨巨源博士拜虞部员外",
      "content": [
        "合归兰署已多时，上得金梯亦未迟。",
        "两省郎官开道路，九州山泽属曹司。",
        "诸生拜别收书卷，旧客看来读制词。",
        "残著几丸仙药在，分张还遣病夫知。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 262329,
      "title": "赠郭将军",
      "content": [
        "承恩新拜上将军，当直巡更近五云。",
        "天下表章经院过，宫中语笑隔墙闻。",
        "密封计策非时奏，别赐衣裳到处薰。",
        "向晚临堦看号簿，眼前风景任支分。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 262330,
      "title": "赠田将军",
      "content": [
        "初从学院别先生，便领偏师得战名。",
        "大小独当三百阵，纵横祗用五千兵。",
        "回残匹帛归天库，分好旌旗入禁营。",
        "自执金吾长上直，蓬莱宫里夜巡更。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 262331,
      "title": "赠胡泟将军",
      "content": [
        "书生难得是金吾，近日登科记总无。",
        "半夜进傩当玉殿，未明排仗到铜壶。",
        "朱牌面上分官契，黄纸头边押勅符。",
        "恐要蕃中新道路，指挥重画五城图。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 262332,
      "title": "留别田尚书",
      "content": [
        "拟报平生未杀身，难离门馆起居频。",
        "不看匣里钗头古，犹恋机中锦样新。",
        "一旦甘为漳岸老，全家却作杜陵人。",
        "朝天路在骊山下，专望红旗拜旧尘。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 262333,
      "title": "送唐大夫罢节归山",
      "content": [
        "年少平戎老学仙，表求骸骨乞生全。",
        "不堪腰下悬金印，已向云西寄玉田。",
        "旄节抱归官路上，公卿送到国门前。",
        "人间鸡犬同时去，遥听笙歌隔水烟。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 262334,
      "title": "送司空神童",
      "content": [
        "杏花坛上授书时，不废中庭趂蝶飞。",
        "暗写五经收部秩，初年七岁著衫衣。",
        "秋堂白发先生别，古巷青襟旧伴归。",
        "独向凤城持荐表，万人丛里有光辉。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 262335,
      "title": "送振武张尚书",
      "content": [
        "回天转地是将军，扶助春宫上五云。",
        "抚背恩虽同骨肉，拥旄名未敌功勋。",
        "尽收壮勇填兵数，不向蕃浑夺马群。",
        "闲即单于台下猎，威声直到海西闻。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 262336,
      "title": "送吴谏议上饶州",
      "content": [
        "鄱阳太守是真人，琴在床头箓在身。",
        "曾向先皇边谏事，还应上帝处称臣。",
        "养生自有年支药，税户应停月进银。",
        "净扫水堂无侍女，下街唯共鹤殷勤。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 262337,
      "title": "赠阎少保",
      "content": [
        "髭须虽白体轻健，九十三来却少年。",
        "问事爱知天宝里，识人皆是武皇前。",
        "玉装劒珮身长带，绢写方书子不传。",
        "侍女常时教合药，亦闻私地学求仙。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 262338,
      "title": "送魏州李相公",
      "content": [
        "百代功勋一日成，三年五度换双旌。",
        "闲来不对人论战，难处长先自请行。",
        "旗下可闻诛败将，阵头多是用降兵。",
        "当朝面受新恩去，算料妖星不敢生。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 262339,
      "title": "赠索暹将军",
      "content": [
        "浑身著箭瘢犹在，万槊千刀总过来。",
        "轮劒直冲生马队，抽旗旋踏死人堆。",
        "闻休鬬战心还痒，见说烟尘眼即开。",
        "泪滴先皇堦下土，南衙班里趁朝回。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 262340,
      "title": "赠王屋道士赴诏",
      "content": [
        "玉皇符诏下天坛，玳瑁头簪白角冠。",
        "鹤遣院中童子养，鹿凭山下老人看。",
        "法成不怕刀枪利，体实常欺石榻寒。",
        "能断世间腥血昧，长生只要一丸丹。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 262341,
      "title": "赠王处士",
      "content": [
        "松树当轩雪满地，青山掩障碧纱幮。",
        "鼠来案上常偷水，鹤在床前亦看碁。",
        "道士写将行气法，家童授与步虚词。",
        "世间有似君应少，便乞从今作我师。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 262342,
      "title": "洛中张籍新居",
      "content": [
        "最是城中闲静处，更回门向寺前开。",
        "云山且喜重重见，亲故应须得得来。",
        "借倩学生排药合，留连处士乞松栽。",
        "自君移到无多日，墙上人名满绿苔。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 262343,
      "title": "题裴处士碧虚溪居",
      "content": [
        "鸟声真似深山里，平地人间自不同。",
        "春圃紫芹长卓卓，暖泉青草一丛丛。",
        "松台前后花皆别，竹崦高低水尽通。",
        "细问来时从近远，溪名载入县图中。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 262344,
      "title": "送阿史那将军安西迎旧使灵榇",
      "content": [
        "汉家都护边头没，旧将麻衣万里迎。",
        "阴地背行山下火，风天错到碛西城。",
        "单于送葬还垂泪，部曲招魂亦道名。",
        "却入杜陵秋巷里，路人来去读铭旌。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 262345,
      "title": "赠崔礼驸马",
      "content": [
        "凤皇楼阁连宫树，天子崔郎自爱贫。",
        "金埒减添栽药地，玉鞭平与卖书人。",
        "家中弦管听常少，分外诗篇看即新。",
        "一月一回陪内宴，马蹄犹压踏香尘。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 262346,
      "title": "赠太清卢道士",
      "content": [
        "上清道士未升天，南岳中华作散仙。",
        "书卖八分通字学，丹烧九转定人年。",
        "修行近日形如鹤，导引多时骨似绵。",
        "想向诸山寻礼遍，却回还守老君前。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 262347,
      "title": "送宫人入道",
      "content": [
        "休梳丛鬓洗红妆，头戴芙蓉出未央。",
        "弟子抄将歌遍叠，宫人分散舞衣裳。",
        "问师初得经中字，入静犹烧内里香。",
        "发愿蓬莱见王母，却归人世施仙方。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 262348,
      "title": "上李吉甫相公",
      "content": [
        "圣朝齐贺说逢殷，霄汉无云日月真。",
        "金鼎调和天膳美，瑶池沐浴赐衣新。",
        "两河开地山川正，四海休兵造化仁。",
        "曾向山东为散吏，当今窦宪是贤臣。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 262349,
      "title": "上李益庶子",
      "content": [
        "紫烟楼阁碧纱亭，上界诗仙独自行。",
        "奇险驱回还寂寞，云山经用始鲜明。",
        "藕绡纹缕裁来滑，镜水波涛滤得清。",
        "昏思愿因秋露洗，幸容堦下礼先生。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 262350,
      "title": "题元郎中新宅",
      "content": [
        "近移松树初栽药，经帙书签一切新。",
        "铺设暖房迎道士，支分闲院著医人。",
        "买来高石虽然贵，入得朱门未免贫。",
        "惟有好诗名字出，倍教年少损心神。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 262351,
      "title": "初授太府丞言怀",
      "content": [
        "除书亦下属微班，唤作官曹便不闲。",
        "检案事多关市井，听人言志在云山。",
        "病童唤著唯行慢，老马鞭多转放顽。",
        "此去仙宫无一里，遥看松树众家攀。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 262352,
      "title": "赠李愬仆射",
      "content": [
        "唐州将士死生同，尽逐双旌旧镇空。",
        "独破淮西功业大，新除陇右世家雄。",
        "知时每笑论兵法，识势还轻立战功。",
        "次第各分茅土贵，殊勋并在一门中。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 262353,
      "title": "书赠旧浑二曹长",
      "content": [
        "二年同在华清下，入县门中最近邻。",
        "替饮觥筹知户小，助成书屋见家贫。",
        "夜碁临散停分客，朝浴先回各送人。",
        "僮仆使来传语熟，至今行酒校殷勤。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 262354,
      "title": "上崔相公",
      "content": [
        "枯桂衰兰一遍春，唯将道德定君臣。",
        "施行圣泽山川润，图画天文彩色新。",
        "开阁覆看祥瑞历，封名直进薜萝人。",
        "应怜老病无知己，自别溪中满鬓尘。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 262355,
      "title": "寄杨十二秘书",
      "content": [
        "初移古寺正南方，静是浮山远是庄。",
        "人定犹行背街鼓，月高还去打僧房。",
        "新诗欲写中朝满，旧卷常抄外国将。",
        "闲出天门醉骑马，可怜蓬阁秘书郎。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 262356,
      "title": "谢田赞善见寄",
      "content": [
        "五侯三任未相称，头白如丝作县丞。",
        "错判符曹群吏笑，乱书岩石一山憎。",
        "自知酒病衰肠怯，遥怕春残百鸟凌。",
        "年少力生犹不敌，况加顦顇闷腾腾。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 262357,
      "title": "晚秋病中",
      "content": [
        "万事风吹过耳轮，贫儿活计亦曾闻。",
        "偶逢新语书红叶，难得闲人话白云。",
        "霜下野花浑著地，寒来溪鸟不成群。",
        "病多体痛无心力，更被头边药气熏。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 262358,
      "title": "薛二十池亭",
      "content": [
        "每个树边消一日，遶池行匝又须行。",
        "异花多是非时有，好竹皆当要处生。",
        "斜竖小桥看岛势，远移山石作泉声。",
        "浮萍著岸风吹歇，水面无尘晚更清。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 262359,
      "title": "故梁国公主池亭",
      "content": [
        "平阳池馆枕秦川，门锁南山一朵烟。",
        "素柰花开西子面，绿榆枝散沈郎钱。",
        "装簷玳瑁随风落，傍岸䴔䴖逐暖眠。",
        "寂寞空余歌舞地，玉箫声绝凤归天。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 262360,
      "title": "题柱国寺",
      "content": [
        "皇帝施钱修此院，半居天上半人间。",
        "丹梯暗出三重阁，古像斜开一面山。",
        "松柏自穿空地少，川原不税小僧闲。",
        "行香天使长相续，早起离城日午还。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 262361,
      "title": "昭应官舍书事",
      "content": [
        "县在华清宫北面，晓看楼殿正相当。",
        "庆云出处依时报，御果呈来每度尝。",
        "腊月近汤泉不冻，夏天临渭屋多凉。",
        "两衙早被官拘束，登阁巡溪亦属忙。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 262362,
      "title": "昭应李郎中见贻佳作次韵奉酬",
      "content": [
        "窗户风凉四面开，陶公爱晚上高台。",
        "中庭不热青山入，野水初晴白鸟来。",
        "静思道心缘境熟，麤疎文字见诗回。",
        "诸生围遶新篇读，玉阙仙宫少此才。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 262363,
      "title": "闲说",
      "content": [
        "桃花百叶不成春，鹤寿千年也未神。",
        "秦陇州缘鹦鹉贵，王侯家为牡丹贫。",
        "歌头舞遍回回别，鬓样眉心日日新。",
        "鼓动六街骑马出，相逢总是学狂人。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 262364,
      "title": "自伤",
      "content": [
        "衰门海内几多人，满眼公卿总不亲。",
        "四授官资元七品，再经婚娶尚单身。",
        "图书亦为频移尽，兄弟还因数散贫。",
        "独自在家长似客，黄昏哭向野田春。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 262365,
      "title": "田侍中宴席",
      "content": [
        "香熏罗幕暖成烟，火照中庭烛满筵。",
        "整顿舞衣呈玉腕，动摇歌扇露金钿。",
        "青蛾侧座调双管，彩凤斜飞入五弦。",
        "虽是沂公门下客，争将肉眼看云天。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 262366,
      "title": "寒食日看花",
      "content": [
        "早入公门到夜归，不因寒食少闲时。",
        "颠狂遶树猿离鏁，跳踯缘冈马断羁。",
        "酒污衣裳从客笑，醉饶言语觅花知。",
        "老来自喜身无事，仰面西园得咏诗。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 262367,
      "title": "和少府崔卿微雪早朝",
      "content": [
        "蓬莱春雪晓犹残，点地成花遶百官。",
        "已傍祥鸾迷殿角，还穿瑞草入袍襕。",
        "无多白玉阶前湿，积渐青松叶上干。",
        "粉画南山棱郭出，初晴一半隔云看。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 262368,
      "title": "和胡将军寓直",
      "content": [
        "宫鸦栖定禁枪攒，楼殿深严月色寒。",
        "进状直穿金戟槊，探更先傍玉钩栏。",
        "漏传五点班初合，鼓动三声仗已端。",
        "遥见正南宣不坐，新栽松树唤人看。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 262369,
      "title": "春日五门西望",
      "content": [
        "百官朝下五门西，尘起春风过玉堤。",
        "黄帕盖鞍呈了马，红罗系项鬬回鸡馆松枝重墙头出，御柳条长水面齐。",
        "唯有教坊南草绿，古苔阴地冷凄凄。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 262370,
      "title": "长安早春",
      "content": [
        "霏霏漠漠遶皇州，销雪欺寒不自由。",
        "先向红妆添晓梦，争来白发送新愁。",
        "暖催衣上缝罗胜，晴报窗中点彩毬。",
        "每度暗来还暗去，今年须遣蝶迟留。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 262371,
      "title": "早春病中",
      "content": [
        "日日春风阶下起，不吹光彩上寒株。",
        "师教绛服禳衰月，妻许青衣侍病夫。",
        "健羡人家多力子，祈求道士有神符。",
        "世间方法从谁问，卧处还看药草图。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 262372,
      "title": "上阳宫",
      "content": [
        "上阳花木不曾秋，洛水穿宫处处流。",
        "画阁红楼宫女笑，玉箫金管路人愁。",
        "幔城入涧橙花发，玉辇登山桂叶稠。",
        "曾读列仙王母传，九天未胜此中游。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 262373,
      "title": "李处士故居",
      "content": [
        "露浓烟重草萋萋，树映阑干柳拂堤。",
        "一院落花无客醉，半窗残月有莺啼。",
        "芳筵想像情难尽，故榭荒凉路欲迷。",
        "风景宛然人自改，却经门外马频嘶。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 262374,
      "title": "寄贾岛",
      "content": [
        "尽日吟诗坐忍饥，万人中觅似君稀。",
        "僮眠冷榻朝犹卧，驴放秋田夜不归。",
        "傍暖旋收红落叶，觉寒犹著旧生衣。",
        "曲江池畔时时到，为爱鸬鹚雨后飞。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 262375,
      "title": "村居即事",
      "content": [
        "休看小字大书名，向日持经眼却明。",
        "时过无心求富贵，身闲不梦见公卿。",
        "因寻寺里薰辛断，自别城中礼数生。",
        "斜月照房新睡觉，西峰半夜鹤来声。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 262376,
      "title": "维扬冬末寄幕中二从事",
      "content": [
        "江上数株桑枣树，自从离乱更荒凉。",
        "那堪旅馆经残腊，秪把空书寄故乡。",
        "典尽客衣三尺雪，炼精诗句一头霜。",
        "故人多在芙蓉幕，应笑孜孜道未光。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 262377,
      "title": "寄杜侍御",
      "content": [
        "何须服药觅升天，粉阁为郎即是仙。",
        "买宅但幽从索价，栽松取活不争钱。",
        "退朝寺里寻荒塔，经宿城南看野泉。",
        "道气清凝分晓爽，诗情冷瘦滴秋鲜。",
        "学通儒释三千卷，身拥旌旗二十年。",
        "春巷偶过同户饮，暖窗时与对床眠。",
        "破除心力缘书癖，伤瘦花枝为酒颠。",
        "今日总来归圣代，丈人先达幸相怜。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 262378,
      "title": "寄上韩愈侍郎",
      "content": [
        "重登大学领儒流，学浪词锋压九州。",
        "不以雄名疎野贱，唯将直气折王侯。",
        "咏伤松桂青山瘦，取尽珠玑碧海愁。",
        "敍述异篇经总别，鞭驱险句最先投。",
        "碑文合遣贞魂谢，史笔应令谄骨羞。",
        "清俸探将还酒债，黄金旋得起书楼。",
        "参来拟设官人礼，朝退多逢月阁游。",
        "见说云泉求住处，若无知荐一生休。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 262379,
      "title": "赠华州郑大夫",
      "content": [
        "此官出入凤池头，通化门前第一州。",
        "少华山云当驿起，小敷溪水入城流。",
        "空闲地内人初满，词讼牌前草渐稠。",
        "报状拆开知足雨，赦书宣过喜无囚。",
        "自来不说双旌贵，恐替长教百姓愁。",
        "公退晚凉无一事，步行携客上南楼。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 262380,
      "title": "寄贺田侍中东平功成",
      "content": [
        "使回高品满城传，亲见沂公在阵前。",
        "百里旗幡冲即断，两重衣甲射皆穿。",
        "探知点检兵应怯，算得新移栅未坚。",
        "营被数惊乘势破，将经频败遂生全。",
        "密招残寇防人觉，遥斩元凶恐自专。",
        "首让诸军无敢近，功归部曲不争先。",
        "开通州县斜连海，交割山河直到燕。",
        "战马散驱还逐草，肉牛齐散却耕田。",
        "府中独拜将军贵，门下兼分宰相权。",
        "唐史上头功第一，春风双节好朝天。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 262381,
      "title": "送裴相公上太原",
      "content": [
        "还携堂印向幷州，将相兼权是武侯。",
        "时难独当天下事，功成却进手中筹。",
        "再三陈乞罏烟里，前后封章玉案头。",
        "朱架早朝立劒戟，绿槐残雨看张油。",
        "遥知塞雁从今好，直得渔阳已北愁。",
        "边铺警巡旗尽换，山城候馆壁重修。",
        "千群白刃兵迎节，十对红妆妓打毬。",
        "圣主分明交暂去，不须高起见京楼。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 262382,
      "title": "题栢岩禅师影堂",
      "content": [
        "山中砖塔闭，松下影堂新。",
        "恨不生前识，今朝礼画身。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 262383,
      "title": "送人",
      "content": [
        "河亭收酒器，语尽各西东。",
        "回首不相见，行车秋雨中。"
      ],
      "author": {
        "id": 8985,
