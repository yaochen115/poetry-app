{
  "data": [
    {
      "id": 79222,
      "title": "西斋小饮赠别陜州冲卿学士",
      "content": [
        "今日胡不乐，众宾会高堂。",
        "坐中瀛洲客，新佩太守章。",
        "岂无芳罇酒，笑语共一觞。",
        "亦有嘉菊丛，新苞弄微黄。",
        "所嗟时易晚，节物已凄凉。",
        "群鹭方盛集，离鸿独高翔。",
        "山川正摇落，行李怯风霜。",
        "君子乐为政，朝廷须俊良。",
        "归来紫微阁，遗爱在甘棠。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 79223,
      "title": "奉答原甫九月八日见过会饮之作",
      "content": [
        "老大惜时节，少年轻别离。",
        "我歌君当和，我酌君勿辞。",
        "艳艳庭下菊，与君吟绕之。",
        "撷其黄金蕊，泛此白玉巵。",
        "君勿爱此花，问君此何时。",
        "秋风日益高，霜露渐离披。",
        "芳岁忽已晚，朱颜从此衰。",
        "念君将舍我，车马去有期。",
        "君行一何乐，我意独不怡。",
        "飞兔不恋群，奔风谁能追。",
        "老骥但伏枥，壮心良可悲。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 79224,
      "title": "予作归鴈亭于滑州后十有五年梅公仪来守是邦因取余诗刻于石又以长韵见寄因以答之",
      "content": [
        "风吹城头秋草黄，仰见鸣鴈初南翔。",
        "秋草风吹春复绿，南鴈北飞声肃肃。",
        "城下台边桃李蹊，忆初披荒手植之。",
        "雪消冰解草木动，因记鸿鴈将归时。",
        "尔来十载空遗迹，飞鴈年年自南北。",
        "台倾余址草荒凉，树老无花春寂历。",
        "东州太守诗尤美，组织文章烂如绮。",
        "长篇大句琢方石，一日都城传百纸。",
        "我思古人无不然，慷慨功名垂百年。",
        "沉碑身后念陵谷，把酒泣下悲山川。",
        "一时留赏虽邂逅，后世传之因不朽。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 79225,
      "title": "寄题洛阳致政第少卿静居堂",
      "content": [
        "洛人皆种花，花发有时阑。",
        "君家独种玉，种玉产琅玕。",
        "子弟守家法，名声耸朝端。",
        "岁时归拜庆，闾里亦相欢。",
        "西台有道气，自少服灵丸。",
        "春酒养眉寿，童颜如渥丹。",
        "清谈不倦客，妙思喜挥翰。",
        "壮也已吏隐，兴余方挂冠。",
        "临风想高谊，怀禄愧盘桓。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 79226,
      "title": "鬼车",
      "content": [
        "嘉祐六年秋，九月二十有八日，天愁无光月不出。",
        "浮云蔽天众星没，举手向空如抹漆。",
        "天昏地黑有一物，不见其形，但闻其声。",
        "其初切切凄凄，或高或低。",
        "乍似玉女调玉笙，众管参差而不齐。",
        "既而咿咿呦呦，若轧若抽。",
        "又如百两江州车，回轮转轴声哑呕。",
        "鸣机夜织锦江上，群鴈惊起芦花洲。",
        "吾谓此何声，初莫穷端由。",
        "老婢扑灯呼儿曹，云此怪鸟无匹俦。",
        "其名为鬼车，夜载百鬼凌空游。",
        "其声虽小身甚大，翅如车轮排十头。",
        "凡鸟有一口，其鸣已啾啾。",
        "此鸟十头有十口，口插一舌连一喉。",
        "一口出一声，千声百响更相酬。",
        "昔时周公居东周，厌闻此鸟憎若雠。",
        "夜呼庭氏率其属，弯弧俾逐出九州。",
        "射之三发不能中，天遣天狗从空投。",
        "自从狗啮一头落，断颈至今青血流。",
        "尔来相距三千秋，昼藏夜出如鸺鹠。",
        "每逢阴黑天外过，乍见火光惊辄堕。",
        "有时余血下点污，所遭之家家必破。",
        "我闻此语惊且疑，反祝疾飞无我祸。",
        "我思天地何茫茫，百物巨细理莫详。",
        "吉凶在人不在物，一蛇两头反为祥。",
        "却呼老婢炷灯火，卷帘开户清华堂。",
        "须臾云散众星出，夜静皎月流清光。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 79227,
      "title": "感二子",
      "content": [
        "黄河一千年一清，岐山鸣凤不再鸣。",
        "自从苏梅二子死，天地寂默收雷声。",
        "百虫坏户不启蛰，万木逢春不发萌。",
        "岂无百鸟解言语，喧啾终日无人听。",
        "二子精思极搜抉，天地鬼神无遁情。",
        "及其放笔骋豪俊，笔下万物生光荣。",
        "古人谓此觑天巧，命短疑为天公憎。",
        "昔时李杜争横行，麒麟凤凰世所惊。",
        "二物非能致太平，须时太平然后生。",
        "开元天宝物盛极，自此中原疲战争。",
        "英雄白骨化黄土，富贵何止浮云轻。",
        "唯有文章烂日星，气凌山岳常峥嵘。",
        "贤愚自古皆共尽，突兀空留后世名。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 79228,
      "title": "读书",
      "content": [
        "吾生本寒儒，老尚把书卷。",
        "眼力虽已疲，心意殊未倦。",
        "正经首唐虞，伪说起秦汉。",
        "篇章异句读，解诂及笺传。",
        "是非自相攻，去取在勇断。",
        "初如两军交，乘胜方酣战。",
        "当其旗鼓催，不觉人马汗。",
        "至哉天下乐，终日在几案。",
        "念昔始从师，力学希仕宦。",
        "岂敢取声名，惟期脱贫贱。",
        "忘食日已晡，燃薪夜侵旦。",
        "谓言得志后，便可焚笔砚。",
        "少偿辛苦时，惟事寝与饭。",
        "岁月不我留，一生今过半。",
        "中间尝忝窃，内外职文翰。",
        "官荣日清近，廪给亦丰羡。",
        "人情慎所习，酖毒比安宴。",
        "渐追时俗流，稍稍学营办。",
        "杯盘穷水陆，宾客罗俊彦。",
        "自从中年来，人事攻百箭。",
        "非惟职有忧，亦自老可叹。",
        "形骸苦衰病，心志迹退懦。",
        "前时可喜事，闭眼不欲见。",
        "惟寻旧读书，简编多朽断。",
        "古人重温故，官事幸有间。",
        "乃知读书勤，其乐固无限。",
        "少而干禄利，老用忘忧患。",
        "又知物贵久，至宝见百炼。",
        "纷华暂时好，俯仰浮云散。",
        "淡泊味愈长，始终殊不变。",
        "何时乞残骸，万一免罪谴。",
        "买书载舟归，筑室颍水岸。",
        "平生颇论述，铨次加点窜。",
        "庶几垂后世，不默死刍豢。",
        "信哉蠹书鱼，韩子语非讪。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 79229,
      "title": "鹎𫛥词",
      "content": [
        "龙楼凤阙鬰峥嵘，深宫不闻更漏声。",
        "红纱蜡烛愁夜短，绿窗鹎𫛥催天明。",
        "一声两声人渐起，金井辘轳闻汲水。",
        "三声四声促严粧，红靴玉带奉君王。",
        "万年枝软风露湿，上下枝间声转急。",
        "南衙促仗三卫列，九门放钥千官入。",
        "重城禁籞锁池台，此鸟飞从何处来。",
        "君不见颍河东岸村陂阔，山禽野鸟常嘲哳。",
        "田家惟听夏鸡声，夜夜垅头耕晓月。",
        "可怜此乐独吾知，眷恋君恩今白发。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 79230,
      "title": "初食鸡头有感",
      "content": [
        "六月京师暑雨多，夜夜南风吹芡嘴。",
        "凝祥池锁会灵园，仆射荒陂安可拟。",
        "争先园客采新苞，剖蚌得珠从海底。",
        "都城百物贵新鲜，厥价难酬与珠比。",
        "金盘磊落何所荐，滑台拨醅如玉醴。",
        "自慙窃食万钱厨，满口飘浮嗟病齿。",
        "却思年少在江湖，野艇高歌菱荇里。",
        "香新味全手自摘，玉洁沙磨软还美。",
        "一瓢固不羡玉鼎，万事适情为可喜。",
        "何时遂买颍东田，归去结茅临野水。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 79231,
      "title": "双井茶",
      "content": [
        "西江水清江石老，石上生茶如凤爪。",
        "穷腊不寒春气早，双井芽生先百草。",
        "白毛囊以红碧纱，十斤茶养一两芽。",
        "长安富贵五侯家，一啜犹须三日夸。",
        "宝云日注非不精，争新弃旧世人情。",
        "岂知君子有常德，至宝不随时变易。",
        "君不见建溪龙凤团，不改旧时香味色。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 79232,
      "title": "赠李士宁",
      "content": [
        "蜀狂士宁者，不邪亦不正。",
        "混世使人疑，诡谲非一行。",
        "平生不把笔，对酒时高咏。",
        "初如不著意，语出多奇劲。",
        "倾财解人难，去不道名姓。",
        "金钱买酒醉高楼，明月空床眠不醒。",
        "一身四海即为家，独行万里聊乘兴。",
        "既不采药卖都市，又不点石化黄金。",
        "进不干公卿，退不隐山林。",
        "与之游者但爱其人而莫见其术，安知其心。",
        "吾闻有道之士游心太虚，逍遥出入，常与道俱。",
        "故能入火不热，入水不濡。",
        "尝闻其语，而未见其人也，岂斯人之徒欤。",
        "不然言不纯师，行不纯德。",
        "而滑稽玩世，其东方朔之流乎。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 79233,
      "title": "明妃小引",
      "content": [
        "汉宫诸女严粧罢，共送明妃沟水头。",
        "沟上水声来不断，花随水去不回流。",
        "上马即知无返日，不须出塞始堪愁。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 79234,
      "title": "感事四首  其一",
      "content": [
        "老者觉时速，闲人知日长。",
        "日月本无情，人心有闲忙。",
        "努力取功名，断碑埋路傍。",
        "逍遥林下士，丘垅亦相望。",
        "长生既无药，浊酒且盈觞。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 79235,
      "title": "感事四首  其二",
      "content": [
        "空山一道士，辛苦学延龄。",
        "一旦随物化，反言仙已成。",
        "开坟见空棺，谓已超青冥。",
        "尸解如蛇蝉，换骨蜕其形。",
        "既云须变化，何不任死生。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 79236,
      "title": "感事四首  其三",
      "content": [
        "仙境不可到，谁知仙有无。",
        "或乘九斑虬，或驾五云车。",
        "朝倚扶桑枝，暮游昆仑墟。",
        "往来几万里，谁复遇诸涂。",
        "富贵不还乡，安事富贵欤。",
        "神仙人不见，魑魅与为徒。",
        "人生不免死，魂魄入幽都。",
        "仙者得长生，又云超太虚。",
        "等为不在世，与鬼亦何殊。",
        "得仙犹若此，何况不得乎。",
        "寄谢山中人，辛勤一何愚。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 79237,
      "title": "感事四首  其四",
      "content": [
        "莫笑学仙人，山中苦岑寂。",
        "试看青松鹤，何似朱门客。",
        "朱门炙手热，来者无时息。",
        "何尝问寒暑，岂暇谋寝食。",
        "彊颜悦憎怨，择语防仇敌。",
        "众欲苦无厌，有求期必获。",
        "敢辞一身劳，岂塞天下责。",
        "风波卒然起，祸患藏不测。",
        "神仙虽杳茫，富贵意何得。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 79238,
      "title": "新春有感寄常夷埔",
      "content": [
        "余生本羁孤，自少已非壮。",
        "今而老且病，何用苦惆怅。",
        "误蒙三圣知，贪得过其量。",
        "恩私未知报，心志已凋丧。",
        "轩裳德不称，徒自取讥谤。",
        "岂若常夫子，一瓢安陋巷。",
        "身虽草莽间，名在朝廷上。",
        "惟余服德义，久已慕恬旷。",
        "矧亦有吾庐，东西正相望。",
        "不须驾柴车，自可策蔾杖。",
        "坐惊颜鬓日摧颓，及取新春归去来。",
        "共载一舟浮野水，焦陂四面百花开。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 79239,
      "title": "升天桧",
      "content": [
        "青牛西出关，老聃始著五千言。",
        "白鹿去升天，尔来忽已三千年。",
        "当时遗迹至今在，隐起苍桧犹依然。",
        "惟能乘变化，所以为神仙。",
        "驱鸾驾鹤须臾间，飘忽不见如云烟。",
        "奈何此鹿起平地，更假草木相攀缘。",
        "乃知神仙事茫昧，真伪莫究徒自传。",
        "雪霜不改终古色，风雨有声当夏寒。",
        "境清物老自可爱，何必诡怪穷根源。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 79240,
      "title": "忆焦陂",
      "content": [
        "焦陂荷花照水光，未到十里闻花香。",
        "焦陂八月新酒熟，秋水鱼肥鲙如玉。",
        "清河两岸柳鸣蝉，直到焦陂不下船。",
        "笑向渔翁酒家保，金龟可解不须钱。",
        "明日君恩许归去，白头酣咏太平年。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 79241,
      "title": "赠许道人",
      "content": [
        "洛城三月乱鸎飞，颍阳山中花发时。",
        "徃来车马游山客，贪看山花踏山石。",
        "紫云仙洞锁云深，洞中有人人不识。",
        "飘飘许子旌阳后，道骨仙风本仙胄。",
        "多年洗耳避世喧，独卧寒岩听山溜。",
        "至人无心不算心，无心自得无穷寿。",
        "忽来顾我何慇懃，笑我白发老红尘。",
        "子归为筑岩前室，待我明年乞得身。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 79242,
      "title": "送龙茶与许道人",
      "content": [
        "颍阳道士青霞客，来似浮云去无迹。",
        "夜朝北斗太清坛，不道姓名人不识。",
        "我有龙团古苍璧，九龙泉深一百尺。",
        "凭君汲井试烹之，不是人间香味色。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 79243,
      "title": "驯鹿",
      "content": [
        "朝渴饮清池，暮饱眠深栅。",
        "慙媿主人恩，自非杀身难报德。",
        "主人施恩不待报，哀尔胡为网罗获。",
        "南山蔼蔼动春阳，吾欲纵尔山之傍。",
        "岩崖雪尽飞泉溜，涧谷风吹百草香。",
        "饮泉啮草当远去，山后山前射生户。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 79244,
      "title": "留题齐州舜泉",
      "content": [
        "岸有时而为谷，海有时而为田，虞舜已殁三千年。",
        "耕田浚井虽鄙事，至今遗迹存依然。",
        "历山之下有寒泉，向此号泣于旻天。",
        "无情草木亦改色，山川惨淡生云烟。",
        "一朝垂衣正南面，臯夔稷契来联翩。",
        "功高德大被万世，今人过此犹留连。",
        "齐州太守政之暇，凿渠开沼疏清涟。",
        "游车击毂惟恐后，众卉乱发如争先。",
        "岂徒邦人知乐此，行客亦为留征轩。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 79245,
      "title": "山斋戏书绝句二首  其一",
      "content": [
        "密脾未满蜂采花，麦垅已深鸠唤雨。",
        "正是山斋睡足时，不觉花间日亭午。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 79246,
      "title": "山斋戏书绝句二首  其二",
      "content": [
        "经春老病不出门，坐见群芳烂如雪。",
        "正当年少惜花时，日日春风吹石裂。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 79247,
      "title": "嘲少年惜花",
      "content": [
        "纷纷红蕊落泥沙，少年何用苦咨嗟。",
        "春风自是无情物，肯为汝惜无情花。",
        "今年花落明年好，但见花开人自老。",
        "人老不复少，花开还更新。",
        "使花如解语，应笑惜花人。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 79248,
      "title": "出郊见田家蚕麦已成慨然有感",
      "content": [
        "谁谓田家苦，田家乐有时。",
        "车鸣缫白茧，麦熟啭黄鹂。",
        "田家此乐几人知，幸独知之未许归。",
        "逢时得宠已逾分，报国无能徒尔为。",
        "收取玉堂挥翰手，却寻南亩把锄犁。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 79249,
      "title": "射生户",
      "content": [
        "射生户，前日献一豹，今日献一狼。",
        "豹因伤我牛，狼因食我羊。",
        "狼豹诚为害人物，县官赏之缣五匹。",
        "射生户，持缣归。",
        "为人除害固可赏，贪功趋利尔勿为。",
        "弦弓毒矢无妄发，恐尔不识麒麟儿。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 79250,
      "title": "戏石唐山隐者",
      "content": [
        "石唐仙室紫云深，颍阳真人此算心。",
        "真人已去升寥廓，岁岁岩花自开落。",
        "我昔曾为洛阳客，偶赂岩前坐盘石。",
        "四字丹书万仞崖，神清之洞锁楼台。",
        "云深路绝无人到，鸾鹤今应待我来。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 79251,
      "title": "送王汲宰蓝田",
      "content": [
        "喧喧动车马，共出古都门。",
        "落日催行客，东风吹酒罇。",
        "树摇秦甸绿，花入辋川繁。",
        "若遇西来旅，时应问故园。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 79252,
      "title": "徽安门晓望",
      "content": [
        "都门收宿雾，佳气鬰葱葱。",
        "晓日寒川上，青山白雾中。",
        "楼台万瓦合，车马九衢通。",
        "恨乏登高赋，徒知京邑雄。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 79253,
      "title": "送孟都官知蜀州",
      "content": [
        "名郎出粉闱，佳郡古关西。",
        "几驿秦亭尽，千山蜀鸟啼。",
        "朱轮照耕野，绿芋覆秋畦。",
        "向阙应东望，云深陇树迷。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 79254,
      "title": "南征回京至界上驿先呈城中诸友",
      "content": [
        "朝云来少室，日暮向箕山。",
        "本以无心出，宁随倦客还。",
        "春归伊水绿，花晚洛桥闲。",
        "谁有余罇酒，相期一解颜。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 79255,
      "title": "逸老亭",
      "content": [
        "上相此忘荣，怡然物外情。",
        "池光开小幌，山翠入重城。",
        "野鸟窥华衮，春壶劳耦耕。",
        "枕前双鴈没，雨外一川晴。",
        "解组金龟重，调琴赤鲤惊。",
        "虽怀安石趣，岂不为苍生。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 79256,
      "title": "庆爱寺",
      "content": [
        "都人布金地，绀宇岿然存。",
        "山气蒸经阁，钟声出国门。",
        "老杉春自绿，古壁雨先昏。",
        "应有幽人屐，来留石藓痕。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 79257,
      "title": "吊黄学士三首  其一",
      "content": [
        "丽正雠书久，兰台约史成。",
        "迎亲就江水，厌直出承明。",
        "世德无双誉，诗豪第一评。",
        "风流今顿尽，响像忆平生。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 79258,
      "title": "吊黄学士三首  其二",
      "content": [
        "沈约多清瘦，文园仍病痟。",
        "共疑天上召，更欲水边招。",
        "金马人相吊，长沙物易妖。",
        "秋风吹越树，归旐自飘飘。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 79259,
      "title": "吊黄学士三首  其三",
      "content": [
        "自古兰衰早，因令蕙叹深。",
        "书遗茂陵藁，病作越乡吟。",
        "蒿里无春色，闽山蔽夕阴。",
        "空嗟埋玉树，赍志永沉沉。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 79260,
      "title": "雨后独行洛北",
      "content": [
        "北阙望南山，明岚杂紫烟。",
        "归云向嵩岭，残雨过伊川。",
        "树绕芳隄外，桥横落照前。",
        "依依半荒苑，行处独闻蝉。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 79261,
      "title": "陪府中诸官游城南",
      "content": [
        "一雨郊圻迥，新秋榆枣繁。",
        "田荒溪溜入，禾熟雀声喧。",
        "烧出空槎腹，人耕废庙垣。",
        "闲追向城客，落日隐高原。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 79262,
      "title": "智蟾上人游南岳",
      "content": [
        "终日念云壑，南归心浩然。",
        "青山入楚路，白水望湖田。",
        "野渡惟浮钵，山家少施钱。",
        "到时春尚早，收茗绿岩前。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 79263,
      "title": "送左殿丞入蜀",
      "content": [
        "传闻蜀道难，行客若登天。",
        "紫竹深无路，黄花忽见川。",
        "闻禽嗟异域，问俗访耆年。",
        "欲识京都远，惟应望日边。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 79264,
      "title": "秋郊晓行",
      "content": [
        "寒郊桑柘稀，秋色晓依依。",
        "野烧侵河断，山鸦向日飞。",
        "行歌采樵去，荷锸刈田归。",
        "秫酒家家熟，相邀白竹扉。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 79265,
      "title": "被牒行县因书所见呈寮友",
      "content": [
        "周礼恤凶荒，轺车出四方。",
        "土龙朝祀雨，田火夜驱蝗。",
        "木落孤村迥，原高百草黄。",
        "乱鵶鸣古堞，寒雀聚空苍。",
        "桑野人行馌，鱼陂鸟下梁。",
        "晚烟茅店月，初日枣林霜。",
        "墐户催寒候，丛祠祷岁穰。",
        "不妨行览物，山水正苍茫。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 79266,
      "title": "缑氏县作",
      "content": [
        "亭候彻郊畿，人家岭坂西。",
        "青山临古县，绿竹绕寒溪。",
        "道上行收穗，桑间晚溉畦。",
        "东臯有深趣，便拟卜幽栖。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 79267,
      "title": "又行次作",
      "content": [
        "秋色满郊原，人行禾黍间。",
        "雉飞横断涧，烧响入空山。",
        "野水苍烟起，平林夕鸟还。",
        "嵩岚久不见，寒碧更孱颜。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 79268,
      "title": "送梅秀才归宣城",
      "content": [
        "从学方年少，还家罄橐金。",
        "久为江北客，能作洛生吟。",
        "罢亚霜前稻，钩辀竹上禽。",
        "归帆何处落，应拂野梅林。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 79269,
      "title": "巩县陪祭献懿二后回孝义桥道中作",
      "content": [
        "落日汉陵道，初寒惨暮飙。",
        "遥看山口火，暗渡洛川桥。",
        "不见新园树，空闻引葬箫。",
        "林鵶栖已定，犹此倦征镳。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 79270,
      "title": "送谢学士归阙",
      "content": [
        "供帐拂朝烟，征鞍去莫攀。",
        "人醒风外酒，马度雪中关。",
        "旧府谁同在，新年独未还。",
        "遥应行路者，偏识彩衣斑。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 79271,
      "title": "河南王慰西斋",
      "content": [
        "寒斋日萧索，天外敞簷楹。",
        "竹雪晴犹覆，山窗夜自明。",
        "禽归窥野客，云去入重城。",
        "欲就陶潜饮，应须载酒行。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 79272,
      "title": "第主簿东斋",
      "content": [
        "官舍掩寒扉，聊同隐者栖。",
        "溪流穿竹过，山鸟入城啼。",
        "宾主高谈胜，心冥外物齐。",
        "惟应朝枕梦，长厌隔邻鸡。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 79273,
      "title": "留守相公祷雨九龙祠应时获澍呈府中同寮",
      "content": [
        "古木鬰沉沉，祠亭相衮临。",
        "雷驱山外响，云结日边阴。",
        "霡霂来初合，依微势稍深。",
        "土膏潜动脉，野气欲成霖。",
        "陇上连云色，田间击壤音。",
        "明光应奏瑞，黄屋正焦心。",
        "帝邑三川美，离宫万瓦森。",
        "废沟鸣故苑，红蘤发青林。",
        "南亩犹须劝，余春尚可寻。",
        "应容后车客，时作洛生吟。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 79274,
      "title": "春日独游上林院后亭见樱桃花奉寄希深圣俞仍酬递中见寄之什",
      "content": [
        "昔日寻春地，今来感岁华。",
        "人行已荒径，花发半枯槎。",
        "高榭林端出，残阳水外斜。",
        "聊持一罇酒，徙倚忆天涯。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 79275,
      "title": "独至香山忆谢学士",
      "content": [
        "伊水弄春沙，山临水上斜。",
        "曾为谢公客，徧入梵王家。",
        "阴涧初生草，春岩自落花。",
        "却寻题石处，岁月已堪嗟。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 79276,
      "title": "春晚同应之偶至普明寺小饮作",
      "content": [
        "偶来林下迳，共酌竹间亭。",
        "积雨添方沼，残花点绿萍。",
        "野阴侵席润，芳气袭人醒。",
        "禽鸟休惊顾，都忘兀尔形。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 79277,
      "title": "黄河八韵寄呈圣俞",
      "content": [
        "河水激箭险，谁言航苇游。",
        "坚冰驰马渡，伏浪卷沙流。",
        "树落新摧岸，湍惊忽改洲。",
        "凿龙时退鲤，涨潦不分牛。",
        "万里通槎汉，千帆下漕舟。",
        "怨歌今罢筑，故道失难求。",
        "滩急风逾响，川寒雾不收。",
        "讵能穷禹迹，空欲问张侯。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 79278,
      "title": "和应之同年兄秋日雨中登广爱寺阁寄梅圣俞",
      "content": [
        "经年都洛与君交，共许诗中思最豪。",
        "旧社更谁能拥鼻，新秋有客独登高。",
        "径兰欲谢悲零露，篱菊空开乏冻醪。",
        "纵使河阳花满县，亦应留滞感潘毛。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 79279,
      "title": "晚过水北",
      "content": [
        "寒川消积雪，冻浦渐通流。",
        "日暮人归尽，沙禽上钓舟。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 79280,
      "title": "罢官西京回寄河南张主簿",
      "content": [
        "归客下三川，孤邮暂解鞍。",
        "鸟声催暮急，山气欲晴寒。",
        "已作愁霖咏，犹怀祖帐欢。",
        "更闻溪溜响，疑是石楼滩。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 79281,
      "title": "寄西京张法曹",
      "content": [
        "幕府三年客，群居几日亲。",
        "初分阙口路，犹见洛阳人。",
        "垅麦晴将秀，田花晚自介。",
        "向家行渐近，岂复倦征轮。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 79282,
      "title": "离彭婆值雨投临汝驿回寄张九屯田司录",
      "content": [
        "投馆野花边，羸骖晚不前。",
        "山桥断行路，溪雨涨春田。",
        "树冷无栖鸟，村深起暮烟。",
        "洛阳山已尽，休更望伊川。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 79283,
      "title": "朱家曲",
      "content": [
        "行人傍衰柳，路向古河穷。",
        "桑柘田畴美，渔商市井通。",
        "薪歌晚入浦，舟子夜乘风。",
        "旅舍孤烟外，天京王气中。",
        "山川许国近，风俗楚乡同。",
        "宿客鸡鸣起，驱车犹更东。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 79284,
      "title": "行至椹涧作",
      "content": [
        "霜后叶初鸣，羸骖遶涧行。",
        "川原人远近，禾黍日晴明。",
        "病质惊残岁，归涂厌暮程。",
        "空林聚寒雀，疑已作春声。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 79285,
      "title": "送谢希深学士北使",
      "content": [
        "汉使入幽燕，风烟两国间。",
        "山河持节远，亭障出疆闲。",
        "征马闻笳跃，雕弓向月弯。",
        "御寒低便面，赠客解刀环。",
        "鼓角云中垒，牛羊雪外山。",
        "穹庐鸣朔吹，冻酒发朱颜。",
        "寒草生侵碛，春榆绿满关。",
        "应须鴈北向，方值使南还。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 79286,
      "title": "送贾推官赴绛州",
      "content": [
        "白云汾水上，人北鴈南飞。",
        "行李山川远，风霜草木腓。",
        "郡斋宾榻挂，幕府羽书稀。",
        "最有题舆客，偏思玉麈挥。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 79287,
      "title": "送张如京知安肃军",
      "content": [
        "相逢旧从事，新命忽临戎。",
        "界上山河壮，军中彭角雄。",
        "朔风驰骏马，塞雪射惊鸿。",
        "试取封侯印，何如笔砚功。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 79288,
      "title": "送威胜军张判官",
      "content": [
        "北地不知春，惟看榆叶新。",
        "岑牟多武士，玉麈重嘉宾。",
        "野燐惊行客，烽烟入远尘。",
        "系书沙上鴈，时寄日边人。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 79289,
      "title": "送同年史褒之武功尉",
      "content": [
        "久作游边客，常悲入塞笳。",
        "今兹一尉远，犹困折腰嗟。",
        "白马关中道，青天栈外家。",
        "过秦应吊古，惟有故山斜。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 79290,
      "title": "送祝熙载之东阳主簿",
      "content": [
        "吴江通海浦，画舸候潮归。",
        "叠鼓山间响，高帆鸟外飞。",
        "孤城秋枕水，千室夜鸣机。",
        "试问还家客，辽东今是非。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 79291,
      "title": "郑十一先辈赴四明幕",
      "content": [
        "梁汉褒斜险，夫君畏远游。",
        "家临越山下，帆入海潮头。",
        "岸柳行稍尽，江莼归渐秋。",
        "故乡看衣锦，宁羡李膺舟。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 79292,
      "title": "送丁元珍峡州判官",
      "content": [
        "为客久南方，西游更异乡。",
        "江通蜀国远，山闭楚祠荒。",
        "油幕无军事，清猿断客肠。",
        "惟应陪主诺，不费日飞觞。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 79293,
      "title": "送楚建中颍州法曹",
      "content": [
        "冠盖盛西京，当年相府荣。",
        "曾陪鹿鸣宴，徧识洛阳生。",
        "共叹长沙讁，空存许劭评。",
        "堪嗟桃李树，何日见阴成。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 79294,
      "title": "送王尚恭隰州幕",
      "content": [
        "去国初游宦，从军苦寂寥。",
        "愁云带城起，画角向山飘。",
        "秋劲方驰马，春寒正袭貂。",
        "遥知为客恨，应赖酒杯消。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 79295,
      "title": "送王尚喆三原尉",
      "content": [
        "初仕便西辕，骊驹两佩环。",
        "山河识天府，风雨度函关。",
        "桑柘千畴富，人烟万井闲。",
        "欲为京洛咏，应苦簿书间。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 79296,
      "title": "送余姚陈寺丞",
      "content": [
        "铜墨佩腰间，中流望若仙。",
        "鸣蝉汴河柳，画鹢越乡船。",
        "下濑逢江鴈，瞻氛落海鸢。",
        "山川仍客思，尽入隐侯篇。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 79297,
      "title": "送廖八下第归衡山",
      "content": [
        "曾作关中客，尝窥百二疆。",
        "自言秦陇水，能断楚人肠。",
        "失意倦京国，羁愁成鬓霜。",
        "何如伴征鴈，日日向衡阳。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 79298,
      "title": "夏侯彦济武陟尉",
      "content": [
        "风烟地接怀，井邑富田垓。",
        "河近闻冰坼，山高见雨来。",
        "官闲同小隐，酒美足衔杯。",
        "好去东篱菊，迎霜正欲开。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 79299,
      "title": "远山",
      "content": [
        "山色无还近，看山终日行。",
        "峰峦随处改，行客不知名。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 79300,
      "title": "宋宣献公挽词三首  其一",
      "content": [
        "望系朝廷重，文推天下工。",
        "清名畏杨绾，故事问胡公。",
        "物议垂为相，风流顿已穷。",
        "仁言博哉利，献替有遗忠。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 79301,
      "title": "宋宣献公挽词三首  其二",
      "content": [
        "识度推明哲，风猷蔼缙绅。",
        "何言止中寿，遂不秉洪钧。",
        "翰墨时争宝，词章晚愈新。",
        "哭哀文伯母，悲感路傍人。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 79302,
      "title": "宋宣献公挽词三首  其三",
      "content": [
        "结发逢明主，驰声著两朝。",
        "奠楹先有梦，升屋岂能招。",
        "赠服三公衮，兼荣七叶貂。",
        "春风笳鼓咽，松栢助萧萧。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 79303,
      "title": "初出真州泛大江作",
      "content": [
        "孤舟日日去无穷，行色苍茫杳霭中。",
        "山浦转帆迷向背，夜江看斗辨西东。",
        "滮田渐下云间鴈，霜日初丹水上枫。",
        "莼菜鲈鱼方有味，远来犹喜及秋风。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 79304,
      "title": "江行赠鴈",
      "content": [
        "云间征鴈水间栖，矰缴方多羽翼微。",
        "岁晚江湖同是客，莫辞伴我更南飞。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 79305,
      "title": "松门",
      "content": [
        "岛屿松门数里长，悬崖对起碧峰双。",
        "可怜胜境当穷塞，翻使留人恋此邦。",
        "乱石惊滩喧醉枕，浅沙明月入船窗。",
        "因游始觉南来远，行尽荆江见蜀江。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 79306,
      "title": "下牢津",
      "content": [
        "依依下牢口，古戍鬰嵯峨。",
        "入峡江渐曲，转滩山更多。",
        "白沙飞白鸟，青障合青萝。",
        "迁客初经此，愁词作楚歌。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 79307,
      "title": "龙溪",
      "content": [
        "潺潺出乱峰，演漾绿萝风。",
        "浅濑寒难涉，危槎路不通。",
        "朝云起潭侧，飞雨徧江中。",
        "更欲寻源去，山深不可穷。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 79308,
      "title": "劳停驿",
      "content": [
        "孤舟转山曲，豁尔见平川。",
        "树杪帆初落，峰头月正圆。",
        "荒烟几家聚，瘦野一刀田。",
        "行客愁明发，惊滩鸟道前。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 79309,
      "title": "黄溪夜泊",
      "content": [
        "楚人自古登临恨，暂到愁肠已九回。",
        "万树苍烟三峡暗，满川明月一猿哀。",
        "非乡况复惊残岁，慰客偏宜把酒杯。",
        "行见江山且吟咏，不因迁谪岂能来。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 79310,
      "title": "望州坡",
      "content": [
        "闻说夷陵人为愁，共言迁客不堪游。",
        "崎岖几日山行倦，却喜坡头见峡州。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 79311,
      "title": "初至夷陵答苏子美见寄",
      "content": [
        "三峡倚岧峣，同迁地最遥。",
        "物华虽可爱，乡思独无聊。",
        "江水流青嶂，猿声在碧霄。",
        "野篁抽夏笋，丛橘长春条。",
        "未腊梅先发，经霜叶不凋。",
        "江云愁蔽日，山雾晦连朝。",
        "斫谷争收漆，梯林鬭摘椒。",
        "巴賨船贾集，蛮市酒旗招。",
        "时节同荆俗，民风载楚谣。",
        "俚歌成调笑，摖鬼聚喧嚣。",
        "得罪宜投裔，包羞分折腰。",
        "光阴催晏岁，牢落惨惊飙。",
        "白发新年出，朱颜异域销。",
        "县楼朝见虎，官舍夜闻鸮。",
        "寄信无秋鴈，思归望斗杓。",
        "须知千里梦，长绕洛川桥。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 79312,
      "title": "冬后三日陪丁元珍游东山寺",
      "content": [
        "幕府文书日已稀，清罇岁晏喜相携。",
        "寒山带郭穿松路，瘦马寻春踏雪泥。",
        "翠藓苍崖森古木，绿萝盘石暗深溪。",
        "为贪赏物来犹早，迎腊梅花吐未齐。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 79313,
      "title": "送前巫山宰吴殿丞",
      "content": [
        "俊域当年仰下风，天涯今日一罇同。",
        "高文落笔妙天下，清论挥犀服坐中。",
        "江上挂帆明月峡，云间谒帝紫微宫。",
        "山城寂寞少嘉客，喜见琼枝慰病翁。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 79314,
      "title": "龙兴寺小饮呈表臣元珍",
      "content": [
        "平日相从乐会文，博枭壶马占朋分。",
        "罚筹多似昆阳矢，酒令严于细柳军。",
        "蔽日雪云犹叆叇，欲晴花气渐氛氲。",
        "一罇万事皆毫末，蜾蠃螟蛉岂足云。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 79315,
      "title": "县舍不种花惟载楠木冬青茶竹之类因戏书七言四韵",
      "content": [
        "结绶当年仕两京，自怜年少体犹轻。",
        "伊川洛浦寻芳徧，魏紫姚黄照眼明。",
        "客思病来生白发，山城春至少红英。",
        "芳丛密叶聊须种，犹得萧萧听雨声。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 79316,
      "title": "至喜堂新开北轩手植楠木两株走笔呈元珍表臣",
      "content": [
        "为怜碧砌宜佳树，自𣃁苍苔选绿丛。",
        "不向芳菲趁开落，直须霜雪见青葱。",
        "披条泫转清晨露，响叶萧骚半夜风。",
        "时扫浓阴北窗下，一枰闲且伴衰弱。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 79317,
      "title": "戏答元珍",
      "content": [
        "春风疑不到天涯，二月山城未见花。",
        "残雪压枝犹有橘，冻雷惊笋欲抽芽。",
        "夜闻归鴈生乡思，病入新年感物华。",
        "曾是洛阳花下客，野芳虽晚不须嗟。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 79318,
      "title": "初晴独游东山寺五言六韵",
      "content": [
        "日暖东山去，松门数里斜。",
        "山林隐者趣，钟鼓梵王家。",
        "地僻迟春节，风晴变物华。",
        "云光渐容与，鸟哢已交加。",
        "冰下泉初动，烟中茗未芽。",
        "自怜多病客，来探欲开花。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 79319,
      "title": "夷陵岁暮书事呈元珍表臣",
      "content": [
        "萧条鸡犬乱山中，时节峥嵘忽已穷。",
        "游女髻鬟风俗古，野巫歌舞岁年丰。",
        "平时都邑今为陋，敌国江山昔最雄。",
        "荆楚先贤多胜迹，不辞携酒问邻翁。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 79320,
      "title": "夷陵书事寄谢三舍人",
      "content": [
        "春秋楚国西偏境，陆羽茶经第一州。",
        "紫箨青林长蔽日，绿丛红橘最宜秋。",
        "道涂处险人多负，邑屋临江俗善泅。",
        "腊市渔盐朝暂合，淫祠箫鼓岁无休。",
        "风鸣烧入空城响，雨恶江崩断岸流。",
        "月出行歌闻调笑，花开啼鸟乱钩辀。",
        "黄牛峡口经新岁，白玉京中梦旧游。",
        "曾是洛阳花下客，欲夸风物向君羞。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 79321,
      "title": "戏赠丁判官",
      "content": [
        "西陵江口折寒梅，争劝行人把一杯。",
        "须信春风无远近，维舟处处有花开。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    }
  ],
