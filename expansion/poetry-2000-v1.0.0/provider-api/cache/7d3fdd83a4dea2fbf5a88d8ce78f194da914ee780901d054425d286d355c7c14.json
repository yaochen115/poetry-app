{
  "data": [
    {
      "id": 273084,
      "title": "重入洛阳东门",
      "content": [
        "商颜重命伊川叟，时事知非入洛人。",
        "连野碧流通御苑，满阶秋草过天津。",
        "每惭清秩容衰齿，犹有华簪寄病身。",
        "驱马独归寻里巷，日斜行处旧红尘。"
      ],
      "author": {
        "id": 4777,
        "name": "李绅"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 273085,
      "title": "拜三川守",
      "content": [
        "恭承宠诏临伊洛，静守朝章化比闾。",
        "风变市儿惊偃草，雨晴郊薮谬随车。",
        "改张琴瑟移胶柱，止息笙篁辨鲁鱼。",
        "唯有从容期一德，使齐文教奉皇居。"
      ],
      "author": {
        "id": 4777,
        "name": "李绅"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 273086,
      "title": "庆云见",
      "content": [
        "礼成中岳陈金册，祥报卿云冠玉峰。",
        "轻未透林疑待凤，细非行雨讵从龙。",
        "卷风变彩霏微薄，照日笼光映隐重。",
        "还入九霄成沆瀣，夕岚生处鹤归松。"
      ],
      "author": {
        "id": 4777,
        "name": "李绅"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 273087,
      "title": "灵蛇见少林寺",
      "content": [
        "琐文结绶灵蛇降，蠖屈螭盘顾视闲。",
        "鳞蹙翠光抽璀璨，腹连金彩动弯环。",
        "已应蜕骨风雷后，岂効衔珠草莽间。",
        "知尔全身护昆阆，不矜挥尾在常山。"
      ],
      "author": {
        "id": 4777,
        "name": "李绅"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 273088,
      "title": "拜宣武军节度使",
      "content": [
        "油幢竝入虎旗开，锦橐从天凤诏来。",
        "星应魏师新鼓角，地嫌梁苑旧池台。",
        "日晖红斾分如电，人拥青门动若雷。",
        "伊洛镜清回首处，是非纷杂任尘埃。"
      ],
      "author": {
        "id": 4777,
        "name": "李绅"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 273089,
      "title": "到宣武三十韵",
      "content": [
        "七月趋梁苑，三年谢尹京。",
        "旧风除物蠹，新律奉师贞。",
        "龙节双油重，蛇矛百练明。",
        "跃鱼连后斾，腾虎耀前旌。",
        "路转金神竝，川开铁马横。",
        "拥旄差白羽，分辔引红缨。",
        "在浚风烟接，维嵩巩洛清。",
        "贯鱼奔骑疾，连雁卷行轻。",
        "烟垒风调角，秋原雨洗兵。",
        "宿云看布甲，疎柳见分营。",
        "鼓彻通宵警，和门候晓晴。",
        "虎符三校列，鱼胄万夫迎。",
        "弄马猨猱健，奔车角觝呈。",
        "驾肩傍隘道，张幕内连楹。",
        "森戟承三令，攒戈退一声。",
        "及郊知雨过，观俗辨风行。",
        "望宋怜思女，游梁念客卿。",
        "义夫留感激，公子播英名。",
        "泽广豚鱼洽，恩宣岂弟生。",
        "善师忘任智，中略在推诚。",
        "式宴歌钟合，陈筵绮绣并。",
        "戏鼙千卒跃，均酒百壶倾。",
        "乐与师徒共，欢从井邑盈。",
        "教通因渐染，人悦尚和平。",
        "授钺慙分阃，登坛荷列城。",
        "虚裘朝独坐，雄劒夜孤鸣。",
        "白发侵霜变，丹心捧日惊。",
        "卫青终保志，潘岳未忘情。",
        "期月终迷化，三年讵有成。",
        "惟看波海动，天外斩长鲸。"
      ],
      "author": {
        "id": 4777,
        "name": "李绅"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 273090,
      "title": "江南暮春寄家",
      "content": [
        "雒阳城见梅迎雪，鱼口桥逢雪送梅。",
        "劒水寺前芳草合，镜湖亭上野花开。",
        "江鸿断续翻云去，海燕差池拂水回。",
        "想得心知近寒食，潜听喜鹊望归来。"
      ],
      "author": {
        "id": 4777,
        "name": "李绅"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 273091,
      "title": "奉酬乐天立秋夕有怀见寄",
      "content": [
        "深夜星汉静，秋风初报凉。",
        "阶篁淅沥响，露叶参差光。",
        "冰兔半升魄，铜壶微滴长。",
        "薄帷乍飘卷，襟带轻摇飏。",
        "此际昏梦清，斜月满轩房。",
        "屣履步前楹，劒戟森在行。",
        "重城宵正分，号鼓互相望。",
        "独坐有所思，夫君鸾凤章。",
        "天津落星河，一苇安可航。",
        "龙泉白玉首，鱼服黄金装。",
        "报国未知効，惟鹈徒在梁。",
        "裴回顾戎旃，颢气生东方。",
        "衰叶满栏草，斑毛盈镜霜。",
        "羸牛未脱辕，老马强腾骧。",
        "吟君白雪唱，慙媿巴人肠。"
      ],
      "author": {
        "id": 4777,
        "name": "李绅"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 273092,
      "title": "山出云",
      "content": [
        "杳霭祥云起，飘飏翠岭新。",
        "萦峰开石秀，吐叶间松春。",
        "林静翻空少，山明度岭频。",
        "回崖时掩鹤，幽涧或随人。",
        "姑射朝凝雪，阳台晚伴神。",
        "悠悠九霄上，应坐玉京宾。"
      ],
      "author": {
        "id": 4777,
        "name": "李绅"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 273093,
      "title": "上党奏庆云见",
      "content": [
        "飞龙久驭宇，真气尚兴云。",
        "五色传嘉瑞，千龄表圣君。",
        "从风忽萧索，依汉更氛氲。",
        "影彻天初霁，光鲜日未曛。",
        "表祥近自远，垂化聚还分。",
        "宁作无依者，空传陶令文。"
      ],
      "author": {
        "id": 4777,
        "name": "李绅"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 273094,
      "title": "华山庆云见",
      "content": [
        "圣主祠名岳，高峰发庆云。",
        "金柯初缭绕，玉叶渐氛氲。",
        "气色含珠日，晴光吐翠雰。",
        "依稀来鹤态，髣髴列仙群。",
        "万树流光影，千潭写锦文。",
        "苍生欣有望，祥瑞在吾君。"
      ],
      "author": {
        "id": 4777,
        "name": "李绅"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 273095,
      "title": "欲到西陵寄王行周",
      "content": [
        "西陵沙岸回流急，船底黏沙去岸遥。",
        "驿吏递呼催下缆，棹郎闲立道齐桡。",
        "犹瞻伍相青山庙，未见双童白鹤桥。",
        "欲责舟人无次第，自知贪酒过春潮。"
      ],
      "author": {
        "id": 4777,
        "name": "李绅"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 273096,
      "title": "华顶",
      "content": [
        "欲向仙峰炼九丹，独瞻华顶礼仙坛。",
        "石标琪树凌空碧，水挂银河映月寒。",
        "天外鹤声随绛节，洞中云气隐琅玕。",
        "浮生未有从师地，空诵仙经想羽翰。"
      ],
      "author": {
        "id": 4777,
        "name": "李绅"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 273097,
      "title": "莺莺歌",
      "content": [
        "伯劳飞迟燕飞疾，垂杨绽金花笑日。",
        "绿窗娇女字莺莺，金雀娅鬟年十七。",
        "黄姑上天阿母在，寂莫霜姿素莲质。",
        "门掩重关萧寺中，芳草花时不曾出。"
      ],
      "author": {
        "id": 4777,
        "name": "李绅"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 273098,
      "title": "赠毛仙翁",
      "content": [
        "忆昔我祖神仙主，玄元皇帝周柱史。",
        "曾师轩黄友尧汤，混迹和光佐周武。",
        "周之天子无仙气，成武康昭都瞥尔。",
        "穆王麤识神仙事，八极轮蹄方逞志。",
        "鹤发韬真世不知，日月星辰几回死。",
        "金鼎作丹丹化碧，三万六千神入宅。",
        "仙兄受术几千年，已是当时驾鸿客。",
        "海光悠容天路长，春风玉女开宫院。",
        "紫笔亲教书姓名，玉皇诏刻青金简。",
        "桂窗一别三千春，秦妃镜里娥眉新。",
        "忽控香虬天上去，海隅劫石霄花尘。",
        "一从仙驾辞中土，顽日昏风老无主。",
        "九州争夺无时休，八骏垂头避豺虎。",
        "我亦玄元千世孙，眼穿望断苍烟根。",
        "花麟白凤竟冥寞，飞春走月劳神昏。",
        "百年命促奔马疾，愁肠盘结心摧崪。",
        "今朝稽首拜仙兄，愿赠丹砂化秋骨。"
      ],
      "author": {
        "id": 4777,
        "name": "李绅"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 273099,
      "title": "和晋公三首 一",
      "content": [
        "凤仪常欲附，蚊力自知微。",
        "愿假罇罍末，膺门自此依。"
      ],
      "author": {
        "id": 4777,
        "name": "李绅"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 273100,
      "title": "和晋公三首 二",
      "content": [
        "貂蝉公独步，鸳鹭我同群。",
        "插羽先飞酒，交锋便著文。"
      ],
      "author": {
        "id": 4777,
        "name": "李绅"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 273101,
      "title": "和晋公三首 三",
      "content": [
        "穷阴初莽苍，离思渐氛氲。",
        "残雪午桥岸，斜阳伊水滨。"
      ],
      "author": {
        "id": 4777,
        "name": "李绅"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 273102,
      "title": "古风二首 一",
      "content": [
        "春种一粒粟，秋成万颗子。",
        "四海无闲田，农夫犹饿死。"
      ],
      "author": {
        "id": 4777,
        "name": "李绅"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 273103,
      "title": "古风二首 二",
      "content": [
        "锄禾日当午，汗滴禾下土。",
        "谁知盘中餐，粒粒皆辛苦。"
      ],
      "author": {
        "id": 4777,
        "name": "李绅"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 273104,
      "title": "柳二首 一",
      "content": [
        "陶令门前罥接篱，亚夫营里拂朱旗。",
        "人事推移无旧物，年年春至绿垂丝。"
      ],
      "author": {
        "id": 4777,
        "name": "李绅"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 273105,
      "title": "柳二首 二",
      "content": [
        "千条垂柳拂金丝，日暖牵风叶学眉。",
        "愁见花飞狂不定，还同轻薄五陵儿。"
      ],
      "author": {
        "id": 4777,
        "name": "李绅"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 273106,
      "title": "题白乐天文集",
      "content": [
        "寄玉莲花藏，缄珠贝叶扃。",
        "院闲容客读，讲倦许僧听。",
        "部列雕金榜，题存刻石铭。",
        "永添鸿宝集，莫杂小乘经。"
      ],
      "author": {
        "id": 4777,
        "name": "李绅"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 273107,
      "title": "答章孝标",
      "content": [
        "假金方用真金镀，若是真金不镀金。",
        "十载长安得一第，何须空腹用高心。"
      ],
      "author": {
        "id": 4777,
        "name": "李绅"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 273108,
      "title": "朱槿花",
      "content": [
        "瘴烟长暖无霜雪，槿艳繁花满树红。",
        "每叹芳菲四时厌，不知开落有春风。"
      ],
      "author": {
        "id": 4777,
        "name": "李绅"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 273109,
      "title": "至潭州闻猿",
      "content": [
        "昔陪天上三清客，今作端州万里人。",
        "湘浦更闻猿夜啸，断肠无泪可霑巾。"
      ],
      "author": {
        "id": 4777,
        "name": "李绅"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 273110,
      "title": "江亭",
      "content": [
        "瘴江昏雾连天合，欲作家书更断肠。",
        "今日病身悲状候，岂能埋骨向炎荒。"
      ],
      "author": {
        "id": 4777,
        "name": "李绅"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 273111,
      "title": "红蕉花",
      "content": [
        "红蕉花样炎方识，瘴水溪边色最深。",
        "叶满丛深殷似火，不唯烧眼更烧心。"
      ],
      "author": {
        "id": 4777,
        "name": "李绅"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 273112,
      "title": "忆汉月",
      "content": [
        "花开花落无时节，春去春来有底凭。",
        "燕子不藏雷不蛰，烛烟昏雾暗腾腾。"
      ],
      "author": {
        "id": 4777,
        "name": "李绅"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 273113,
      "title": "端州江亭得家书二首 一",
      "content": [
        "雨中鹊语喧江树，风处蛛丝飏水浔。",
        "开拆远书何事喜，数行家信抵千金。"
      ],
      "author": {
        "id": 4777,
        "name": "李绅"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 273114,
      "title": "端州江亭得家书二首 二",
      "content": [
        "长安别日春风早，岭外今来白露秋。",
        "莫道淮南悲木叶，不闻摇落更堪愁。"
      ],
      "author": {
        "id": 4777,
        "name": "李绅"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 273115,
      "title": "闻猨",
      "content": [
        "见说三声巴峡深，此时行者尽沾襟。",
        "端州江口连云处，始信哀猨伤客心。"
      ],
      "author": {
        "id": 4777,
        "name": "李绅"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 273116,
      "title": "赠韦金吾",
      "content": [
        "自报金吾主禁兵，腰间宝劒重横行。",
        "接舆也是狂歌客，更就将军乞一声。"
      ],
      "author": {
        "id": 4777,
        "name": "李绅"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 273117,
      "title": "长门怨",
      "content": [
        "宫殿沈沈晓欲分，昭阳更漏不堪闻。",
        "珊瑚枕上千行泪，不是思君是恨君。"
      ],
      "author": {
        "id": 4777,
        "name": "李绅"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 273118,
      "title": "龟山寺鱼池 一",
      "content": [
        "汲水添池活白莲，十千鬐鬣尽生天。",
        "凡庸不识慈悲意，自葬江鱼入九泉。"
      ],
      "author": {
        "id": 4777,
        "name": "李绅"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 273119,
      "title": "龟山寺鱼池 二",
      "content": [
        "剃发多缘是代耕，好闻人死恶人生。",
        "祇园说法无高下，尔辈何劳尚世情。"
      ],
      "author": {
        "id": 4777,
        "name": "李绅"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 273120,
      "title": "赋月",
      "content": [
        "月，光辉，皎洁。",
        "耀乾坤，静空阔。",
        "圆满中秋，玩争诗哲。",
        "玉兔镝难穿，桂枝人共折。",
        "万象照乃无私，琼台岂遮君谒。",
        "抱琴对弹别鹤声，不得知音声不切。"
      ],
      "author": {
        "id": 4777,
        "name": "李绅"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 273121,
      "title": "句",
      "content": [
        "君咏风月夕，余当童稚年。",
        "闲窗读书罢，偷咏左司篇。"
      ],
      "author": {
        "id": 4777,
        "name": "李绅"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 297491,
      "title": "荅章孝标",
      "content": [
        "假金只用真金镀，若是真金不镀金。",
        "十载长安得一第，何须空腹用高心。"
      ],
      "author": {
        "id": 4777,
        "name": "李绅"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 300876,
      "title": "遥知（友人陈九思同志疑「知」乃「和」字之讹）元九送王行周游越",
      "content": [
        "江湖随月盈还宿，沙渚依潮断更连。",
        "伍相庙中多白浪，越王台畔少晴烟。",
        "低头绿草羞枚乘，刺眼红花笑杜鹃。",
        "莫倚西施旧苔石，由来破国是神仙。",
        "（见韦庄《又玄集》卷中。"
      ],
      "author": {
        "id": 4777,
        "name": "李绅"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 301613,
      "title": "泰伯井",
      "content": [
        "至德今何在，平墟井有泉。",
        "梁鸿重濬后，又历几千年。",
        "（《梅里志》三《诗》）。"
      ],
      "author": {
        "id": 4777,
        "name": "李绅"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 301614,
      "title": "莺莺歌（逸句〖1〗）",
      "content": [
        "（董解元《西厢记诸宫调》征引公垂《莺莺歌》凡四处。",
        "卷一有「伯劳飞迟燕飞疾」八句，已见《全唐诗》。"
      ],
      "author": {
        "id": 4777,
        "name": "李绅"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 301615,
      "title": "莺莺歌（逸句〖1〗） 一",
      "content": [
        "河桥上将亡官军，虎骑长「戟」（战）交垒门。",
        "凤凰诏书犹未到，满城戈甲如「云」（雪）屯。",
        "家家玉帛弃泥土，少女娇妻愁被虏。",
        "出门走马皆健儿，红粉潜藏欲何处？",
        "鸣鸣阿母啼向天，窗中抱女投金钿。",
        "铅华不顾欲藏艳，玉颜转莹如神仙（《董解元西厢记》卷二〖2〗）。"
      ],
      "author": {
        "id": 4777,
        "name": "李绅"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 301616,
      "title": "莺莺歌（逸句〖1〗） 二",
      "content": [
        "此时潘郎未相识，偶住莲馆对南北。",
        "潜叹凄惶阿母心，为求白马将军力。",
        "明明飞诏五云下，将选金门兵悉罢。",
        "阿母深居鸡犬安，八珍玉食邀郎餐。",
        "千言万语对生意，小女初笄为姊妹。",
        "（同上〖卷三〗）。"
      ],
      "author": {
        "id": 4777,
        "name": "李绅"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 301617,
      "title": "莺莺歌（逸句〖1〗） 三",
      "content": [
        "丹诚寸之难自比，写在红笺方寸纸。",
        "寄与春风伴落花，仿佛随风绿杨里。",
        "窗中暗读人不知，剪破红绡裁作诗。",
        "还怕香风易飘荡，自令青鸟口啣之。",
        "诗中报郎含隐语，郎知暗到花深处。",
        "三五月明当户时，与郎相见花间路。",
        "（同上〖卷四〗）。"
      ],
      "author": {
        "id": 4777,
        "name": "李绅"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 301618,
      "title": "莺莺歌（逸句〖1〗） 四",
      "content": [
        "恍然梦作瑶台客。",
        "（《施注苏诗》十五《见月诗》注引）（〖1〗《董解元西厢记》卷一、卷二、卷三所引，皆作《莺莺本传歌》，卷四作《本传歌》。",
        "〖2〗两处校改，均据人民文学出版社出版凌景埏校注本。"
      ],
      "author": {
        "id": 4777,
        "name": "李绅"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 304051,
      "title": "暮宿清凉院",
      "content": [
        "野客闲来日，山房落叶中。",
        "微寒生夜半，积雨向秋终。",
        "证道方离法，安禅不住空。",
        "□迷将觉路，语默在西东。",
        "（影印本《诗渊》第五册第三七三六页）。"
      ],
      "author": {
        "id": 4777,
        "name": "李绅"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 304052,
      "title": "在端州知家累以九月九日发衡州因寄（题拟）",
      "content": [
        "菊花开日有人逢，知过衡阳回雁峰。",
        "江树送秋黄叶少，海天迎远碧云重。",
        "音书断达听蛮鹊，风水多虞祝媪龙。",
        "想见病身浑不识，自磨青镜照衰容。",
        "（李绅《追昔游诗》卷一《逾岭峤止荒陬抵高要》诗「雁飞难渡漳江东」句下自注引。",
        "）（按：自注云：「余在南中日，知家累以其年九月九日发衡州，因寄云〖略〗。",
        "」为后来追述语气。",
        "今据以拟题。",
        "宣统《高要县志》拟题为《移家来端州先寄以诗》，与原注不甚契合。"
      ],
      "author": {
        "id": 4777,
        "name": "李绅"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 304053,
      "title": "再游应天寺圣母阁",
      "content": [
        "越地灵踪多少处，伽蓝难尚此楼台。",
        "有时风掣浪声到，半夜月排山势来。",
        "极目烟岚迷远近，百般花木离尘埃。",
        "可怜光景吟不尽，知我登临更几回。",
        "（宋孔延之编《会稽掇英总集》卷八）。"
      ],
      "author": {
        "id": 4777,
        "name": "李绅"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 304054,
      "title": "仙都即事",
      "content": [
        "独出诸峰表，周围百丈圆。",
        "千寻雄镇地，万仞上擎天。",
        "湖浪动星际，莲花生日边。",
        "终当驾云鹤，绝顶会群仙。",
        "（光绪《缙云县志》卷八）。"
      ],
      "author": {
        "id": 4777,
        "name": "李绅"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 304055,
      "title": "题北峰黄道士草堂",
      "content": [
        "清溪道士紫微仙，暗诵真经北斗前。",
        "坛上独窥华顶月，雾中潜到羽人天。",
        "飞流夜落银河水，乔木朝含绛阙烟。",
        "会了浮名休世事，伴君闲种五芝田。",
        "（按：宋林表民《天台前集别编》于杨衡《登紫霄峰赠黄仙师》诗下注：「即李绅所题北峰黄道士也。",
        "」杨诗收入《全唐诗》卷四六五。"
      ],
      "author": {
        "id": 4777,
        "name": "李绅"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 304056,
      "title": "题龙宫寺净院四上人",
      "content": [
        "拥褐梵香四道师，灵山香侣自肩随。",
        "前期鴈塔应同化，今日龙宫又再期。",
        "炎月护生依宝地，夜灯观性息禅枝。",
        "东方几度留车马，谈尽空门习氏知。",
        "（以上二首见宋林师蒧《天台前集》卷中）。"
      ],
      "author": {
        "id": 4777,
        "name": "李绅"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 304057,
      "title": "与李频诗",
      "content": [
        "鸬鹚山头片云晴，扬州城里见潮生。",
        "（见宋胡仔《苕溪渔隐丛话前集》卷二四《蔡宽夫诗话》引、《嘉定镇江志》卷二二）（按：《全唐诗》卷一三三李颀《送刘昱》云：「鸬鹚山头微雨晴，扬州城里暮潮生。",
        "」与此二句极相似，未详系蔡氏误记，抑为李绅用李颀之成句。"
      ],
      "author": {
        "id": 4777,
        "name": "李绅"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 304058,
      "title": "句",
      "content": [
        "鱼惊翠羽金鳞跃，莲脱红衣紫菂擢。",
        "（见宋高似孙《剡录》卷十引）。"
      ],
      "author": {
        "id": 4777,
        "name": "李绅"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 304059,
      "title": "芝草（题拟）",
      "content": [
        "灵根盘错呈天瑞，宝叶蝉联表地仙。",
        "（见宋陈景沂《全芳备祖后集》卷十一《卉部·芳草》、无名氏《翰苑新书后集》卷十三）。"
      ],
      "author": {
        "id": 4777,
        "name": "李绅"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 355981,
      "title": "南梁行",
      "content": [
        "江城郁郁春草长，悠悠汉水浮青光。",
        "杂英飞尽空昼景，",
        "青天诏下宠光至，颁籍金闺征石渠。",
        "秭归山路烟岚隔，",
        "杜鹃啼咽花亦殷，声悲绝艳连空山。",
        "斜阳瞥映浅深树，",
        "乔木幽溪上下同，雄雌不惑飞栖处。",
        "望秦峰回过商颜，",
        "元和列侍明光殿，谏草初焚市朝变。",
        "北阙趋承半隙尘，",
        "故箧岁深开断简，秋堂月曙掩遗题。",
        "呜呜晓角霞辉粲，"
      ],
      "author": {
        "id": 4777,
        "name": "李绅"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 355982,
      "title": "趋翰苑遭诬构四十六韵",
      "content": [
        "九五当干德，三千应瑞符。",
        "纂尧昌圣历，宗禹盛丕图。",
        "画象垂新令，消兵易旧谟。",
        "选贤方去智，招谏忽升愚。",
        "大乐调元气，神功运化炉。",
        "脱鳞超沆瀣，翻翼集蓬壶。",
        "捧日恩光别，抽毫顾问殊。",
        "凤形怜采笔，龙颔借骊珠。",
        "掷地声名寡，摩天羽翮孤。",
        "洁身酬雨露，利口扇谗谀。",
        "碧海同宸眷，鸿毛比贱躯。",
        "辨疑分黑白，举直抵朋徒。",
        "庭兽方呈角，阶蓂始效莩。",
        "日倾乌掩魄，星落斗摧枢。",
        "坠剑悲乔岳，号弓泣鼎湖。",
        "乱群逢害马，择肉纵狂䝙。",
        "胆为隳肝竭，心因沥血枯。",
        "满帆摧骇浪，征棹折危途。",
        "燕客书方诈，尧门信未孚。",
        "谤兴金就铄，毁极玉生愈。",
        "砺吻矜先搏，张罗骋疾驱。",
        "地嫌稀魍魉，海恨止番禺。",
        "瘴岭冲蛇入，蒸池蹑虺趋。",
        "望天收雪涕，看镜揽霜须。",
        "草毒人惊剪，茅荒室未诛。",
        "火风晴处扇，山鬼雨中呼。",
        "穷老乡关远，羁愁骨肉无。",
        "鹊灵窥牖户，龟瑞出泥途。",
        "烟岛深千瘴，沧波淼四隅。",
        "海标传信使，江棹认妻孥。",
        "到接三冬暮，来经六月徂。",
        "暗滩朝不怒，惊濑夜无虞。",
        "俯首安羸业，齐眉慰病夫。",
        "涸鱼思雨润，僵燕望雷苏。",
        "诏下因颁朔，恩移讵省辜。",
        "诳天犹指鹿，依社尚凭狐。",
        "度岭瞻牛斗，浮江淬辘轳。",
        "未平人睚眦，谁惧鬼揶揄。",
        "盆浦潮通楚，匡山地接吴。",
        "庾楼清桂满，远寺素莲敷。",
        "仿佛皆停马，悲欢尽隙驹。",
        "旧交封宿草，衰鬓重生刍。",
        "万戟分梁苑，双旌寄鲁儒。",
        "骎骎移岁月，冉冉近桑榆。",
        "疲马愁千里，孤鸿念五湖。",
        "终当赋归去，那更学杨朱。"
      ],
      "author": {
        "id": 4777,
        "name": "李绅"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 355983,
      "title": "忆春日太液池亭候对",
      "content": [
        "宫莺报晓瑞烟开，三岛灵禽拂水回。",
        "桥转彩虹当绮殿，",
        "簪笔此时方侍从，却思金马笑邹枚。"
      ],
      "author": {
        "id": 4777,
        "name": "李绅"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 355984,
      "title": "忆夜直金銮殿承旨",
      "content": [
        "月当银汉玉绳低，深听箫韶碧落齐。",
        "门压紫垣高绮树，",
        "明日独归花路远，可怜人世隔云霓。"
      ],
      "author": {
        "id": 4777,
        "name": "李绅"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 355985,
      "title": "忆春日曲江宴后许至芙蓉园",
      "content": [
        "春风上苑开桃李，诏许看花入御园。",
        "香径草中回玉勒，",
        "归绕曲江烟景晚，未央明月锁千门。"
      ],
      "author": {
        "id": 4777,
        "name": "李绅"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 355986,
      "title": "新昌宅书堂前有药树一株，今已盈拱前。长庆中，于翰林院内，西轩药树下移得。才长一寸，仆夫封一泥丸以归植，今则长成，名之天上树",
      "content": [
        "白榆星底开红甲，珠树宫中长紫霄。",
        "丹彩结心才辨质，",
        "长带九天余雨露，近来葱翠欲成乔。"
      ],
      "author": {
        "id": 4777,
        "name": "李绅"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 355987,
      "title": "过荆门",
      "content": [
        "荆江水阔烟波转，荆门路绕山葱蒨。",
        "帆势侵云灭又明，",
        "行行驱马万里远，渐入烟岚危栈赊。",
        "林中有鸟飞出谷，",
        "我听此鸟祝我魂，魂死莫学声衔冤。",
        "纵为羽族莫栖息，",
        "皎洁深看入涧泉，分明细见樵人径。",
        "阴森鬼庙当邮亭，",
        "月低山晓问行客，已酹椒浆拜荒陌。",
        "惆怅忠贞徒自持，"
      ],
      "author": {
        "id": 4777,
        "name": "李绅"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 355988,
      "title": "涉沅潇",
      "content": [
        "屈原死处潇湘阴，沧浪淼淼云沉沉。",
        "蛟龙长怒虎长啸，",
        "鸿叫离离入暮天，霞消漠漠深云水。",
        "水灵江暗扬波涛，",
        "屈原尔为怀王没，水府通天化灵物。",
        "何不驱雷击电除奸邪，",
        "波白水黑山隐见，汨罗之上遥昏昏。",
        "风帆候晓看五两，",
        "潇湘岛浦无人居，风惊水暗惟鲛鱼。",
        "行来击棹独长叹，"
      ],
      "author": {
        "id": 4777,
        "name": "李绅"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 355989,
      "title": "逾岭峤止荒陬抵高要",
      "content": [
        "天将南北分寒燠，北被羔裘南卉服。",
        "寒气凝为戎虏骄，",
        "南标铜柱限荒徼，五岭从兹穷险艰。",
        "衡山截断炎方北，",
        "千崖傍耸猿啸悲，丹蛇玄虺潜蜲蛇。",
        "泷夫拟楫劈高浪，",
        "岭上泉分南北流，行人照水愁肠骨。",
        "阴森石路盘萦纡，",
        "鹧鸪猿鸟声相续，椎髻哓呼同戚促。",
        "百处溪滩异雨晴，",
        "鱼跃岂通清远峡，雁飞难渡漳江东。",
        "云蒸地热无霜霰，",
        "幸逢雷雨荡妖昏，提挈悲欢出海门。",
        "西日眼明看少长，",
        "物忌忠良表是非，朝驱绛灌为雠敌。",
        "明皇圣德异文皇，",
        "高明白日恩深海，齿发虽残壮心在。",
        "空愧驽骀异一毛，"
      ],
      "author": {
        "id": 4777,
        "name": "李绅"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 355990,
      "title": "移九江",
      "content": [
        "秋波入白水，帆去侵空小。",
        "五两剧奔星，樯乌疾飞鸟。",
        "盆城依落日，盆浦看云眇。",
        "云眇更苍苍，匡山低夕阳。",
        "楚客喜风水，秦人悲异乡。",
        "异乡秋思苦，江皋月华吐。",
        "漾漾隐波亭，悠悠通月浦。",
        "津桥归候吏，竹巷开门户。",
        "容膝有匡床，及肩才数堵。",
        "隙光非白驹，悬磬我无虞。",
        "体瘦寡行立，家肥安啜哺。",
        "天书怜谴谪，重作朱轓客。",
        "四座眼全青，一麾头半白。",
        "今来思往事，往事益凄然。",
        "风月同今昔，悲欢异目前。",
        "四时嗟阅水，一纪换流年。",
        "独有西庭鹤，孤鸣白露天。"
      ],
      "author": {
        "id": 4777,
        "name": "李绅"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 355991,
      "title": "泛五湖",
      "content": [
        "范子蜕冠履，扁舟逸霄汉。",
        "嗟予抱险艰，怵惕惊弥漫。",
        "穷通泛滥劳，趣适殊昏旦。",
        "浴日荡层空，浮天淼无畔。",
        "依滩落叶聚，立浦惊鸿散。",
        "浪叠雪峰连，山孤翠崖断。",
        "风帆同巨壑，云矗成高岸。",
        "宇宙可东西，星辰沈粲烂。",
        "霞生澒洞远，月吐青荧乱。",
        "岂复问津迷，休为吕梁叹。",
        "漂沈自讵保，覆溺心长判。",
        "吴越郡异乡，婴童及为玩。",
        "依稀占井邑，嘹唳同鹅鹳。",
        "举棹未宵分，维舟方日旰。",
        "征斯济川力，若鼓凌风翰。",
        "易狎当悔游，临深罔知难。"
      ],
      "author": {
        "id": 4777,
        "name": "李绅"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 355992,
      "title": "过钟陵",
      "content": [
        "龙沙江尾抱钟陵，水郭村桥晚景澄。",
        "江对楚山千里月，",
        "惆怅旧游同草露，却思恩顾一沾膺。"
      ],
      "author": {
        "id": 4777,
        "name": "李绅"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 355993,
      "title": "溯西江",
      "content": [
        "江风不定半晴阴，愁对花时尽日吟。",
        "孤棹自迟从蹭蹬，",
        "空阔远看波浪息，楚山安稳过云岑。"
      ],
      "author": {
        "id": 4777,
        "name": "李绅"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 355994,
      "title": "早发",
      "content": [
        "沙洲月落宿禽惊，潮起风微晓雾生。",
        "黄鹤浪明知上信，",
        "萧索更看江叶下，两乡俱是宦游情。"
      ],
      "author": {
        "id": 4777,
        "name": "李绅"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 355995,
      "title": "守滁阳深秋忆登郡城望琅琊",
      "content": [
        "山城小阁临青嶂，红树莲宫接薜萝。",
        "斜日半岩开古殿，",
        "深夜独吟还不寐，坐看凝露满庭莎。"
      ],
      "author": {
        "id": 4777,
        "name": "李绅"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 355996,
      "title": "滁阳春日怀果园闲宴",
      "content": [
        "西园到日栽桃李，红白低枝拂酒杯。",
        "繁艳只愁风处落，",
        "闻道数年深草露，几株犹得近池台。"
      ],
      "author": {
        "id": 4777,
        "name": "李绅"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 355997,
      "title": "悲善才",
      "content": [
        "穆王夜幸蓬池曲，金銮殿开高秉烛。",
        "东头弟子曹善才，",
        "天颜静听朱丝弹，众乐寂然无敢举。",
        "衔花金凤当承拨，",
        "抽弦度曲新声发，金铃玉佩相瑳切。",
        "流莺子母飞上林，",
        "三月曲江春草绿，九霄天乐下云端。",
        "紫髯供奉前屈膝，",
        "日曛尘暗车马散，为惜新声有余叹。",
        "明年冠剑闭桥山，",
        "闻道善才成朽骨，空余弟子奉音徽。",
        "南谯寂寞三春晚，",
        "心悲不觉泪阑干，更为调弦反复弹。",
        "秋吹动摇神女佩，",
        "惆怅追怀万事空，雍门感慨徒为尔。"
      ],
      "author": {
        "id": 4777,
        "name": "李绅"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 355998,
      "title": "闻里谣效古歌",
      "content": [
        "乡里儿，桑麻郁郁禾黍肥，冬有褴襦夏有𫄨。",
        "兄锄弟耨妻在机，夜犬不吠开蓬扉。",
        "乡里儿，醉还饱，",
        "劝年少，乐耕桑。",
        "使君为我剪荆棘，使君为我驱豺狼。",
        "林中无虎山有鹿，水底无蛟鱼有鲂。",
        "父渔子猎日归暮，",
        "恶声主吏噪尔门，唧唧力力烹鸡豚。",
        "乡里儿，莫悲咤。",
        "上有明王颁诏下，重选贤良恤孤寡。",
        "春日迟迟驱五马，"
      ],
      "author": {
        "id": 4777,
        "name": "李绅"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 355999,
      "title": "转寿春守，太和庚戌岁二月祗命寿阳，时替裴五墉终殁。因视壁题，自墉而上，或除名在边坐殿，殁凡七子，无一存焉。寿人多寇盗，好诉讦，时谓之凶郡，犷俗特著。蒙此处之，顾余衰年甘蹑前患，俾三月而寇静，期岁而人和，虎不暴物，奸吏屏窜。三载，复遭邪佞所恶，授宾客，分司东都。或举其目，或寄于风，亦麤继诗人之末云",
      "content": [
        "未登崖谷寻丹灶，且历轩窗看壁题。",
        "那遇八公生羽翼，",
        "点检遗编尽朝菌，应难求望一刀圭。"
      ],
      "author": {
        "id": 4777,
        "name": "李绅"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 356000,
      "title": "忆寿春废虎坑，余以春二月至郡，主吏举所职，称霍山多虎，每岁采茶为患，择肉于人，至春常修陷阱数十所，勒猎者采其皮睛，余悉除罢之。是岁虎不复为害，至余去郡三载",
      "content": [
        "匪将履尾求兢惕，那效探雏所患争。",
        "当路绝群尝诫暴，",
        "休逐豺狼止贪戾，好为仁兽答皇明。"
      ],
      "author": {
        "id": 4777,
        "name": "李绅"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 356001,
      "title": "寿阳罢郡日有诗十首与追怀不殊今编于后兼纪瑞物：肥河维舟阻涷祇待敕命",
      "content": [
        "罢分符竹作闲官，舟冻肥河拟棹难。",
        "食蘗苦心甘处困，",
        "西奏血诚遥稽首，乞容归病老江干。",
        "淮阳效理空多病，疏受辞荣岂恋班。",
        "陈力不任趋北阙，",
        "珍重八公山下叟，不劳重泪更追攀。"
      ],
      "author": {
        "id": 4777,
        "name": "李绅"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 356002,
      "title": "寿阳罢郡日有诗十首与追怀不殊今编于后兼纪瑞物：别连理树",
      "content": [
        "垂阴敢慕甘棠叶，附干将呈瑞木符。",
        "十步兰茶同秀彩，",
        "好住孤根托桃李，莫令从此混樵苏。"
      ],
      "author": {
        "id": 4777,
        "name": "李绅"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 356003,
      "title": "寿阳罢郡日有诗十首与追怀不殊今编于后兼纪瑞物：虎不食人",
      "content": [
        "南山白额同驯扰，亦变仁心去杀机。",
        "不竞牛甘令买患，",
        "尔效驺虞护生草，岂徒柔伏在淮淝。"
      ],
      "author": {
        "id": 4777,
        "name": "李绅"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 356004,
      "title": "寿阳罢郡日有诗十首与追怀不殊今编于后兼纪瑞物：发寿阳分司敕到又遇新正感怀书事",
      "content": [
        "休为建隼临淝守，转作垂丝入洛人。",
        "罢阅旧林三载籍，",
        "渐喜雪霜消解尽，得随风水到天津。"
      ],
      "author": {
        "id": 4777,
        "name": "李绅"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 356005,
      "title": "寿阳罢郡日有诗十首与追怀不殊今编于后兼纪瑞物：初出淝口入淮",
      "content": [
        "东风百里雪初晴，淝口冰开好濯缨。",
        "野老拥途知意重，",
        "回首夕岚山翠远，楚郊烟树隐襄城。"
      ],
      "author": {
        "id": 4777,
        "name": "李绅"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 356006,
      "title": "寿阳罢郡日有诗十首与追怀不殊今编于后兼纪瑞物：入淮至盱眙",
      "content": [
        "山凝翠黛孤峰迥，淮起银花五两高。",
        "天外绮霞迷海鹤，",
        "寄谢云帆疾飞鸟，莫夸回雁卷轻毛。"
      ],
      "author": {
        "id": 4777,
        "name": "李绅"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 356007,
      "title": "寿阳罢郡日有诗十首与追怀不殊今编于后兼纪瑞物：忆东湖",
      "content": [
        "菱歌罢唱鹢舟回，雪鹭银鸥左右来。",
        "霞散浦边云锦截，",
        "淮口值春偏怅望，数株临水是寒梅。"
      ],
      "author": {
        "id": 4777,
        "name": "李绅"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 356008,
      "title": "七年初到洛阳寓居宣教里时已春暮而四老俱在洛中分司",
      "content": [
        "青莎满地无三径，白发缘头忝四人。",
        "官职谬齐商岭客，",
        "惟有门人怜钝拙，劝教沈醉洛阳春。"
      ],
      "author": {
        "id": 4777,
        "name": "李绅"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 356009,
      "title": "初秋忽奉诏除浙东观察使检校右貂",
      "content": [
        "龙楼寄引簪裾客，凤阙陪趋朔望朝。",
        "疏受杜门期脱屣，",
        "飞诏宠荣欢里舍，岂徒斑白与垂髫。"
      ],
      "author": {
        "id": 4777,
        "name": "李绅"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 356010,
      "title": "忆至巩县河宿待家累追怀",
      "content": [
        "巩树翻红秋日斜，水分伊洛照余霞。",
        "弓开后骑低初月，",
        "今来忆事凉风晚，烟浦空悲黄菊花。"
      ],
      "author": {
        "id": 4777,
        "name": "李绅"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 356011,
      "title": "宿扬州",
      "content": [
        "江横渡阔烟波晚，潮过金陵落叶秋。",
        "嘹唳塞鸿经楚泽，",
        "今日市朝风俗变，不须开口问迷楼。"
      ],
      "author": {
        "id": 4777,
        "name": "李绅"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 356012,
      "title": "忆被牛相留醉州中时无他宾牛公夜出真珠辈数人",
      "content": [
        "严城画角三声闭，清宴金樽一夕同。",
        "银烛坐隅听子夜，",
        "淮海一从云雨散，杳然俱是梦魂中。"
      ],
      "author": {
        "id": 4777,
        "name": "李绅"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 356013,
      "title": "早渡扬子江",
      "content": [
        "日冲海浪翻银屋，江转秋波走雪山。",
        "青嶂迥开蹲虎戍，",
        "焚却戍船无战伐，使知风教被乌蛮。"
      ],
      "author": {
        "id": 4777,
        "name": "李绅"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 356014,
      "title": "忆过润州",
      "content": [
        "昔年从宦干戈地，黄绶青春一鲁儒。",
        "弓犯控弦招武旅，",
        "谈笑谢金何所愧，不为偷买用兵符。"
      ],
      "author": {
        "id": 4777,
        "name": "李绅"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 356015,
      "title": "忆登栖霞寺峰",
      "content": [
        "香印烟火息，法堂钟磬余。",
        "纱灯耿晨焰，释子安禅居。",
        "林叶脱红影，竹烟含绮疏。",
        "星珠错落耀，月宇参差虚。",
        "顾眺匪恣适，旷襟怀卷舒。",
        "江海淼清荡，丘陵何所如。",
        "滔滔可问津，耕者非长沮。",
        "茅岭感仙客，萧园成古墟。",
        "移步下碧峰，涉涧更踌躇。",
        "乌噪啄秋果，翠惊衔素鱼。",
        "回塘彩鹢来，落景标林箊。",
        "漾漾棹翻月，萧萧风袭裾。",
        "劳歌起旧思，戚叹竟难摅。",
        "却数共游者，凋落非里闾。"
      ],
      "author": {
        "id": 4777,
        "name": "李绅"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 356016,
      "title": "忆万岁楼望金山",
      "content": [
        "楼高雉堞千师垒，峰拔惊波万壑攒。",
        "山绝地维消虎踞，",
        "长对碧波临古渡，几经风月与悲欢。"
      ],
      "author": {
        "id": 4777,
        "name": "李绅"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 356017,
      "title": "过梅里七首家于无锡四十载今敝庐数堵犹存今列题于后：上家山\r\n",
      "content": [
        "上家山，家山依旧好。",
        "昔去松桂长，今来容须老。",
        "上家山，临古道。",
        "高低入云树，芜没连天草。",
        "草色绿萋萋，"
      ],
      "author": {
        "id": 4777,
        "name": "李绅"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 356018,
      "title": "过梅里七首家于无锡四十载今敝庐数堵犹存今列题于后：忆东郭居",
      "content": [
        "昔余过稚齿，从师昧知奥。",
        "徒怀利物心，不获藏身宝。",
        "曳娄一缝掖，出处劳昏早。",
        "醒醉迷啜哺，衣裳辨颠倒。",
        "忠诚贯白日，直已凭苍昊。",
        "卷舌堕谗谀，惊波息行潦。",
        "衰禽识旧木，疲马知归道。",
        "杨柳长庭柯，兰荃覆阶草。",
        "旌旄光里舍，骑服欢妻嫂。",
        "绿鬓绝新知，苍须稀旧老。",
        "冠緌身忝贵，斋沐心常祷。",
        "笙磬谅谐和，庭除还洒扫。",
        "栖迟还竹巷，物役浸江岛。",
        "倏忽变星霜，悲伤满衷抱。"
      ],
      "author": {
        "id": 4777,
        "name": "李绅"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 356019,
      "title": "过梅里七首家于无锡四十载今敝庐数堵犹存今列题于后：忆题惠山寺书堂",
      "content": [
        "故山一别光阴改，秋露清风岁月多。",
        "松下壮心年少去，",
        "惟有此身长是客，又驱旌旆寄烟波。"
      ],
      "author": {
        "id": 4777,
        "name": "李绅"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 356020,
      "title": "过梅里七首家于无锡四十载今敝庐数堵犹存今列题于后：忆西湖双㶉𫛶",
      "content": [
        "双㶉𫛶，锦毛斓斑长比翼。",
        "戏绕莲丛回锦臆，",
        "云间上下同栖息，不作惊禽远相忆。",
        "东家少妇机中语，",
        "五里裴回竟何补。"
      ],
      "author": {
        "id": 4777,
        "name": "李绅"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 356021,
      "title": "过梅里七首家于无锡四十载今敝庐数堵犹存今列题于后：早梅桥",
      "content": [
        "早梅花，满枝发。",
        "东风报春春未彻，紫萼迎风玉珠裂。",
        "杨柳未黄莺结舌，委素飘香照新月。",
        "桥边一树伤离别，"
      ],
      "author": {
        "id": 4777,
        "name": "李绅"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 356022,
      "title": "过梅里七首家于无锡四十载今敝庐数堵犹存今列题于后：翡翠坞",
      "content": [
        "翡翠飞飞绕莲坞，一啄嘉鱼一鸣舞。",
        "莲茎触散莲叶欹，",
        "直上层空翠影高，还向云间双比翼。",
        "弹射莫及弋不得，"
      ],
      "author": {
        "id": 4777,
        "name": "李绅"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 356023,
      "title": "过梅里七首家于无锡四十载今敝庐数堵犹存今列题于后：忆放鹤",
      "content": [
        "羽毛似雪无瑕点，顾影秋池舞白云。",
        "闲整素仪三岛近，",
        "凌励坐看空碧外，更怜凫鹭老江𣸣。"
      ],
      "author": {
        "id": 4777,
        "name": "李绅"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 356024,
      "title": "过吴门二十四韵",
      "content": [
        "烟水吴都郭，阊门架碧流。",
        "绿杨深浅巷，青翰往来舟。",
        "朱户千家室，丹楹百处楼。",
        "水光摇极浦，草色辨长洲。",
        "忆作麻衣翠，曾为旅棹游。",
        "放歌随楚老，清宴奉诸侯。",
        "花寺听莺入，春湖看雁留。",
        "里吟传绮唱，乡语认歈讴。",
        "桥转攒虹饮，波通斗鹢浮。",
        "竹扉梅圃静，水巷橘园幽。",
        "缝堵荒麋苑，穿岩破虎丘。",
        "旧风犹越鼓，余俗尚吴钩。",
        "故馆曾闲访，遗基亦遍搜。",
        "吹台山木尽，香径佛宫秋。",
        "帐殿菰蒲掩，云房露雾收。",
        "苎萝妖覆灭，荆棘鬼包羞。",
        "风月俄黄绶，经过半白头。",
        "重来冠盖客，非复别离愁。",
        "候火分通陌，前旌驻外邮。",
        "水风摇彩旆，堤柳引鸣驺。",
        "问吏儿孙隔，呼名礼敬修。",
        "顾瞻殊宿昔，语默过悲忧。",
        "义感心空在，容衰日易偷。",
        "还持沧海诏，从此布皇猷。"
      ],
      "author": {
        "id": 4777,
        "name": "李绅"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 356025,
      "title": "杭州天竺灵隐二寺顷岁亦布衣一游及赴镇会稽不敢以登临自适竟不复到寺寺多猿猱谓之孙团弥长其类因追思为诗二首",
      "content": [
        "翠岩幽谷高低寺，十里松风碧嶂连。",
        "开尽春花芳草涧，",
        "时有猿猱扰钟磬，老僧无复得安禅。",
        "人烟不隔江城近，水石虽清海气深。",
        "波动只观罗刹相，",
        "近日尤闻重雕饰，世人遥礼二檀林。"
      ],
      "author": {
        "id": 4777,
        "name": "李绅"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    }
