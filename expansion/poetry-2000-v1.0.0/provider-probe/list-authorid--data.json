{
  "data": [
    {
      "id": 1,
      "title": "日诗",
      "content": [
        "欲出未出光辣达，千山万山如火发。",
        "须臾走向天上来，逐却残星赶却月。"
      ],
      "author": {
        "id": 9930,
        "name": "宋太祖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 2,
      "title": "句",
      "content": [
        "未离海底千山黑，才到天中万国明。"
      ],
      "author": {
        "id": 9930,
        "name": "宋太祖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 3,
      "title": "登戎州江楼闲望",
      "content": [
        "满目江山四望幽，白云高卷嶂烟收。",
        "日回禽影穿疏木，风递猿声入小楼。",
        "远岫似屏横碧落，断帆如叶截中流。"
      ],
      "author": {
        "id": 10521,
        "name": "幸夤逊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 4,
      "title": "雪",
      "content": [
        "片片飞来静又闲，楼头江上复山前。",
        "飘零尽日不归去，帖破清光万里天。"
      ],
      "author": {
        "id": 10521,
        "name": "幸夤逊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 5,
      "title": "云",
      "content": [
        "因登巨石知来处，勃勃元生绿藓痕。",
        "静即等闲藏草木，动时顷刻徧乾坤。",
        "横天未必朋元恶，捧日还曾瑞至尊。",
        "不独朝朝在巫峡，楚王何事谩劳魂。"
      ],
      "author": {
        "id": 10521,
        "name": "幸夤逊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 6,
      "title": "句  其一",
      "content": [
        "若教作镇居中国，争得泥金在泰山。"
      ],
      "author": {
        "id": 10521,
        "name": "幸夤逊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 7,
      "title": "句  其二",
      "content": [
        "才闻暖律先偷眼，既待和风始展眉。"
      ],
      "author": {
        "id": 10521,
        "name": "幸夤逊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 8,
      "title": "句  其三",
      "content": [
        "嚼处春冰敲齿冷，咽时雪液沃心寒。"
      ],
      "author": {
        "id": 10521,
        "name": "幸夤逊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 9,
      "title": "句  其四",
      "content": [
        "蒙君知重惠琼实，薄起金刀钉玉深。"
      ],
      "author": {
        "id": 10521,
        "name": "幸夤逊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 10,
      "title": "句  其五",
      "content": [
        "深妆玉瓦平无垅，乱拂芦花细有声。"
      ],
      "author": {
        "id": 10521,
        "name": "幸夤逊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 11,
      "title": "句  其六",
      "content": [
        "片逐银蟾落醉觥。"
      ],
      "author": {
        "id": 10521,
        "name": "幸夤逊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 12,
      "title": "句  其七",
      "content": [
        "巧剪银花乱，轻飞玉叶狂。"
      ],
      "author": {
        "id": 10521,
        "name": "幸夤逊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 13,
      "title": "句  其八",
      "content": [
        "寒艳芳姿色尽明。"
      ],
      "author": {
        "id": 10521,
        "name": "幸夤逊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 14,
      "title": "金陵览古 秦淮",
      "content": [
        "一气东南王斗牛，祖龙潜为子孙忧。",
        "金陵地脉何曾断，不觉真人已姓刘。"
      ],
      "author": {
        "id": 8347,
        "name": "朱存"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 15,
      "title": "金陵览古 石头城",
      "content": [
        "五城楼雉各相望，山水英灵宅帝王。",
        "此地定由天造险，古来长恃作金汤。"
      ],
      "author": {
        "id": 8347,
        "name": "朱存"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 16,
      "title": "金陵览古 段石冈",
      "content": [
        "孙吴纪德旧刊碑，草没蟠螭与伏龟。",
        "惆怅冈头三段石，至今犹似鼎分时。"
      ],
      "author": {
        "id": 8347,
        "name": "朱存"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 17,
      "title": "金陵览古 北渠",
      "content": [
        "金殿分来玉砌流，黑龙湖彻凤池头。",
        "后庭花落恩波断，翻与南唐作御沟。"
      ],
      "author": {
        "id": 8347,
        "name": "朱存"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 18,
      "title": "金陵览古 新亭",
      "content": [
        "满目江山异洛阳，昔人何必重悲伤。",
        "倘能戮力扶王室，当自新亭复故乡。"
      ],
      "author": {
        "id": 8347,
        "name": "朱存"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 19,
      "title": "金陵览古 天阙山",
      "content": [
        "牛头天际碧凝岚，王导无稽亦妄谈。",
        "若指远山为上阙，长安应合指终南。"
      ],
      "author": {
        "id": 8347,
        "name": "朱存"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 20,
      "title": "金陵览古 东山",
      "content": [
        "镇物高情济世才，欲随猿鹤老岩隈。",
        "山花处处红粧面，髣髴如初拥妓来。"
      ],
      "author": {
        "id": 8347,
        "name": "朱存"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 21,
      "title": "金陵览古 乌衣巷",
      "content": [
        "人物风流往往非，空余陋巷作乌衣。",
        "旧时帘幕无从觅，只有年年社燕归。"
      ],
      "author": {
        "id": 8347,
        "name": "朱存"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 22,
      "title": "金陵览古 阿育王塔",
      "content": [
        "窣堵凝然镇梵宫，举头层级在云中。",
        "金棺舍利藏何处，铎绕危簷声撼风。"
      ],
      "author": {
        "id": 8347,
        "name": "朱存"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 23,
      "title": "金陵览古 乌衣巷",
      "content": [
        "阀阅沦亡梐枑移，年年旧燕亦双归。",
        "茅簷苇箔无冠盖，不见乌衣见白衣。"
      ],
      "author": {
        "id": 8347,
        "name": "朱存"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 24,
      "title": "金陵览古 后湖",
      "content": [
        "雷轰叠鼓火翻旗，三翼翩翩试水师。",
        "惊起黑龙眠不得，狂风猛雨下多时。"
      ],
      "author": {
        "id": 8347,
        "name": "朱存"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 25,
      "title": "金陵览古 半阳湖",
      "content": [
        "江南龙节水为乡，水不纯阴又半阳。",
        "一片湖光共深浅，两般泉脉异温凉。"
      ],
      "author": {
        "id": 8347,
        "name": "朱存"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 26,
      "title": "金陵览古 潮沟",
      "content": [
        "流水东西傍帝台，六朝重为两朝开。",
        "曾有鹢首知高下，莫问鱼舟识去来。"
      ],
      "author": {
        "id": 8347,
        "name": "朱存"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 27,
      "title": "金陵览古 直渎",
      "content": [
        "昼役人功夜鬼功，阳开阴阖几时终。",
        "不闻掷土江中语，争得盈流一水通。"
      ],
      "author": {
        "id": 8347,
        "name": "朱存"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 28,
      "title": "金陵览古 运渎",
      "content": [
        "舳舻衔尾日无虚，更凿都城引漕渠。",
        "何事馁来贪雀谷，不知留得几年储。"
      ],
      "author": {
        "id": 8347,
        "name": "朱存"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 29,
      "title": "金陵览古 凤凰台",
      "content": [
        "竹影桐阴满旧山，凤凰多载不飞还。",
        "登台只有吹箫者，争得和鸣堕世间。"
      ],
      "author": {
        "id": 8347,
        "name": "朱存"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 30,
      "title": "偈",
      "content": [
        "通玄峰顶，不是人门。",
        "心外无法，满目青山。"
      ],
      "author": {
        "id": 12626,
        "name": "释德韶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 31,
      "title": "颂",
      "content": [
        "暂下高峰已显扬，般若圜通遍十方。",
        "人天浩浩无差别，法界纵横处处彰。"
      ],
      "author": {
        "id": 12626,
        "name": "释德韶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 32,
      "title": "偈",
      "content": [
        "来年二月二，与汝暂相弃。",
        "烧灰散长江，勿占檀那地。"
      ],
      "author": {
        "id": 3897,
        "name": "释志端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 33,
      "title": "句",
      "content": [
        "木马走似烟，石人趁不及。"
      ],
      "author": {
        "id": 3897,
        "name": "释志端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 34,
      "title": "春社日寄李学士",
      "content": [
        "社翁今日没心情，为乞治聋酒一瓶。",
        "恼乱玉堂将欲徧，依稀巡到第三厅。"
      ],
      "author": {
        "id": 13315,
        "name": "李涛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 35,
      "title": "题泥水关不动尊院",
      "content": [
        "走却坐禅客，移将不动尊。",
        "世间颠倒事，八万四千门。"
      ],
      "author": {
        "id": 13315,
        "name": "李涛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 36,
      "title": "赠山翁",
      "content": [
        "松萝深处住，闲野不生愁。",
        "鸟语烟岚静，水声门户秋。",
        "花间归洞路，山下钓鱼舟。",
        "沐浴圣王化，自怜丝满头。"
      ],
      "author": {
        "id": 13315,
        "name": "李涛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 37,
      "title": "题处士林亭",
      "content": [
        "帝里高人宅，苍苔遶径深。",
        "卷帘山入户，摘菓鸟移林。",
        "石沼养龟水，月台留客琴。",
        "生涯一樽酒，名利不关心。"
      ],
      "author": {
        "id": 13315,
        "name": "李涛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 38,
      "title": "杂诗四首  其一",
      "content": [
        "滔滔东流水，赴海无归期。",
        "亭亭右转日，今兹复来兹。",
        "人生寄天地，百年七十稀。",
        "思虑复营营，恐为达此嗤。"
      ],
      "author": {
        "id": 13315,
        "name": "李涛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 39,
      "title": "杂诗四首  其二",
      "content": [
        "燕雀贺厦屋，虫蚁慕腥膻。",
        "野花引飞蝶，古木来新蝉。",
        "秋天百虫吟，春天百鸟喧。",
        "翟公真暗事，喜愠见色言。"
      ],
      "author": {
        "id": 13315,
        "name": "李涛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 40,
      "title": "杂诗四首  其三",
      "content": [
        "明主不弃士，我自志山林。",
        "爵服岂无华，才疏力难任。",
        "鸟向深山栖，鱼由深渊沉。",
        "吾亦爱吾庐，高歌复微吟。"
      ],
      "author": {
        "id": 13315,
        "name": "李涛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 41,
      "title": "杂诗四首  其四",
      "content": [
        "深岩有老翁，庞眉须鬓雪。",
        "夜半呼我名，授我微妙诀。",
        "字画古籀样，体势讹复缺。",
        "双眸忽炯炯，须臾竟披阅。",
        "至今得其传，心会口难说。"
      ],
      "author": {
        "id": 13315,
        "name": "李涛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 42,
      "title": "句",
      "content": [
        "一言寤主宁复听，三谏不从归去来。",
        "谏晋主不从作。"
      ],
      "author": {
        "id": 13315,
        "name": "李涛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 43,
      "title": "俞公岩",
      "content": [
        "万事若在手，百年聊称情。",
        "他时南岳去，记得此岩名。"
      ],
      "author": {
        "id": 2406,
        "name": "陈抟"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 44,
      "title": "归隠",
      "content": [
        "十年踪迹走红尘，回首青山入梦频。",
        "紫陌纵荣争及睡，朱门虽贵不如贫。",
        "愁闻剑戟扶危主，闷见笙歌聒醉人。",
        "携取旧书归旧隠，野花啼鸟一般春。"
      ],
      "author": {
        "id": 2406,
        "name": "陈抟"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 45,
      "title": "赠金励睡诗  其一",
      "content": [
        "常人无所重，惟睡乃为重。",
        "举世皆为息，魂离神不动。",
        "觉来无所知，贪求心愈用。",
        "堪笑尘中人，不知梦是梦。"
      ],
      "author": {
        "id": 2406,
        "name": "陈抟"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 46,
      "title": "赠金励睡诗  其二",
      "content": [
        "至人本无梦，其梦本游仙。",
        "真人本无睡，睡则浮云烟。",
        "炉里近为药，壶中别有天。",
        "欲知睡梦里，人间第一玄。"
      ],
      "author": {
        "id": 2406,
        "name": "陈抟"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 47,
      "title": "题石水涧",
      "content": [
        "银河洒落翠光冷，一派回环湛晚晖。",
        "几恨却为顽石碍，琉璃滑处玉花飞。"
      ],
      "author": {
        "id": 2406,
        "name": "陈抟"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 48,
      "title": "冬日晚望",
      "content": [
        "山鬼煖或呼，溪鱼寒不跳。",
        "晚景愈堪观，危峰露残照。"
      ],
      "author": {
        "id": 2406,
        "name": "陈抟"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 49,
      "title": "西峰",
      "content": [
        "为爱西峰好，吟头尽日昂。",
        "岩花红作阵，溪水绿成行。",
        "几夜碍新月，半山无夕阳。",
        "寄言嘉遁客，此处是仙乡。"
      ],
      "author": {
        "id": 2406,
        "name": "陈抟"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 50,
      "title": "华山",
      "content": [
        "半夜天香入岩谷，西风吹落岭头莲。",
        "空爱掌痕侵碧汉，无人曾叹巨灵仙。"
      ],
      "author": {
        "id": 2406,
        "name": "陈抟"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 51,
      "title": "与毛女游",
      "content": [
        "药苗不满笥，又更上危颠。",
        "回指归去路，相将入翠烟。"
      ],
      "author": {
        "id": 2406,
        "name": "陈抟"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 52,
      "title": "咏毛女",
      "content": [
        "曾折松枝为宝栉，又编栗叶作罗襦。",
        "有时问著秦宫事，笑撚仙花望太虚。"
      ],
      "author": {
        "id": 2406,
        "name": "陈抟"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 53,
      "title": "对御歌",
      "content": [
        "臣爱睡，臣爱睡。",
        "不卧毡，不盖被。",
        "片石枕头，蓑衣铺地。",
        "震雷掣电鬼神惊，臣当其时正酣睡。",
        "闲思张良，闷想范蠡。",
        "说甚孟德，休言刘备。",
        "三四君子只是争些闲气，争如臣向青山顶头。",
        "白云堆里，展开眉头。",
        "解放肚皮，但一觉睡。",
        "管什玉兔东升，红轮西坠。"
      ],
      "author": {
        "id": 2406,
        "name": "陈抟"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 54,
      "title": "辞上归进诗",
      "content": [
        "草泽吾皇诏，图南抟姓陈。",
        "三峰千载客，四海一闲人。",
        "世态从来薄，诗情自得真。",
        "乞全麞鹿性，何处不称臣。"
      ],
      "author": {
        "id": 2406,
        "name": "陈抟"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 55,
      "title": "石刻诗",
      "content": [
        "我谓浮荣真是幻，醉来舍辔谒高公。",
        "因聆玄论冥冥理，转觉尘寰一梦中。"
      ],
      "author": {
        "id": 2406,
        "name": "陈抟"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 56,
      "title": "赠张乖崖",
      "content": [
        "自吴入蜀是寻常，歌舞筵中救火忙。",
        "乞得金陵养闲散，也须多谢鬓边疮。"
      ],
      "author": {
        "id": 2406,
        "name": "陈抟"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 57,
      "title": "诗一首",
      "content": [
        "华阴高处是吾宫，出即凌空跨晓风。",
        "台殿不将金锁闭，来时自有白云封。"
      ],
      "author": {
        "id": 2406,
        "name": "陈抟"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 58,
      "title": "喜英公大师挂锡太华",
      "content": [
        "暗喜莲峰作近隣，拨开云雾见师频。",
        "有时问个艰难字，便沐周旋说与人。",
        "唐李监应留后迹，汉蔡邕想是前身。",
        "堪嗟继踵无徒弟，笔法收藏在渭滨。"
      ],
      "author": {
        "id": 2406,
        "name": "陈抟"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 59,
      "title": "句  其一",
      "content": [
        "蚕月桑叶青，鶑时柳花白。"
      ],
      "author": {
        "id": 2406,
        "name": "陈抟"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 60,
      "title": "句  其二",
      "content": [
        "万顷白云独自有，一枝仙桂阿谁无。"
      ],
      "author": {
        "id": 2406,
        "name": "陈抟"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 61,
      "title": "句",
      "content": [
        "帝王师不得，日月老应难。"
      ],
      "author": {
        "id": 4483,
        "name": "单氏"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 62,
      "title": "经方干旧居",
      "content": [
        "镜湖中有月，处士后无人。",
        "荻笋抽高节，鲈鱼跃老鳞。"
      ],
      "author": {
        "id": 9845,
        "name": "释干康"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 63,
      "title": "赋残雪",
      "content": [
        "六出奇花已住开，郡城相次见楼台。",
        "时人莫把和泥看，一片飞从天上来。"
      ],
      "author": {
        "id": 9845,
        "name": "释干康"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 64,
      "title": "诗一首",
      "content": [
        "隔岸红尘忙似火，当轩青嶂冷如冰。",
        "烹茶童子休相问，报道门前是衲僧。"
      ],
      "author": {
        "id": 9845,
        "name": "释干康"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 65,
      "title": "答僧问心要作偈",
      "content": [
        "昨日相逢叙起居，今朝相见事还如。",
        "如何却觅呈心要，心要如何特地疏。"
      ],
      "author": {
        "id": 8631,
        "name": "释法骞"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 66,
      "title": "答僧问佛法大意作偈",
      "content": [
        "刹刹现形仪，尘尘具觉知。",
        "性源常鼓浪，不悟未曾移。"
      ],
      "author": {
        "id": 6414,
        "name": "释广原"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 67,
      "title": "占贮橘子",
      "content": [
        "圆如珠，赤如丹，倘能擘破分吃了，争不惭愧洞庭山。"
      ],
      "author": {
        "id": 5204,
        "name": "叶简"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 68,
      "title": "占巾子",
      "content": [
        "近来好裹束，各自竞尖新。",
        "称无二三两，因何号一斤。"
      ],
      "author": {
        "id": 5204,
        "name": "叶简"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 69,
      "title": "占两鸡子",
      "content": [
        "此物不难知，一雄兼一雌。",
        "请将打破看，方明混沌时。"
      ],
      "author": {
        "id": 5204,
        "name": "叶简"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 70,
      "title": "句",
      "content": [
        "勿笑有三耳，全胜畜二心。"
      ],
      "author": {
        "id": 12195,
        "name": "聂崇义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 71,
      "title": "赠梦英大师",
      "content": [
        "纪赠歌诗数百人，序师多艺各求新。",
        "未言篆隶飞龙凤，且说风骚感鬼神。",
        "琴有古声清耳目，鹤无凡态惹埃尘。",
        "英公所学还如此，不错承恩近紫宸。"
      ],
      "author": {
        "id": 7352,
        "name": "杨昭俭"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 72,
      "title": "题家园",
      "content": [
        "池莲憔悴无颜色，园竹低垂减翠阴。",
        "园竹池莲莫惆怅，相看恰似主人心。"
      ],
      "author": {
        "id": 7352,
        "name": "杨昭俭"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 73,
      "title": "自述真赞",
      "content": [
        "真兮寥廓，郢人图雘。",
        "岳耸云空，澄潭月跃。"
      ],
      "author": {
        "id": 4768,
        "name": "释通慧"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 74,
      "title": "题玉堂壁",
      "content": [
        "官职有来须与做，才能用处不忧无。",
        "堪笑翰林陶学士，一生依样画葫芦。"
      ],
      "author": {
        "id": 8040,
        "name": "陶谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 75,
      "title": "石桥",
      "content": [
        "重重翠幛耸云端，玉殿金楼缥缈间。",
        "圣境不容凡俗到，故将飞瀑隔尘寰。"
      ],
      "author": {
        "id": 8040,
        "name": "陶谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 76,
      "title": "寄赠梦英大师",
      "content": [
        "是个碑文念得全，聪明灵性自天然。",
        "离吴别楚三千里，入洛游梁二十年。",
        "负艺已闻喧世界，高眠长见卧云烟。",
        "相逢与我情何厚，问佛方知宿有缘。"
      ],
      "author": {
        "id": 8040,
        "name": "陶谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 77,
      "title": "句  其一",
      "content": [
        "尖簷帽子卑凡厮，短靿靴儿末厥兵。"
      ],
      "author": {
        "id": 8040,
        "name": "陶谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 78,
      "title": "句  其二",
      "content": [
        "此生头已白，无路扫王门。"
      ],
      "author": {
        "id": 8040,
        "name": "陶谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 79,
      "title": "句  其三",
      "content": [
        "井蛙休恃重溟险，泽马曾嘶九曲滨。"
      ],
      "author": {
        "id": 8040,
        "name": "陶谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 80,
      "title": "句  其四",
      "content": [
        "乞与金钟病眼明。"
      ],
      "author": {
        "id": 8040,
        "name": "陶谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 81,
      "title": "句",
      "content": [
        "圣胎初出赤志翁，丑杖旁扶赤志翁。"
      ],
      "author": {
        "id": 9415,
        "name": "符昭远"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 82,
      "title": "山居诗  其一",
      "content": [
        "此事从来已绝疑，安然乐道合希夷。",
        "依山偶得还源旨，拂石闲题出格诗。",
        "水待冻开成细溜，薪从霜后拾枯枝。",
        "因兹永断攀缘意，誓与青松作老期。"
      ],
      "author": {
        "id": 10228,
        "name": "释延寿"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 83,
      "title": "山居诗  其二",
      "content": [
        "古树交盘簇径深，阒无人到为难寻。",
        "祇和算计千般事，谁解消停一点心。",
        "冰锁瀑声中夜断，云吞岳影半天沈。",
        "寒灯欲绝禅初起，透牖疏风触短襟。"
      ],
      "author": {
        "id": 10228,
        "name": "释延寿"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 84,
      "title": "山居诗  其三",
      "content": [
        "祇园闲适乐箪瓢，莫讶烟霞道路遥。",
        "龙穴定知潜碧海，鹏程终是望丹霄。",
        "拨云岩下来泉脉，嚼草坡边辨药苗。",
        "门锁薜萝无客至，庵前时有白云朝。"
      ],
      "author": {
        "id": 10228,
        "name": "释延寿"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 85,
      "title": "山居诗  其四",
      "content": [
        "贪生养命事皆同，独坐闲居意颇慵。",
        "入夏驱驰巢树鹊，经春劳役探花蜂。",
        "石炉香尽寒灰薄，铁磬声微古锈浓。",
        "寂寂虚怀无一念，任从苍藓没行踪。"
      ],
      "author": {
        "id": 10228,
        "name": "释延寿"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 86,
      "title": "山居诗  其五",
      "content": [
        "心地须教合死灰，藏机泯迹绝梯媒。",
        "芳兰祇为因香折，良木多从被直摧。",
        "寒逼花枝红未吐，日融水面绿全开。",
        "支颐独坐经窗下，一片云闲入户来。"
      ],
      "author": {
        "id": 10228,
        "name": "释延寿"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 87,
      "title": "山居诗  其六",
      "content": [
        "达来何处更追寻，放旷谁论古与今。",
        "风带泉声流谷口，云和山影落潭心。",
        "资身自有衣中宝，济世谁藏室内金。",
        "策杖偶来林下坐，鸟声相和唱圆音。"
      ],
      "author": {
        "id": 10228,
        "name": "释延寿"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 88,
      "title": "山居诗  其七",
      "content": [
        "事多兴废莫持论，唯有禅宗理可尊。",
        "似讷始平分别路，如愚方塞是非门。",
        "刳肠祇为生灵智，剖舌多因强语言。",
        "争似息机高卧客，年来年去道长存。"
      ],
      "author": {
        "id": 10228,
        "name": "释延寿"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 89,
      "title": "山居诗  其八",
      "content": [
        "碧峤经年常寂寂，更无闲事可相于。",
        "超伦每效高僧行，得力难忘古佛书。",
        "落叶乱渠凭水荡，浮云翳月倩风除。",
        "方知嬾与真空合，一衲闲披憩旧庐。"
      ],
      "author": {
        "id": 10228,
        "name": "释延寿"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 90,
      "title": "山居诗  其九",
      "content": [
        "幽斋独坐绝参详，兀尔何如骤世忙。",
        "拯济终凭宏愿力，安闲须得守愚方。",
        "柴门半掩花空落，苔径虚踪草自荒。",
        "最好静中无一事，翛然唯得道芽长。"
      ],
      "author": {
        "id": 10228,
        "name": "释延寿"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 91,
      "title": "山居诗  其一○",
      "content": [
        "旷然不被兴亡坠，豁尔难教宠辱惊。",
        "鼓角城遥无伺候，轮蹄路绝免逢迎。",
        "暖眠纸帐茅堂密，稳坐蒲团石面平。",
        "祇有此途为上策，更无余事可关情。"
      ],
      "author": {
        "id": 10228,
        "name": "释延寿"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 92,
      "title": "山居诗  其一一",
      "content": [
        "触目堪嗟失路人，坦然王道却迷津。",
        "井籐梗上存余命，石火光中保幻身。",
        "任老岂知头顶白，忘缘谁觉世闲春。",
        "容颜枯槁元非病，亭沼消疏不是贫。"
      ],
      "author": {
        "id": 10228,
        "name": "释延寿"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 93,
      "title": "山居诗  其一二",
      "content": [
        "言行相应宜此地，空谈大隠也无端。",
        "升沈岐路非他得，生熟根机且自看。",
        "瞋火微烟还渐息，贪泉余润亦消干。",
        "平生正直须甘取，虚幻门中莫自瞒。"
      ],
      "author": {
        "id": 10228,
        "name": "释延寿"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 94,
      "title": "山居诗  其一三",
      "content": [
        "怡和心境了然同，大道无私处处通。",
        "举世岂怀身后虑，谁人暂省事前空。",
        "门开岩石千山月，帘卷溪楼一槛风。",
        "羸体健来知药力，缘心寂后觉神功。"
      ],
      "author": {
        "id": 10228,
        "name": "释延寿"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 95,
      "title": "山居诗  其一四",
      "content": [
        "进退应须与智论，浮萍自在为无根。",
        "埽门何太抛途辙，解珮犹能弃渥恩。",
        "草径旋封迷旧迹，苔阶乱织露新痕。",
        "不唯此景供游赏，无限烟萝尽一吞。"
      ],
      "author": {
        "id": 10228,
        "name": "释延寿"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 96,
      "title": "山居诗  其一五",
      "content": [
        "尘网休重织是非，冥心何不合玄微。",
        "庄周梦里多迷旨，惠子渔中少见机。",
        "拶路古松和冻折，盘空枯叶带霜飞。",
        "一言可达知音者，还得从吾此路归。"
      ],
      "author": {
        "id": 10228,
        "name": "释延寿"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 97,
      "title": "山居诗  其一六",
      "content": [
        "抱朴澄神蕴道光，石炉闲𦶟六时香。",
        "曳空横野云和静，逗石穿崖水自忙。",
        "晚圃雨来葵叶嫩，晴坡烧后蕨苗长。",
        "一心包尽乾坤内，莫把闲文更度量。"
      ],
      "author": {
        "id": 10228,
        "name": "释延寿"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 98,
      "title": "山居诗  其一七",
      "content": [
        "松萝闲锁一身孤，履道安禅是密谟。",
        "借问野云谁断续，思量春草自荣枯。",
        "多见异兽心堪伏，来惯幽禽不用呼。",
        "万物尽从成熟得，莫教容易丧工夫。"
      ],
      "author": {
        "id": 10228,
        "name": "释延寿"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 99,
      "title": "山居诗  其一八",
      "content": [
        "平生初志已酬之，怀抱怡然寂有归。",
        "古帙懒开缘得意，幽房长闭为忘机。",
        "数行鸟阵连云没，一带泉声隔岭微。",
        "道合古今浑总是，何须更虑昔年非。"
      ],
      "author": {
        "id": 10228,
        "name": "释延寿"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 100,
      "title": "山居诗  其一九",
      "content": [
        "青山一坐万缘休，努力应须与古俦。",
        "散诞襟怀因绝趣，消疏活计为无求。",
        "花明小砌和春月，松暗前轩带雨秋。",
        "景像自开还自合，怡然何必更忘忧。"
      ],
      "author": {
        "id": 10228,
        "name": "释延寿"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    }
  ],
